---
import { Image } from "astro:assets";
import instagramIcon from "../pages/assets/Instagram.svg";
import youtubeIcon from "../pages/assets/youtube.svg";
import xIcon from "../pages/assets/X.svg";
import anchorIcon from "../pages/assets/scroll.svg";
import titleBg from "../pages/assets/TitleBackground.webp";
import logoImg from "../pages/assets/logo.svg";
import typoImg from "../pages/assets/typo.svg";
import titleBackgroundBlack from "../pages/assets/TitleBackgroundBlack.jpg";
import { getCollection, type CollectionEntry } from "astro:content";
import exhibitions from "../pages/data/exhibitions.json";

const rawArticles = await getCollection("articles");

// 記事データの取得
const articlesData = rawArticles.map((article: CollectionEntry<"articles">) => {
  const data = article.data as any;
  const { title, heroImage, exhibitionSlug, exhibitionId, date, pubDate, description, excerpt } = data;

  // 1. JSONから対象の展示データを検索
  const matchedExhibition = exhibitions.find(
    (ex: any) => ex.slug === exhibitionSlug || ex.id === exhibitionId
  );

  // 2. 記事専用サムネ(heroImage) -> 展示データ画像(image) -> 空文字（クライアント側でSVGフォールバック）の優先順位で採用
  const finalImage = heroImage || matchedExhibition?.image || "";

  // 3. 本文からMarkdown記号を取り除き、冒頭のテキストを抽出（descriptionがない場合の対策）
  const plainTextBody = (article.body || "")
    .replace(/[#*`_~>\[\]\(\)]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  const fallbackDescription =
    plainTextBody.slice(0, 80) + (plainTextBody.length > 80 ? "..." : "");

  return {
    title: title || "",
    slug: article.id || article.id,
    image: finalImage,
    date: date || pubDate || "",
    description: description || excerpt || fallbackDescription,
  };
});

const pageTitle = "記事一覧 | 第69回 駒場東邦文化祭 | SAIL BEYOND";
const pageDescription =
  "2026 駒場東邦中学高等学校 第69回文化祭「SAIL BEYOND」のオンライン記事一覧ページです。";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>

    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="駒場東邦,駒場東邦文化祭,文化祭,Komafes,Komafes69,SAIL BEYOND,駒東,記事"
    />

    <link rel="canonical" href="https://69.komafes.jp/" />

    <!-- ② OGP設定（SNSシェア・検索結果用） -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://69.komafes.jp/" />
    <meta property="og:image" content="https://69.komafes.jp/ogp.png" />
    <meta property="og:image:width" content="3406" />
    <meta property="og:image:height" content="1884" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- ④ Google Fonts の最適化（統合＆非同期読み込み） -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Noto+Sans+JP:wght@500;700;900&family=Pinyon+Script&family=Shippori+Mincho:wght@600;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Noto+Sans+JP:wght@500;700;900&family=Pinyon+Script&family=Shippori+Mincho:wght@600;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />

    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/icon.ico" />

    <!-- iOS / WebManifest 用 -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Sail Beyond" />
  </head>
  <body>
    <!-- ========================================
         スマホ用 メニュー (中身)
         ======================================== -->
    <!-- ※ボタンは移動しますが、nav本体はここに残します -->
    <nav id="mobile-menu" class="mobile-nav">
      <ul>
        <li><a href="/">TOP</a></li>
        <li><a href="/theme">THEME</a></li>
        <li><a href="/exhibition">EXHIBITION</a></li>
        <li><a href="/articles">ARTICLES</a></li>
        <li><a href="/timetable">TIME TABLE</a></li>
        <li><a href="/map">MAP</a></li>
        <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
      </ul>
      <div class="mobile-sns-links">
        <a
          href="https://www.instagram.com/komafes69/"
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={instagramIcon.src} alt="" class="sns-icon" />
          <span>Instagram</span>
        </a>
        <a
          href="https://www.youtube.com/@komafes69"
          aria-label="YouTube"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={youtubeIcon.src} alt="" class="sns-icon" />
          <span>YouTube</span>
        </a>
        <a
          href="https://x.com/Komafes69"
          aria-label="X"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={xIcon.src} alt="" class="sns-icon" />
          <span>X</span>
        </a>
      </div>
    </nav>

    <!-- ========================================
         PC・タブレット・スマホ兼用 ヘッダー
         ======================================== -->
    <header class="sticky-header">
      <div class="sticky-header-inner">
        <!-- 左側: ロゴとタイポ -->
        <a href="/" class="header-brand">
          <img src={logoImg.src} alt="Komafes69 Logo" class="header-logo" />
          <img src={typoImg.src} alt="SAIL BEYOND" class="header-typo" />
        </a>

        <!-- 右側: PCナビゲーション ＆ スマホハンバーガー -->
        <div class="header-right">
          <nav class="header-nav">
            <ul>
              <li><a href="/">TOP</a></li>
              <li><a href="/theme">THEME</a></li>
              <li><a href="/exhibition">EXHIBITION</a></li>
              <li><a href="/articles">ARTICLES</a></li>
              <li><a href="/timetable">TIME TABLE</a></li>
              <li><a href="/map">MAP</a></li>
              <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
            </ul>
          </nav>

          <!-- ハンバーガーボタンをヘッダー内に移動 -->
          <button
            class="hamburger"
            aria-label="メニューを開く"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </button>
        </div>
      </div>
    </header>

    <main class="exhibition-container">
      <header
        class="page-header"
        style={`background-image: url('${titleBg.src}');`}
      >
        <div class="page-header-inner">
          <h1 class="page-title">ARTICLES</h1>
          <p class="page-subtitle">団体記事一覧</p>
        </div>
      </header>

      <section class="filter-section">
        <div class="search-controls">
          <div class="search-box">
            <svg
              class="search-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="search-input"
              placeholder="記事タイトルから検索"
            />
            <button
              id="clear-btn"
              class="clear-btn"
              aria-label="クリア"
              style="display: none;">×</button
            >
          </div>
        </div>

        <div class="result-count">
          <span id="count-num">0</span> 件を表示中
        </div>
      </section>

      <!-- IDを article-grid に統一 -->
      <section
        class="exhibition-grid"
        id="article-grid"
        data-articles={JSON.stringify(articlesData)}
      >
      </section>

      <!-- 正しく articlesData をクライアントに渡す -->
      <script is:inline define:vars={{ articlesData }}>
        window.articlesData = articlesData;
      </script>

      <div id="no-results" class="no-results" style="display: none;">
        <p>条件に一致する記事が見つかりませんでした。</p>
      </div>
    </main>

    <!-- スクロール連動：錨（アンカー）上に戻るボタン -->
    <div id="anchor-scroll-top" class="anchor-scroll-top">
      <div class="anchor-line"></div>
      <div class="anchor-body">
        <span class="anchor-text">PULL TO TOP</span>
        <img src={anchorIcon.src} alt="PAGE TOP" class="anchor-img" />
      </div>
    </div>

    <footer
      class="footer"
      style={`background-image: url('${titleBackgroundBlack.src}'); background-size: cover; background-position: center;`}
    >
      <div class="footer-inner">
        <!-- 左側：学校情報・アクセス -->
        <div class="footer-info">
          <p class="school-name">駒場東邦中学校・高等学校 第69回 文化祭</p>
          <!-- SVGロゴを使用 -->
          <a href="/" class="footer-brand">
            <img src={logoImg.src} alt="Komafes69 Logo" class="footer-logo" />
            <img src={typoImg.src} alt="SAIL BEYOND" class="footer-typo" />
          </a>

          <div class="school-details">
            <p><strong>開催日時：</strong>9月19日(土)・20日(日) 9:00〜16:30</p>
            <p><strong>所在地：</strong>〒154-0001 東京都世田谷区池尻4-5-1</p>
            <p class="access-info">
              東急田園都市線「池尻大橋」駅より徒歩10分<br />
              京王井の頭線「駒場東大前」駅より徒歩10分
            </p>
          </div>
        </div>

        <!-- 右側：ミニサイトマップとSNS -->
        <div class="footer-nav">
          <ul class="sitemap">
            <li><a href="/">TOP</a></li>
            <li><a href="/theme">THEME</a></li>
            <li><a href="/exhibition">EXHIBITION</a></li>
            <li><a href="/articles">ARTICLES</a></li>
            <li><a href="/timetable">TIME TABLE</a></li>
            <li><a href="/map">MAP</a></li>
            <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
          </ul>

          <div class="footer-sns">
            <a
              href="https://www.instagram.com/komafes69/"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={instagramIcon.src}
                alt="Instagram"
                class="footer-sns-icon"
              />
            </a>
            <a
              href="https://www.youtube.com/@komafes69"
              aria-label="YouTube"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={youtubeIcon.src}
                alt="YouTube"
                class="footer-sns-icon"
              />
            </a>
            <a
              href="https://x.com/Komafes69"
              aria-label="X"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src={xIcon.src} alt="X" class="footer-sns-icon" />
            </a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; 2026 Komafes69 All Rights Reserved.</p>
      </div>
    </footer>

    <!-- クライアントJS用にデータを埋め込み -->
    <script is:inline define:vars={{ articlesData }}>
      window.articlesData = articlesData;
    </script>

    <script>
      import { gsap } from "gsap";

      declare global {
        interface Window {
          articlesData: any[];
        }
      }

      document.addEventListener("DOMContentLoaded", () => {
        // --- 1. ヘッダー＆ハンバーガーメニュー処理 ---
        const header = document.querySelector(".sticky-header");
        const hamburger = document.querySelector(".hamburger");
        const mobileNav = document.querySelector(".mobile-nav");
        const body = document.body;

        window.addEventListener("scroll", () => {
          if (window.scrollY > 50) {
            header?.classList.add("is-show");
            hamburger?.classList.add("is-black");
          } else {
            header?.classList.remove("is-show");
            hamburger?.classList.remove("is-black");
          }
        });

        hamburger?.addEventListener("click", () => {
          hamburger.classList.toggle("is-active");
          mobileNav?.classList.toggle("is-active");
          body.classList.toggle("no-scroll");
        });

        // --- 2. GSAP アニメーション実行 ---
        gsap.fromTo(
          ".page-title",
          { clipPath: "inset(0 100% 0 0)", opacity: 1 },
          {
            clipPath: "inset(0 0% 0 0)",
            duration: 2.5,
            ease: "power2.out",
            delay: 0.3,
          },
        );

        gsap.fromTo(
          ".page-subtitle",
          { clipPath: "inset(0 100% 0 0)", opacity: 1 },
          {
            clipPath: "inset(0 0% 0 0)",
            duration: 2.5,
            ease: "power2.out",
            delay: 0.45,
          },
        );

        // --- 3. 記事カード描画＆検索フィルター処理 ---
        const grid = document.getElementById("article-grid");
        const countNum = document.getElementById("count-num");
        const noResults = document.getElementById("no-results");
        const searchInput = document.getElementById(
          "search-input",
        ) as HTMLInputElement | null;
        const clearBtn = document.getElementById("clear-btn");

        let currentKeyword = "";
        const fallbackSvg = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="%23a0aec0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>`;

        // HTMLの data 属性からデータ配列を取り出してパース
        const articlesData: any[] = JSON.parse(
          grid?.getAttribute("data-articles") || "[]",
        );

        // カード描画関数
        const renderCards = (data: any[]) => {
          if (!grid) return;
          grid.innerHTML = "";
          if (countNum) countNum.textContent = data.length.toString();

          if (data.length === 0) {
            if (noResults) noResults.style.display = "block";
            return;
          } else {
            if (noResults) noResults.style.display = "none";
          }

          data.forEach((item: any, index: number) => {
            const card = document.createElement("a");
            card.href = `/articles/${item.slug}`;
            card.className = "exhibition-card";
            card.style.animationDelay = `${Math.min(index * 0.04, 0.5)}s`;

            const hasValidImage = Boolean(item.image);

            // 投稿日時の整形
            const rawDate = item.date;
            const formattedDate = rawDate
              ? new Date(rawDate)
                  .toLocaleDateString("ja-JP", {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                  })
                  .replace(/\//g, ".")
              : "";

            card.innerHTML = `
          <div class="card-image-wrapper">
            <img 
              src='${hasValidImage ? item.image : fallbackSvg}' 
              alt='${item.title}' 
              class='card-img'
            />
          </div>
          <div class="card-body">
            <h2 class="card-title">${item.title}</h2>
            ${item.description ? `<p class="card-description">${item.description}</p>` : ""}
            ${formattedDate ? `<div class="card-date-wrapper"><time class="card-date">${formattedDate}</time></div>` : ""}
          </div>
        `;
            grid.appendChild(card);
          });
        };

        // 検索フィルタリング処理
        const filterData = () => {
          const keyword = currentKeyword.toLowerCase().trim();
          const filtered = articlesData.filter((item: any) => {
            return (
              !keyword ||
              (item.title && item.title.toLowerCase().includes(keyword)) ||
              (item.description &&
                item.description.toLowerCase().includes(keyword))
            );
          });
          renderCards(filtered);
        };

        searchInput?.addEventListener("input", (e) => {
          currentKeyword = (e.target as HTMLInputElement).value;
          if (clearBtn)
            clearBtn.style.display = currentKeyword ? "block" : "none";
          filterData();
        });

        clearBtn?.addEventListener("click", () => {
          if (searchInput) searchInput.value = "";
          currentKeyword = "";
          if (clearBtn) clearBtn.style.display = "none";
          filterData();
        });

        // 初回描画の実行
        renderCards(articlesData);

        // --- 4. 錨（アンカー）のスクロール連動＆「上に戻る」処理 ---
        const anchorBtn = document.getElementById("anchor-scroll-top");
        const anchorLine = document.querySelector(
          ".anchor-line",
        ) as HTMLElement;

        if (anchorBtn && anchorLine) {
          window.addEventListener("scroll", () => {
            const scrollY = window.scrollY;
            const docHeight =
              document.documentElement.scrollHeight - window.innerHeight;

            if (scrollY > 150) {
              anchorBtn.classList.add("is-visible");
            } else {
              anchorBtn.classList.remove("is-visible");
            }

            const scrollRatio =
              docHeight > 0 ? Math.min(scrollY / docHeight, 1) : 0;
            const maxLineHeight = window.innerHeight * 0.7;
            const currentLineHeight = scrollRatio * maxLineHeight;
            anchorLine.style.height = `${currentLineHeight}px`;
          });

          anchorBtn.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
          });
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* ========================================
     全体基本スタイル
     ======================================== */
  body {
    font-family:
      "Noto Sans JP",
      system-ui,
      -apple-system,
      sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f6f8;
    color: #1a202c;
  }

  body.no-scroll {
    overflow: hidden;
  }

  /* (ヘッダーやHero等の既存スタイル) */
  .sticky-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000; /* メニューより手前に表示するため 900 -> 1000 に変更 */
    background: transparent;
    border-bottom: 1px solid transparent;
    box-shadow: none;
    padding: 0.8rem 0;
    opacity: 1;
    pointer-events: auto;
    transition:
      opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1),
      background-color 0.3s ease;
  }

  .sticky-header.is-show {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: rgba(0, 0, 0, 0.05);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }

  .sticky-header,
  .sticky-header-inner {
    box-sizing: border-box; /* paddingを含めた幅をきっちり100%に収める */
  }

  .sticky-header-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 1.5rem;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .header-brand:hover {
    opacity: 0.7;
  }

  .header-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .header-typo {
    height: 20px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .header-nav ul {
    display: flex;
    gap: clamp(1rem, 2vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header-nav a {
    color: #ffffff;
    text-decoration: none;
    font-family: "Bebas Neue", cursive;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    letter-spacing: 0.12em;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .header-nav a:hover {
    opacity: 0.6;
    transform: translateY(-1px);
  }

  .sticky-header.is-show .header-logo,
  .sticky-header.is-show .header-typo {
    filter: brightness(0);
  }

  .sticky-header.is-show .header-nav a {
    color: #111111;
  }
  .header-right {
    display: flex;
    align-items: center;
  }
  .hamburger,
  .mobile-nav {
    display: none;
  }
  .hamburger,
  .mobile-nav {
    display: none;
  }

  /* PC用のナビゲーションリンクは表示 */
  .header-nav {
    display: block;
  }

  @media screen and (max-width: 768px) {
    /* ========================================
       モバイルナビゲーション画面 (スマホ用メニュー本体)
       ======================================== */
    .mobile-nav {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      background-color: rgba(0, 0, 0, 0.92);
      z-index: 999; /* ヘッダー(1000)の下に潜り込ませる */
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .mobile-nav.is-active {
      opacity: 1;
      pointer-events: auto;
    }

    .mobile-nav ul {
      list-style: none;
      padding: 0;
      margin: 0;
      text-align: center;
    }

    .mobile-nav li {
      margin: 1.5rem 0;
    }

    .mobile-nav a {
      color: #f6f9f6;
      text-decoration: none;
      font-size: 1.8rem;
      font-family: "Bebas Neue", cursive;
      letter-spacing: 0.15em;
    }

    .mobile-sns-links {
      display: flex;
      gap: 2rem;
      margin-top: 3rem;
      transform: translateX(-20px);
    }

    .mobile-sns-links a {
      display: flex;
      flex-direction: column;
