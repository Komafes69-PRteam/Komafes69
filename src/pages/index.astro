---
import { Image } from "astro:assets";
import heroImage from "../pages/assets/hero.webp";
import heroImageSp from "../pages/assets/hero-sp.webp";
import heroImageTb from "../pages/assets/hero-tb.webp";

import titleTextImg from "../pages/assets/title-text.png";
import komafesLabel from "../pages/assets/komafesLabel.png";
import topLogoImg from "../pages/assets/topLogo.png";
import mainLogoImg from "../pages/assets/Komafes69Logo.png";
import hatImg from "../pages/assets/hat.png";
import maintypoImg from "../pages/assets/typo.png";

import instagramIcon from "../pages/assets/Instagram.svg";
import youtubeIcon from "../pages/assets/youtube.svg";
import xIcon from "../pages/assets/X.svg";

import scrollIcon from "../pages/assets/scroll.svg";

import logoImg from "../pages/assets/logo.svg";
import typoImg from "../pages/assets/typo.svg";
import titleBackgroundDark from "../pages/assets/TitleBackgroundDark.webp";
import titleBackgroundBlack from "../pages/assets/TitleBackgroundBlack.jpg";

const pageTitle = "トップページ | Komafes69";
const pageDescription =
  "駒場東邦 第69代 文化祭「SAIL BEYOND」の公式サイトです。開催日時：9月19日(土)・20日(日) 9:00〜17:00。テーマや各展示、タイムテーブル、マップなどの最新情報を掲載しています。";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>

    <meta name="description" content={pageDescription} />

    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@500;700;900&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@500;700;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
  </head>
  <body id="top">
    <!-- ========================================
         スマホ用ハンバーガーボタン & メニュー
         ======================================== -->
    <button
      class="hamburger"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <nav id="mobile-menu" class="mobile-nav">
      <ul>
        <li><a href="/">TOP</a></li>
        <li><a href="/theme">THEME</a></li>
        <li><a href="/exhibition">EXHIBITION</a></li>
        <li><a href="/articles">ARTICLES</a></li>
        <li><a href="/timetable">TIME TABLE</a></li>
        <li><a href="/map">MAP</a></li>
        <li><a href="/archives">ARCHIVES</a></li>
      </ul>
      <div class="mobile-sns-links">
        <a
          href="https://www.instagram.com/komafes69/"
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Image
            src={instagramIcon}
            alt=""
            format="svg"
            quality={100}
            class="sns-icon"
          />
          <span>Instagram</span>
        </a>
        <a
          href="https://www.youtube.com/@komafes68"
          aria-label="YouTube"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Image
            src={youtubeIcon}
            alt=""
            format="svg"
            quality={100}
            class="sns-icon"
          />
          <span>YouTube</span>
        </a>
        <a
          href="https://x.com/Komafes68"
          aria-label="X"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Image
            src={xIcon}
            alt=""
            format="svg"
            quality={100}
            class="sns-icon"
          />
          <span>X</span>
        </a>
      </div>
    </nav>

    <!-- ========================================
         PC・タブレット用 追従固定ヘッダー
         ======================================== -->
    <header class="sticky-header">
      <div class="sticky-header-inner">
        <!-- 左側: ロゴとタイポ -->
        <a href="/" class="header-brand">
          <Image
            src={logoImg}
            alt="Komafes69 Logo"
            format="svg"
            quality={85}
            class="header-logo"
          />
          <Image
            src={typoImg}
            alt="SAIL BEYOND"
            format="svg"
            quality={85}
            class="header-typo"
          />
        </a>

        <!-- 右側: ナビゲーションメニュー -->
        <nav class="header-nav">
          <ul>
            <li><a href="/">TOP</a></li>
            <li><a href="/theme">THEME</a></li>
            <li><a href="/exhibition">EXHIBITION</a></li>
            <li><a href="/articles">ARTICLES</a></li>
            <li><a href="/timetable">TIME TABLE</a></li>
            <li><a href="/map">MAP</a></li>
            <li><a href="/archives">ARCHIVES</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- ========================================
         Hero セクション
         ======================================== -->
    <section class="hero">
      <Image
        src={heroImage}
        alt="トップページの背景画像です"
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
        quality={90}
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="hero-bg pc-bg"
      />

      <Image
        src={heroImageSp}
        alt="スマホ用トップページの背景画像"
        widths={[320, 640, 768]}
        sizes="100vw"
        quality={90}
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="hero-bg sp-bg"
      />

      <Image
        src={heroImageTb}
        alt="タブレット用トップページの背景画像"
        widths={[768, 1024, 1280]}
        sizes="100vw"
        quality={90}
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="hero-bg tb-bg"
      />

      <div class="top-logo">
        <Image
          src={topLogoImg}
          alt="Komafes69"
          format="webp"
          quality={80}
          class="top-logo-img"
        />
      </div>

      <div class="main-logo-container">
        <Image
          src={mainLogoImg}
          alt="Komafes 69 SAIL BEYOND"
          format="webp"
          quality={85}
          class="main-logo-img"
        />
        <div class="hat-container">
          <Image
            src={hatImg}
            alt="Komafes 帽子"
            format="webp"
            quality={85}
            class="hat-img"
          />
        </div>
      </div>

      <div class="typo-container">
        <Image
          src={maintypoImg}
          alt="SAIL BEYOND"
          format="webp"
          quality={85}
          class="typo-img"
        />
      </div>

      <div class="hero-title-container">
        <Image
          src={titleTextImg}
          alt="駒場東邦 第69代 文化祭"
          format="webp"
          quality={80}
          class="hero-title-img"
        />
      </div>

      <div class="komafesLabel">
        <Image
          src={komafesLabel}
          alt="Komafes69ラベル"
          format="webp"
          quality={80}
          class="komafes-label-img"
        />
      </div>

      <div class="date-info">
        <div class="date-row">
          <span class="num">9.19</span><span class="day">(SAT.)</span>
        </div>
        <div class="date-row separator">
          <span class="dash">—</span>
          <span class="num">9.20</span><span class="day">(SUN.)</span>
        </div>
        <div class="time-row">
          <span class="time">[ 9:00 - 17:00 ]</span>
        </div>
      </div>

      <div class="scroll-animation">
        <span class="scroll-text">SCROLL</span>
        <div class="scroll-line"></div>
        <Image
          src={scrollIcon}
          alt="Scroll Animation"
          format="svg"
          quality={100}
          class="scroll-icon"
        />
      </div>

      <nav class="right-nav">
        <ul>
          <li><a href="/">TOP</a></li>
          <li><a href="/theme">THEME</a></li>
          <li><a href="/exhibition">EXHIBITION</a></li>
          <li><a href="/articles">ARTICLES</a></li>
          <li><a href="/timetable">TIME TABLE</a></li>
          <li><a href="/map">MAP</a></li>
          <li><a href="/archives">ARCHIVES</a></li>
        </ul>

        <div class="sns-links">
          <a
            href="https://www.instagram.com/komafes69/"
            aria-label="Instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Image
              src={instagramIcon}
              alt=""
              format="svg"
              quality={100}
              class="sns-icon"
            />
            <span>Instagram</span>
          </a>
          <a
            href="https://www.youtube.com/@komafes68"
            aria-label="YouTube"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Image
              src={youtubeIcon}
              alt=""
              format="svg"
              quality={100}
              class="sns-icon"
            />
            <span>YouTube</span>
          </a>
          <a
            href="https://x.com/Komafes68"
            aria-label="X"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Image
              src={xIcon}
              alt=""
              format="svg"
              quality={100}
              class="sns-icon"
            />
            <span>X</span>
          </a>
        </div>
      </nav>
    </section>

    <div class="marquee-container" style={`background-image: url('${titleBackgroundBlack.src}'); background-size: cover; background-position: center;`}>
      <div class="marquee-track">
        <!-- CSSアニメーションでループさせるため、同じ内容を2つ並べます -->
        <span class="marquee-text"
          >KOMAFES69 KOMAFES69 KOMAFES69 KOMAFES69 KOMAFES69</span
        >
        <span class="marquee-text"
          >KOMAFES69 KOMAFES69 KOMAFES69 KOMAFES69 KOMAFES69</span
        >
      </div>
    </div>

    <!-- ========================================
         EXHIBITION セクション
         ======================================== -->
    <section class="exhibition-section" >
      <div class="exhibition-header">
        <div class="exhibition-title-group">
          <!-- ラベル風のタイトル -->
          <div class="exhibition-label-wrapper">
            <h2 class="exhibition-title">EXHIBITIONS</h2>
          </div>
          <p class="exhibition-subtitle">お気に入りの団体を探そう！</p>
        </div>
      </div>

      <!-- 画像帯（カルーセル） -->
      <div
        class="exhibition-carousel-wrapper"
        style={`background-image: url('${titleBackgroundDark.src}'); background-size: cover; background-position: center;`}
      >
        <div class="exhibition-track" id="exhibitionTrack">
          <!-- JavaScriptで平行四辺形カードが追加されます -->
        </div>

        <a href="/exhibition" class="btn-exhibition-floating">
          <span class="btn-text">団体を詳しく見る</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </section>

    <footer class="footer" style={`background-image: url('${titleBackgroundBlack.src}'); background-size: cover; background-position: center;`}>
      <div class="footer-inner">
        <!-- 左側：学校情報・アクセス -->
        <div class="footer-info">
          <!-- SVGロゴを使用 -->
          <a href="/" class="footer-brand">
            <Image src={logoImg} alt="Komafes69 Logo" format="svg" quality={85} class="footer-logo" />
            <Image src={typoImg} alt="SAIL BEYOND" format="svg" quality={85} class="footer-typo" />
          </a>
          <p class="school-name">駒場東邦中学校・高等学校 第69代 文化祭</p>
          
          <div class="school-details">
            <p><strong>開催日時：</strong>9月19日(土)・20日(日) 9:00〜17:00</p>
            <p><strong>所在地：</strong>〒154-0001 東京都世田谷区池尻4-5-1</p>
            <p class="access-info">
              東急田園都市線「池尻大橋」駅より徒歩10分<br>
              京王井の頭線「駒場東大前」駅より徒歩10分
            </p>
          </div>
        </div>

        <!-- 右側：ミニサイトマップとSNS -->
        <div class="footer-nav">
          <ul class="sitemap">
            <li><a href="/">TOP</a></li>
            <li><a href="/theme">THEME</a></li>
            <li><a href="/exhibition">EXHIBITION</a></li>
            <li><a href="/articles">ARTICLES</a></li>
            <li><a href="/timetable">TIME TABLE</a></li>
            <li><a href="/map">MAP</a></li>
            <li><a href="/archives">ARCHIVES</a></li>
          </ul>

          <div class="footer-sns">
            <a href="https://www.instagram.com/komafes69/" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <Image src={instagramIcon} alt="Instagram" format="svg" class="footer-sns-icon" />
            </a>
            <a href="https://www.youtube.com/@komafes68" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
              <Image src={youtubeIcon} alt="YouTube" format="svg" class="footer-sns-icon" />
            </a>
            <a href="https://x.com/Komafes68" aria-label="X" target="_blank" rel="noopener noreferrer">
              <Image src={xIcon} alt="X" format="svg" class="footer-sns-icon" />
            </a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; 2026 Komafes69 All Rights Reserved.</p>
      </div>
    </footer>

    <!-- ========================================
         JavaScript 統合処理
         ======================================== -->
    <script>
      import { gsap } from "gsap";

      const initApp = () => {
        // --- 1. GSAP アニメーション (Hero) ---
        gsap.fromTo(
          ".top-logo-img",
          { clipPath: "inset(0 0 100% 0)", opacity: 1 },
          {
            clipPath: "inset(0 0 0% 0)",
            duration: 0.8,
            ease: "power2.out",
            delay: 0.1,
          },
        );
        gsap.fromTo(
          ".main-logo-img",
          { scale: 0.85, rotation: -140, opacity: 0 },
          {
            scale: 1,
            rotation: 0,
            opacity: 1,
            duration: 1.2,
            ease: "back.out(1.2)",
            delay: 0.4,
          },
        );
        gsap.fromTo(
          ".hat-img",
          {
            xPercent: 120,
            yPercent: -90,
            rotation: 35,
            scale: 1.15,
            opacity: 0,
          },
          {
            xPercent: 0,
            yPercent: 0,
            rotation: 0,
            scale: 1,
            opacity: 1,
            duration: 1.1,
            ease: "power3.out",
            delay: 0.9,
            onComplete: startPeriodicAndInteractiveEffects,
          },
        );
        gsap.fromTo(
          ".typo-img",
          { y: 20, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.9, ease: "power2.out", delay: 0.8 },
        );
        gsap.fromTo(
          ".hero-title-img",
          { clipPath: "inset(0 100% 0 0)", opacity: 1 },
          {
            clipPath: "inset(0 0% 0 0)",
            duration: 0.8,
            ease: "power2.out",
            delay: 0.3,
          },
        );
        gsap.fromTo(
          ".komafes-label-img",
          { clipPath: "inset(0 100% 0 0)", opacity: 1 },
          {
            clipPath: "inset(0 0% 0 0)",
            duration: 0.8,
            ease: "power2.out",
            delay: 0.45,
          },
        );
        gsap.fromTo(
          ".date-info",
          { clipPath: "inset(0 100% 0 0)", opacity: 1 },
          {
            clipPath: "inset(0 0% 0 0)",
            duration: 0.8,
            ease: "power2.out",
            delay: 0.6,
          },
        );
        gsap.fromTo(
          ".right-nav",
          { x: 20, opacity: 0 },
          { x: 0, opacity: 1, duration: 0.8, ease: "power2.out", delay: 0.5 },
        );
        gsap.fromTo(
          ".scroll-animation",
          { opacity: 0, y: 0 },
          { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 1.0 },
        );

        gsap.to(".scroll-line", {
          height: "40%",
          duration: 2,
          ease: "power1.inOut",
          repeat: -1,
          yoyo: true,
        });

        function startPeriodicAndInteractiveEffects() {
          function playHatFlip() {
            return gsap
              .timeline()
              .to(".hat-img", {
                yPercent: -70,
                xPercent: 70,
                rotation: "+=30",
                scale: 1.3,
                duration: 0.55,
                ease: "power2.out",
              })
              .to(".hat-img", {
                yPercent: 0,
                xPercent: 0,
                rotation: "+=330",
                scale: 1,
                duration: 0.95,
                ease: "power2.inOut",
              });
          }

          const loopTimeline = gsap.timeline({ repeat: -1, repeatDelay: 3.0 });
          loopTimeline
            .to(
              ".main-logo-img",
              { rotation: "+=360", duration: 1.5, ease: "power2.inOut" },
              0,
            )
            .add(playHatFlip(), 0);

          const logoContainer = document.querySelector(".main-logo-container");
          if (logoContainer) {
            logoContainer.addEventListener("mouseenter", () => {
              gsap.to(".main-logo-container", {
                scale: 1.05,
                duration: 0.3,
                ease: "power2.out",
              });
            });
            logoContainer.addEventListener("mouseleave", () => {
              gsap.to(".main-logo-container", {
                scale: 1,
                duration: 0.3,
                ease: "power2.inOut",
              });
            });
          }
        }

        // --- 2. スマホ用ハンバーガーメニュー制御 ---
        const hamburger = document.querySelector(".hamburger");
        const mobileNav = document.querySelector(".mobile-nav");
        const mobileLinks = document.querySelectorAll(".mobile-nav a");

        if (hamburger && mobileNav) {
          hamburger.addEventListener("click", () => {
            const isActive = hamburger.classList.contains("is-active");
            if (isActive) {
              hamburger.classList.remove("is-active");
              mobileNav.classList.remove("is-active");
              hamburger.setAttribute("aria-expanded", "false");
              document.body.classList.remove("no-scroll");
            } else {
              hamburger.classList.add("is-active");
              mobileNav.classList.add("is-active");
              hamburger.setAttribute("aria-expanded", "true");
              document.body.classList.add("no-scroll");
            }
          });

          mobileLinks.forEach((link) => {
            link.addEventListener("click", () => {
              hamburger.classList.remove("is-active");
              mobileNav.classList.remove("is-active");
              hamburger.setAttribute("aria-expanded", "false");
              document.body.classList.remove("no-scroll");
            });
          });
        }

        // --- 3. スクロール連動処理 (ヘッダー) ---
        const stickyHeader = document.querySelector(".sticky-header");
        const heroSection = document.querySelector(".hero");

        const handleScroll = () => {
          if (!heroSection) return;
          const heroBottom = heroSection.getBoundingClientRect().bottom;

          if (heroBottom <= 80) {
            if (stickyHeader) stickyHeader.classList.add("is-show");
            if (hamburger) hamburger.classList.add("is-black");
          } else {
            if (stickyHeader) stickyHeader.classList.remove("is-show");
            if (hamburger) hamburger.classList.remove("is-black");
          }
        };

        window.addEventListener("scroll", handleScroll);
        handleScroll();
      };

      // --- 4. EXHIBITION セクションのデータ取得と無限スクロール・出現アニメーション ---
      const initExhibition = async () => {
        const track = document.getElementById("exhibitionTrack");
        if (!track) return;

        try {
          const response = await fetch("/src/pages/data/exhibitions.json");
          const exhibitions = await response.json();
          if (!exhibitions || exhibitions.length === 0) return;

          const shuffled = [...exhibitions]
            .sort(() => 0.5 - Math.random())
            .slice(0, 8);

          // ドロップシャドウを適用するためにラッパー(div)でaタグを囲んでいます
          const cardHtml = shuffled
            .map(
              (item) => `
            <div class="exhibition-card-wrapper">
              <a href="/exhibition" class="exhibition-card">
                <img src="${item.image}" alt="展示画像" class="exhibition-card-img" loading="lazy" onerror="this.src='https://via.placeholder.com/400x300?text=No+Image'" />
              </a>
            </div>
          `,
            )
            .join("");

          track.innerHTML = cardHtml + cardHtml + cardHtml;

          requestAnimationFrame(() => {
            gsap.to(track, {
              xPercent: -33.3333,
              ease: "none",
              duration: 25,
              repeat: -1,
            });
          });
        } catch (error) {
          console.error("EXHIBITIONデータの読み込みに失敗しました:", error);
        }

        // --- 5. スクロール連動での出現アニメーション (IntersectionObserver) ---
        const exhibitionSection = document.querySelector(".exhibition-section");
        if (exhibitionSection) {
          const observer = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  gsap.fromTo(
                    ".exhibition-title",
                    { clipPath: "inset(0 100% 0 0)" },
                    {
                      clipPath: "inset(0 0% 0 0)",
                      duration: 0.9,
                      ease: "power3.inOut",
                    },
                  );
                  gsap.fromTo(
                    ".exhibition-subtitle",
                    { y: 20, opacity: 0 },
                    {
                      y: 0,
                      opacity: 1,
                      duration: 0.7,
                      ease: "power2.out",
                      delay: 0.4,
                    },
                  );
                  gsap.fromTo(
                    ".exhibition-carousel-wrapper",
                    { clipPath: "inset(0 100% 0 0)", opacity: 0 },
                    {
                      clipPath: "inset(0 0% 0 0)",
                      opacity: 1,
                      duration: 1.2,
                      ease: "power3.inOut",
                      delay: 0.6,
                    },
                  );
                  obs.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.2 },
          );

          observer.observe(exhibitionSection);
        }
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          initApp();
          initExhibition();
        });
      } else {
        initApp();
        initExhibition();
      }
    </script>
  </body>
</html>

<style>
  body {
    font-family:
      "Noto Sans JP",
      system-ui,
      -apple-system,
      sans-serif;
    margin: 0;
    padding: 0;
    background-color: #000;
    overflow-x: hidden;
  }

  body.no-scroll {
    overflow: hidden;
  }

  /* (ヘッダーやHero等の既存スタイル) */
  .sticky-header {
    position: fixed;
    top: 0;
    left: 0;
