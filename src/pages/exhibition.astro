---
import { Image } from "astro:assets";
import rawExhibitions from "../pages/data/exhibitions.json";
import instagramIcon from "../pages/assets/Instagram.svg";
import youtubeIcon from "../pages/assets/youtube.svg";
import xIcon from "../pages/assets/X.svg";
import anchorIcon from "../pages/assets/scroll.svg";
// 背景画像をAstroのassetsとしてインポート（ビルド時のパスエラー防止）
import titleBg from "../pages/assets/TitleBackground.webp";
import logoImg from "../pages/assets/logo.svg";
import typoImg from "../pages/assets/typo.svg";

import titleBackgroundDark from "../pages/assets/TitleBackgroundDark.webp";
import titleBackgroundBlack from "../pages/assets/TitleBackgroundBlack.jpg";

// --- TypeScript 型定義 ---
export interface Exhibition {
  id: number;
  slug: string;
  name: string;
  room: string | null;
  floor: string | null;
  description: string | null;
  image: string;
  categories: string[];
  favorite: boolean;
}

// --- データクレンジング ---
const exhibitions: Exhibition[] = (rawExhibitions as any[]).filter(
  (item): item is Exhibition => {
    return Boolean(
      item && item.name && item.name !== "nan" && typeof item.name === "string",
    );
  },
);

// カテゴリー（体験目的）の動的抽出
const availableCategories = Array.from(
  new Set(exhibitions.flatMap((item) => item.categories || [])),
).filter(Boolean);

const pageTitle = "参加団体一覧 | 駒場東邦 第69回 文化祭 | SAIL BEYOND";
const pageDescription =
  "駒場東邦 第69回 文化祭「SAIL BEYOND」の参加団体・展示一覧ページです。";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="https://69.komafes.jp/favicon.ico" />
    <link rel="icon" href="https://69.komafes.jp/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="96x96" href="https://69.komafes.jp/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="https://69.komafes.jp/favicon.svg" />


    <!-- iOS / WebManifest 用 -->
    <link rel="apple-touch-icon" sizes="180x180" href="https://69.komafes.jp/apple-touch-icon.png" />
    <link rel="manifest" href="https://69.komafes.jp/site.webmanifest" />


    <meta
      name="keywords"
      content="駒場東邦,駒場東邦文化祭,文化祭,Komafes,Komafes69,SAIL BEYOND,参加団体,展示"
    />
  </head>
  <body>
    <!-- ========================================
         スマホ用 メニュー (中身)
         ======================================== -->
    <!-- ※ボタンは移動しますが、nav本体はここに残します -->
    <nav id="mobile-menu" class="mobile-nav">
      <ul>
        <li><a href="/">TOP</a></li>
        <li><a href="/theme">THEME</a></li>
        <li><a href="/exhibition">EXHIBITION</a></li>
        <li><a href="/articles">ARTICLES</a></li>
        <li><a href="/timetable">TIME TABLE</a></li>
        <li><a href="/map">MAP</a></li>
        <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
      </ul>
      <div class="mobile-sns-links">
        <a
          href="https://www.instagram.com/komafes69/"
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={instagramIcon.src} alt="" class="sns-icon" />
          <span>Instagram</span>
        </a>
        <a
          href="https://www.youtube.com/@komafes69"
          aria-label="YouTube"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={youtubeIcon.src} alt="" class="sns-icon" />
          <span>YouTube</span>
        </a>
        <a
          href="https://x.com/Komafes69"
          aria-label="X"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={xIcon.src} alt="" class="sns-icon" />
          <span>X</span>
        </a>
      </div>
    </nav>

    <!-- ========================================
         PC・タブレット・スマホ兼用 ヘッダー
         ======================================== -->
    <header class="sticky-header">
      <div class="sticky-header-inner">
        <!-- 左側: ロゴとタイポ -->
        <a href="/" class="header-brand">
          <img src={logoImg.src} alt="Komafes69 Logo" class="header-logo" />
          <img src={typoImg.src} alt="SAIL BEYOND" class="header-typo" />
        </a>

        <!-- 右側: PCナビゲーション ＆ スマホハンバーガー -->
        <div class="header-right">
          <nav class="header-nav">
            <ul>
              <li><a href="/">TOP</a></li>
              <li><a href="/theme">THEME</a></li>
              <li><a href="/exhibition">EXHIBITION</a></li>
              <li><a href="/articles">ARTICLES</a></li>
              <li><a href="/timetable">TIME TABLE</a></li>
              <li><a href="/map">MAP</a></li>
              <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
            </ul>
          </nav>

          <!-- ハンバーガーボタンをヘッダー内に移動 -->
          <button
            class="hamburger"
            aria-label="メニューを開く"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </button>
        </div>
      </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="exhibition-container">
      <!-- 背景画像をインラインスタイルで適用（確実なパス解決） -->
      <header
        class="page-header"
        style={`background-image: url('${titleBg.src}');`}
      >
        <div class="page-header-inner">
          <h1 class="page-title">EXHIBITIONS</h1>
          <p class="page-subtitle">参加団体紹介</p>
        </div>
      </header>

      <!-- 検索＆フィルターエリア -->
      <section class="filter-section">
        <!-- 検索バー & カテゴリー選択 -->
        <div class="search-controls">
          <div class="search-box">
            <svg
              class="search-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="search-input"
              placeholder="団体名、キーワード、部屋名から検索..."
            />
            <button
              id="clear-btn"
              class="clear-btn"
              aria-label="クリア"
              style="display: none;">×</button
            >
          </div>

          <!-- 体験目的カテゴリー選択 -->
          <div class="category-select-wrapper">
            <select id="category-select" class="category-select">
              <option value="ALL">すべてのカテゴリー（体験目的）</option>
              {
                availableCategories.map((cat) => (
                  <option value={cat}>{cat}</option>
                ))
              }
            </select>
          </div>
        </div>

        <!-- フロア（階数）チップ UI -->
        <div class="floor-chips" id="floor-chips">
          <button class="chip active" data-floor="ALL">全フロア</button>
          <button class="chip" data-floor="1">1階</button>
          <button class="chip" data-floor="2">2階</button>
          <button class="chip" data-floor="3">3階</button>
          <button class="chip" data-floor="4">4階</button>
          <button class="chip" data-floor="5">5階</button>
          <button class="chip" data-floor="OTHER"
            >その他（講堂・体育館等）</button
          >
        </div>

        <!-- 追加: お気に入り団体を見るボタン -->
        <div class="view-favorites-container">
          <a href="/favorites" class="view-favorites-btn">
            <svg viewBox="0 0 24 24" class="btn-heart-icon"
              ><path
                d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
              ></path></svg
            >
            お気に入り団体を見る
          </a>
        </div>

        <!-- 件数表示 -->
        <div class="result-count">
          <span id="count-num">0</span> 件を表示中
        </div>
      </section>

      <!-- カードグリッド -->
      <section class="exhibition-grid" id="exhibition-grid">
        <!-- JSでカードが生成されます -->
      </section>

      <!-- 該当なしメッセージ -->
      <div id="no-results" class="no-results" style="display: none;">
        <p>条件に一致する団体が見つかりませんでした。</p>
      </div>
    </main>

    <!-- スクロール連動：錨（アンカー）上に戻るボタン -->
    <div id="anchor-scroll-top" class="anchor-scroll-top">
      <div class="anchor-line"></div>
      <div class="anchor-body">
        <span class="anchor-text">PULL TO TOP</span>
        <img src={anchorIcon.src} alt="PAGE TOP" class="anchor-img" />
      </div>
    </div>

    <footer
      class="footer"
      style={`background-image: url('${titleBackgroundBlack.src}'); background-size: cover; background-position: center;`}
    >
      <div class="footer-inner">
        <!-- 左側：学校情報・アクセス -->
        <div class="footer-info">
          <p class="school-name">駒場東邦中学校・高等学校 第69回 文化祭</p>
          <!-- SVGロゴを使用 -->
          <a href="/" class="footer-brand">
            <img src={logoImg.src} alt="Komafes69 Logo" class="footer-logo" />
            <img src={typoImg.src} alt="SAIL BEYOND" class="footer-typo" />
          </a>

          <div class="school-details">
            <p><strong>開催日時：</strong>9月19日(土)・20日(日) 9:00〜16:30</p>
            <p><strong>所在地：</strong>〒154-0001 東京都世田谷区池尻4-5-1</p>
            <p class="access-info">
              東急田園都市線「池尻大橋」駅より徒歩10分<br />
              京王井の頭線「駒場東大前」駅より徒歩10分
            </p>
          </div>
        </div>

        <!-- 右側：ミニサイトマップとSNS -->
        <div class="footer-nav">
          <ul class="sitemap">
            <li><a href="/">TOP</a></li>
            <li><a href="/theme">THEME</a></li>
            <li><a href="/exhibition">EXHIBITION</a></li>
            <li><a href="/articles">ARTICLES</a></li>
            <li><a href="/timetable">TIME TABLE</a></li>
            <li><a href="/map">MAP</a></li>
            <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
          </ul>

          <div class="footer-sns">
            <a
              href="https://www.instagram.com/komafes69/"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={instagramIcon.src}
                alt="Instagram"
                class="footer-sns-icon"
              />
            </a>
            <a
              href="https://www.youtube.com/@komafes69"
              aria-label="YouTube"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={youtubeIcon.src}
                alt="YouTube"
                class="footer-sns-icon"
              />
            </a>
            <a
              href="https://x.com/Komafes69"
              aria-label="X"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src={xIcon.src} alt="X" class="footer-sns-icon" />
            </a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; 2026 Komafes69 All Rights Reserved.</p>
      </div>
    </footer>

    <script is:inline define:vars={{ exhibitions }}>
      window.exhibitionsData = exhibitions;
    </script>

    <!-- 2. メイン処理 -->
    <script>
      import { gsap } from "gsap";

      // TypeScriptの型定義（windowに生やしたデータを認識させる）
      declare global {
        interface Window {
          exhibitionsData: any[];
        }
      }

      document.addEventListener("DOMContentLoaded", () => {
        // --- お気に入り情報の取得 (localStorage) ---
        const STORAGE_KEY = "komafes_favorites";
        const getFavorites = (): string[] => {
          try {
            return JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
          } catch {
            return [];
          }
        };

        // --- GSAP アニメーション実行 ---
        gsap.fromTo(
          ".page-title",
          { clipPath: "inset(0 100% 0 0)", opacity: 1 },
          {
            clipPath: "inset(0 0% 0 0)",
            duration: 2.5,
            ease: "power2.out",
            delay: 0.3,
          },
        );

        gsap.fromTo(
          ".page-subtitle",
          { clipPath: "inset(0 100% 0 0)", opacity: 1 },
          {
            clipPath: "inset(0 0% 0 0)",
            duration: 2.5,
            ease: "power2.out",
            delay: 0.45,
          },
        );

        // --- フィルター＆カード生成処理 ---
        const grid = document.getElementById("exhibition-grid") as HTMLElement;
        const searchInput = document.getElementById(
          "search-input",
        ) as HTMLInputElement;
        const clearBtn = document.getElementById(
          "clear-btn",
        ) as HTMLButtonElement;
        const categorySelect = document.getElementById(
          "category-select",
        ) as HTMLSelectElement;
        const chips = document.querySelectorAll(".chip");
        const countNum = document.getElementById("count-num") as HTMLElement;
        const noResults = document.getElementById("no-results") as HTMLElement;

        // TOP と同様に、ページ冒頭のビジュアルを通過した後で
        // 固定ヘッダーを表示する。
        const stickyHeader = document.querySelector(".sticky-header");
        const headerTrigger = document.querySelector(".hero, .page-header");
        const hamburger = document.querySelector(".hamburger");
        const mobileNav = document.querySelector(".mobile-nav");
        const mobileLinks = document.querySelectorAll(".mobile-nav a");

        const closeMobileNav = () => {
          hamburger?.classList.remove("is-active", "is-black");
          mobileNav?.classList.remove("is-active");
          hamburger?.setAttribute("aria-expanded", "false");
          document.body.classList.remove("no-scroll");
        };

        hamburger?.addEventListener("click", () => {
          const isOpen = hamburger.classList.toggle("is-active");
          mobileNav?.classList.toggle("is-active", isOpen);
          hamburger.setAttribute("aria-expanded", String(isOpen));
          document.body.classList.toggle("no-scroll", isOpen);
        });
        mobileLinks.forEach((link) =>
          link.addEventListener("click", closeMobileNav),
        );

        const handleHeaderScroll = () => {
          if (!headerTrigger) return;

          const shouldShow = headerTrigger.getBoundingClientRect().bottom <= 80;
          stickyHeader?.classList.toggle("is-show", shouldShow);
          hamburger?.classList.toggle("is-black", shouldShow);
        };

        window.addEventListener("scroll", handleHeaderScroll, {
          passive: true,
        });
        handleHeaderScroll();

        let currentFloor = "ALL";
        let currentCategory = "ALL";
        let currentKeyword = "";

        const fallbackSvg = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="%23a0aec0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>`;

        const shuffleArray = (array: any[]) => {
          const shuffled = [...array];
          for (let i = shuffled.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
          }
          return shuffled;
        };

        const items = shuffleArray(window.exhibitionsData || []);

        const renderCards = (data: any[]) => {
          grid.innerHTML = "";
          countNum.textContent = data.length.toString();

          // レンダリング時に現在のお気に入りリストを取得
          const favorites = getFavorites();

          if (data.length === 0) {
            noResults.style.display = "block";
            return;
          } else {
            noResults.style.display = "none";
          }

          data.forEach((item: any, index: number) => {
            const card = document.createElement("a");
            card.href = `/exhibition/${item.slug}`;
            card.className = "exhibition-card";

            const delay = Math.min(index * 0.04, 0.5);
            card.style.animationDelay = `${delay}s`;

            const roomText = item.room && item.room !== "NaN" ? item.room : "";
            const rawFloor = item.floor ? String(item.floor) : "";
            const floorText =
              rawFloor && rawFloor !== "NaN"
                ? ["1", "2", "3", "4", "5"].includes(rawFloor)
                  ? `${rawFloor}階`
                  : rawFloor
                : "";

            const locationText = [floorText, roomText]
              .filter(Boolean)
              .join(" / ");

            const categoryBadges = (item.categories || [])
              .map((c: string) => `<span class="cat-badge">${c}</span>`)
              .join("");

            const hasValidImage = Boolean(
              item.image && item.image.startsWith("/"),
            );

            let rawDesc = item.description || "";
            if (rawDesc.length > 120) {
              rawDesc = rawDesc.substring(0, 120) + "...";
            }
            const formattedDesc = rawDesc.replace(/\n/g, "<br>");

            // お気に入り状態の判定
            const isFav = favorites.includes(item.slug) ? "is-active" : "";

            card.innerHTML = `
              <!-- 追加: いいねボタン (slugをIDとして利用) -->
              <button class="favorite-toggle-btn ${isFav}" data-id="${item.slug}" aria-label="お気に入りに追加">
                <svg viewBox="0 0 24 24" class="heart-svg">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              </button>

              <div class="card-image-wrapper">
                <img 
                  src="${hasValidImage ? item.image : fallbackSvg}" 
                  alt="${item.name}" 
                  class="${hasValidImage ? "card-img" : "card-img fallback"}"
                />
                ${locationText ? `<span class="location-chip">${locationText}</span>` : ""}
              </div>
              <div class="card-body">
                <h2 class="card-title">${item.name}</h2>
                ${categoryBadges ? `<div class="card-categories">${categoryBadges}</div>` : ""}
                <p class="card-description">${formattedDesc}</p>
              </div>
            `;

            const imgEl = card.querySelector(".card-img") as HTMLImageElement;
            if (imgEl && hasValidImage) {
              imgEl.addEventListener(
                "error",
                () => {
                  imgEl.src = fallbackSvg;
                  imgEl.classList.add("fallback");
                },
                { once: true },
              );
            }

            grid.appendChild(card);

            // --- 2. スマホ用ハンバーガーメニュー制御 ---
            // --- 3. スクロール連動処理 (ヘッダー) ---
          });
        };

        // --- お気に入りボタンのクリックイベント（イベント委譲） ---
        grid.addEventListener("click", (e) => {
          const btn = (e.target as Element).closest(".favorite-toggle-btn");
          if (!btn) return;

          // リンク遷移をキャンセル
          e.preventDefault();
          e.stopPropagation();

          const slug = btn.getAttribute("data-id");
          if (!slug) return;

          const isActive = btn.classList.contains("is-active");
          let currentFavorites = getFavorites();

          if (isActive) {
            // お気に入り解除
            btn.classList.remove("is-active");
            currentFavorites = currentFavorites.filter((id) => id !== slug);
          } else {
            // お気に入り追加
            btn.classList.add("is-active");
            if (!currentFavorites.includes(slug)) {
              currentFavorites.push(slug);
            }
          }

          localStorage.setItem(STORAGE_KEY, JSON.stringify(currentFavorites));
        });

        const filterData = () => {
          const keyword = currentKeyword.toLowerCase().trim();

          const filtered = items.filter((item: any) => {
            const itemFloor = item.floor ? String(item.floor) : "";
            let matchesFloor = false;

            if (currentFloor === "ALL") {
              matchesFloor = true;
            } else if (currentFloor === "OTHER") {
              matchesFloor = !["1", "2", "3", "4", "5"].includes(itemFloor);
            } else {
              matchesFloor = itemFloor === currentFloor;
            }

            const itemCategories = item.categories || [];
            const matchesCategory =
              currentCategory === "ALL" ||
              itemCategories.includes(currentCategory);

            const matchesKeyword =
              !keyword ||
              (item.name && item.name.toLowerCase().includes(keyword)) ||
              (item.description &&
                item.description.toLowerCase().includes(keyword)) ||
              (item.room && item.room.toLowerCase().includes(keyword));

            return matchesFloor && matchesCategory && matchesKeyword;
          });

          renderCards(filtered);
        };

        searchInput.addEventListener("input", (e) => {
          currentKeyword = (e.target as HTMLInputElement).value;
          clearBtn.style.display = currentKeyword ? "block" : "none";
          filterData();
        });

        clearBtn.addEventListener("click", () => {
          searchInput.value = "";
          currentKeyword = "";
          clearBtn.style.display = "none";
          filterData();
        });

        categorySelect.addEventListener("change", (e) => {
          currentCategory = (e.target as HTMLSelectElement).value;
          filterData();
        });

        chips.forEach((chip) => {
          chip.addEventListener("click", () => {
            chips.forEach((c) => c.classList.remove("active"));
            chip.classList.add("active");
            currentFloor = chip.getAttribute("data-floor") || "ALL";
            filterData();
          });
        });

        // --- 錨（アンカー）のスクロール連動＆「上に戻る」処理 ---
        const anchorBtn = document.getElementById("anchor-scroll-top");
        const anchorLine = document.querySelector(
          ".anchor-line",
        ) as HTMLElement;

        if (anchorBtn && anchorLine) {
          window.addEventListener("scroll", () => {
            const scrollY = window.scrollY;
            const docHeight =
              document.documentElement.scrollHeight - window.innerHeight;

            if (scrollY > 150) {
              anchorBtn.classList.add("is-visible");
            } else {
              anchorBtn.classList.remove("is-visible");
            }

            const scrollRatio =
              docHeight > 0 ? Math.min(scrollY / docHeight, 1) : 0;
            const maxLineHeight = window.innerHeight * 0.7;
            const currentLineHeight = scrollRatio * maxLineHeight;

            anchorLine.style.height = `${currentLineHeight}px`;
          });

          anchorBtn.addEventListener("click", () => {
            window.scrollTo({
              top: 0,
              behavior: "smooth",
            });
          });
        }

        renderCards(items);
      });
    </script>
  </body>
</html>

