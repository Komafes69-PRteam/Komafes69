---
import mapData from './data/mergedMap.json';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>校内マップ - ナビゲーション</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style is:global>
      :root {
        --primary-blue: #007AFF;
        --bg-color: #f8fafc;
      }
      body, html {
        margin: 0; padding: 0; height: 100%; width: 100%;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        overflow: hidden;
      }
      
      #map {
        position: absolute; top: 0; left: 0;
        width: 100vw; height: 100dvh;
        background-color: var(--bg-color);
        z-index: 1;
      }

      /* 施設・教室のみを示す半透明ピン */
      .map-pin {
        display: block;
        width: 18px; height: 18px;
        background-color: rgba(15, 23, 42, 0.42);
        border: 2px solid rgba(255, 255, 255, 0.95);
        border-radius: 50%;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.3);
        transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
      }
      .map-pin:hover, .map-pin:active {
        transform: scale(1.2);
        background-color: rgba(0, 122, 255, 0.72);
      }
      .map-pin.is-selected {
        background-color: #007AFF;
        box-shadow: 0 0 0 5px rgba(0, 122, 255, 0.2), 0 4px 12px rgba(0, 122, 255, 0.42);
        transform: scale(1.25);
      }

      .ui-layer {
        position: absolute; top: 0; left: 0;
        width: 100%; height: 100%;
        pointer-events: none;
        z-index: 1000;
        display: flex; flex-direction: column; justify-content: space-between;
      }

      .top-controls {
        padding: max(24px, env(safe-area-inset-top)) 16px 10px;
        pointer-events: auto;
      }
      .search-box {
        background: rgba(255,255,255,0.96); border: 1px solid rgba(148,163,184,0.22); border-radius: 18px;
        padding: 13px 16px; box-shadow: 0 10px 28px rgba(15,23,42,0.12);
        display: flex; align-items: center; margin-bottom: 12px;
      }
      .search-box input {
        border: none; outline: none; width: 100%;
        font-size: 16px; margin-left: 8px;
      }
      .chips {
        display: flex; gap: 8px; overflow-x: auto;
        padding-bottom: 4px; scrollbar-width: none;
      }
      .chips::-webkit-scrollbar { display: none; }
      .chip {
        background: rgba(255,255,255,0.92); border: 1px solid #dbe4ef;
        border-radius: 999px; padding: 8px 12px; font-size: 12px;
        white-space: nowrap; font-weight: 700; color: #334155;
        box-shadow: 0 3px 8px rgba(15,23,42,0.08); cursor: pointer;
        transition: transform .2s ease, background-color .2s ease, color .2s ease;
      }
      .chip:hover { transform: translateY(-1px); background: #eff6ff; color: #075dc5; }

      .floor-selector {
        position: absolute; right: 16px; top: 50%; transform: translateY(-50%);
        background: rgba(255,255,255,0.9); border-radius: 24px;
        padding: 4px; display: flex; flex-direction: column; gap: 4px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1); pointer-events: auto;
        backdrop-filter: blur(4px);
      }
      .floor-btn {
        width: 40px; height: 40px; border-radius: 50%; border: none;
        background: transparent; font-weight: bold; font-size: 14px;
        cursor: pointer; color: #555; transition: 0.2s;
      }
      .floor-btn.active { background: var(--primary-blue); color: white; }

      .bottom-sheet {
        background: rgba(255,255,255,0.98); border-radius: 24px 24px 0 0;
        padding: 14px 20px 30px; box-shadow: 0 -12px 34px rgba(15,23,42,0.16);
        transform: translateY(100%); transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
        pointer-events: auto; display: flex; flex-direction: column;
        max-height: 60vh;
      }
      .bottom-sheet.open { transform: translateY(0); }
      .sheet-handle {
        width: 40px; height: 5px; background: #ddd; border-radius: 3px;
        margin: 0 auto 16px; cursor: pointer;
      }

      /* --- リスト表示モード --- */
      #sheet-list-view { display: none; flex-direction: column; overflow: hidden; }
      .list-title { font-size: 17px; font-weight: 800; margin: 0 0 12px 0; color: #0f172a; letter-spacing: -.02em; }
      .results-container { overflow-y: auto; flex-grow: 1; padding: 2px 0 20px; }
      .result-item {
        display: flex; align-items: center; gap: 12px;
        padding: 13px 4px; border-bottom: 1px solid #e2e8f0; cursor: pointer;
        transition: background-color .2s ease, transform .2s ease;
      }
      .result-item:last-child { border-bottom: none; }
      .result-item:hover { background: #f8fbff; transform: translateX(2px); }
      .result-leading { width: 34px; height: 34px; border-radius: 11px; flex: 0 0 auto; display: grid; place-items: center; background: #eff6ff; color: #0874e9; font-size: 16px; }
      .result-content { min-width: 0; flex: 1; }
      .result-title { font-size: 15px; font-weight: 800; color: #0f172a; margin: 0 0 7px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      
      /* リスト内のチップUI群 */
      .result-meta { display: flex; flex-wrap: wrap; gap: 7px; align-items: center; }
      .meta-chip {
        padding: 4px 8px; border-radius: 999px; font-size: 11px; font-weight: 700;
        background: #f1f5f9; color: #475569; white-space: nowrap;
      }
      .meta-divider { width: 1px; height: 14px; background: #cbd5e1; flex: 0 0 auto; }
      /* 距離によるチップの色分け */
      .meta-chip.dist-very-near { background: #dcfce7; color: #166534; }
      .meta-chip.dist-near { background: #fef9c3; color: #854d0e; }
      .meta-chip.dist-normal { background: #f1f5f9; color: #475569; }
      .meta-chip.dist-far { background: #fee2e2; color: #991b1b; }

      /* --- 詳細表示モード --- */
      #sheet-detail-view { display: none; flex-direction: column; gap: 12px; }
      .status-badge {
        display: none; width: fit-content;
        background: #e0f2fe; color: #0284c7;
        padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold;
      }
      .status-badge.visible { display: block; }
      .sheet-title { font-size: 20px; font-weight: bold; margin: 0; }
      .sheet-subtitle { font-size: 14px; color: #666; margin: 0; }
      .action-buttons { display: flex; gap: 10px; margin-top: 8px; }
      .btn {
        flex: 1; padding: 14px; border-radius: 12px; border: none;
        font-weight: bold; font-size: 15px; cursor: pointer; text-align: center;
      }
      .btn-primary { background: var(--primary-blue); color: white; }
      .btn-secondary { background: #f1f5f9; color: #333; }
      
      .route-status {
        position: absolute; top: 110px; left: 16px; right: 16px;
        background: var(--primary-blue); color: white;
        padding: 12px; border-radius: 12px; font-weight: bold; font-size: 14px;
        display: none; pointer-events: auto; justify-content: space-between; align-items: center;
        box-shadow: 0 4px 12px rgba(0,122,255,0.3);
      }
      .route-status.active { display: flex; }
      .clear-route-btn { background: rgba(255,255,255,0.2); border: none; color: white; padding: 4px 12px; border-radius: 16px; }

      .leaflet-control-zoom { display: none !important; }
    </style>
  </head>
  <body>
    <div id="map"></div>

    <div class="ui-layer">
      <div>
        <div class="top-controls">
          <div class="search-box" id="search-box-container">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="search-input" placeholder="教室・団体名を検索" autocomplete="off" />
          </div>
          <div class="chips">
            <div class="chip" onclick="searchCategory('mens_toilet')">近くの男子トイレ</div>
            <div class="chip" onclick="searchCategory('womens_toilet')">近くの女子トイレ</div>
            <div class="chip" onclick="searchCategory('room')">展示・教室</div>
          </div>
        </div>
        
        <div class="route-status" id="route-status">
          <span id="route-text">経路案内中</span>
          <button class="clear-route-btn" onclick="clearRoute()">終了</button>
        </div>
      </div>

      <div class="floor-selector">
        <button class="floor-btn" data-floor="5">5F</button>
        <button class="floor-btn" data-floor="4">4F</button>
        <button class="floor-btn" data-floor="3">3F</button>
        <button class="floor-btn" data-floor="2">2F</button>
        <button class="floor-btn" data-floor="1">1F</button>
      </div>

      <div class="bottom-sheet" id="bottom-sheet">
        <div class="sheet-handle" onclick="closeSheet()"></div>
        
        <div id="sheet-list-view">
          <h3 class="list-title" id="list-title">現在地から近い団体</h3>
          <div id="results-container" class="results-container"></div>
        </div>

        <div id="sheet-detail-view">
          <div class="status-badge" id="sheet-status">目的地に設定中</div>
          <h2 class="sheet-title" id="sheet-title">団体名</h2>
          <p class="sheet-subtitle" id="sheet-subtitle">フロア・教室情報</p>
          <div class="action-buttons">
            <button class="btn btn-secondary" id="btn-set-start">ここから出発</button>
            <button class="btn btn-primary" id="btn-set-end">目的地にする</button>
          </div>
        </div>
      </div>
    </div>

    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script is:inline define:vars={{ mapData }}>
      const floorConfig = {
        1: { image: '/maps/map1f.png' },
        2: { image: '/maps/map2f.png' },
        3: { image: '/maps/map3f.png' },
        4: { image: '/maps/map4f.png' },
        5: { image: '/maps/map5f.png' }
      };

      let currentFloor = 1;
      let currentImgHeight = 1000;
      let startNodeId = null;
      let endNodeId = null;
      let currentPathNodes = [];
      let selectedNode = null;
      
      let myLocationNodeId = mapData.nodes.find(n => n.floor === 1)?.id;

      const map = L.map('map', { crs: L.CRS.Simple, minZoom: -2, maxZoom: 2, zoomSnap: 0.5, zoomControl: false });
      let imageOverlay = null;
      const markersLayer = L.layerGroup().addTo(map);
      const routeLayer = L.layerGroup().addTo(map);
      const pinTypes = new Set(['room', 'stair', 'mens_toilet', 'womens_toilet', 'multipurpose_toilet']);
      const markerByNodeId = new Map();

      const typeLabels = {
        room: '教室',
        stair: '階段',
        mens_toilet: '男子トイレ',
        womens_toilet: '女子トイレ',
        multipurpose_toilet: '多目的トイレ',
      };

      const typeIcons = {
        room: '⌂',
        stair: '↕',
        mens_toilet: '♂',
        womens_toilet: '♀',
        multipurpose_toilet: '♿',
      };

      function getNodeLabel(node) {
        const hasExhibition = node.exhibitionSlugs && node.exhibitionSlugs.length > 0;
        return node.name || (hasExhibition ? node.exhibitionSlugs.join(', ') : (typeLabels[node.type] || '地点'));
      }

      function createPinIcon(node) {
        return L.divIcon({
          className: '',
          html: '<span class="map-pin" aria-hidden="true"></span>',
          iconSize: [18, 18],
          iconAnchor: [9, 9],
        });
      }

      function syncSelectedPin() {
        markerByNodeId.forEach((marker, nodeId) => {
          marker.getElement()?.querySelector('.map-pin')?.classList.toggle('is-selected', nodeId === selectedNode?.id);
        });
      }

      function selectNode(node) {
        selectedNode = node;
        syncSelectedPin();
      }

      function getImageDimensions(url) {
        return new Promise((res, rej) => {
          const img = new Image();
          img.onload = () => res({ width: img.naturalWidth, height: img.naturalHeight });
          img.onerror = () => rej();
          img.src = url;
        });
      }

      async function renderFloor(floorNumber) {
        currentFloor = Number(floorNumber);
        markersLayer.clearLayers();
        markerByNodeId.clear();
        routeLayer.clearLayers();
        updateFloorSelectorUI();

        const config = floorConfig[currentFloor];
        if (!config) return;

        try {
          const { width, height } = await getImageDimensions(config.image);
          currentImgHeight = height;
          const bounds = [[0, 0], [height, width]];

          if (imageOverlay) map.removeLayer(imageOverlay);
          imageOverlay = L.imageOverlay(config.image, bounds).addTo(map);
          map.fitBounds(bounds);

          const currentNodes = mapData.nodes.filter(n => n.floor === currentFloor && pinTypes.has(n.type));
          currentNodes.forEach(node => {
            const latLng = [height - node.y, node.x];
            const label = getNodeLabel(node);
            const marker = L.marker(latLng, { icon: createPinIcon(node), keyboard: true, title: label }).on('click', () => {
              selectNode(node);
              showDetailView(node, label);
            });
            markersLayer.addLayer(marker);
            markerByNodeId.set(node.id, marker);
          });

          syncSelectedPin();

          drawRouteForCurrentFloor();
        } catch (err) { console.error(err); }
      }

      function updateFloorSelectorUI() {
        document.querySelectorAll('.floor-btn').forEach(btn => {
          btn.classList.toggle('active', Number(btn.dataset.floor) === currentFloor);
        });
      }
      document.querySelectorAll('.floor-btn').forEach(btn => {
        btn.addEventListener('click', (e) => renderFloor(e.target.dataset.floor));
      });

      function calculateDistancesFrom(startId) {
        const dist = {};
        const unvisited = new Set();
        mapData.nodes.forEach(n => { dist[n.id] = Infinity; unvisited.add(n.id); });
        dist[startId] = 0;

        const adj = {};
        mapData.nodes.forEach(n => adj[n.id] = []);
        mapData.edges.forEach(e => {
          const d = e.distance || 1;
          adj[e.source].push({ n: e.target, w: d });
          adj[e.target].push({ n: e.source, w: d });
        });

        while (unvisited.size > 0) {
          let curr = null, minD = Infinity;
          unvisited.forEach(id => { if (dist[id] < minD) { minD = dist[id]; curr = id; } });
          if (curr === null || minD === Infinity) break;
          unvisited.delete(curr);

          adj[curr].forEach(neighbor => {
            if (unvisited.has(neighbor.n)) {
              const alt = dist[curr] + neighbor.w;
              if (alt < dist[neighbor.n]) { dist[neighbor.n] = alt; }
            }
          });
        }
        return dist;
      }

      function getDistanceCategory(distance) {
        if (distance < 300) return { text: 'すごく近い', class: 'dist-very-near' };
        if (distance < 700) return { text: '近い', class: 'dist-near' };
        if (distance < 1500) return { text: '普通', class: 'dist-normal' };
        return { text: '遠い', class: 'dist-far' };
      }

      function showListView(query = '') {
        document.getElementById('sheet-detail-view').style.display = 'none';
        document.getElementById('sheet-list-view').style.display = 'flex';
        document.getElementById('bottom-sheet').classList.add('open');

        const titleEl = document.getElementById('list-title');
        const container = document.getElementById('results-container');
        container.innerHTML = '';

        let targetNodes = mapData.nodes.filter(n =>
          pinTypes.has(n.type) && (n.name || (n.exhibitionSlugs && n.exhibitionSlugs.length > 0) || typeLabels[n.type])
        );

        if (query) {
          titleEl.innerText = `「${query}」の検索結果`;
          targetNodes = targetNodes.filter(n => 
            (n.name && n.name.includes(query)) ||
            (n.exhibitionSlugs && n.exhibitionSlugs.join(' ').includes(query)) ||
            (typeLabels[n.type] && typeLabels[n.type].includes(query))
          );
        } else {
          titleEl.innerText = '現在地から近い団体';
        }

        if (targetNodes.length === 0) {
          container.innerHTML = '<p style="color:#666; font-size:14px;">見つかりませんでした</p>';
          return;
        }

        const distances = calculateDistancesFrom(myLocationNodeId);
        targetNodes.sort((a, b) => (distances[a.id] || Infinity) - (distances[b.id] || Infinity));

        targetNodes.forEach(node => {
          const distanceVal = distances[node.id];
          const distInfo = getDistanceCategory(distanceVal);
          
          // 表示用の団体名と教室名を整理
          let title = '';
          let roomName = node.name || typeLabels[node.type] || '教室不明';
          if (node.exhibitionSlugs && node.exhibitionSlugs.length > 0) {
            title = node.exhibitionSlugs.join(', ');
          } else {
            title = getNodeLabel(node);
          }
          
          const item = document.createElement('div');
          item.className = 'result-item';
          item.innerHTML = `
            <div class="result-leading" aria-hidden="true">${typeIcons[node.type] || '•'}</div>
            <div class="result-content">
              <div class="result-title">${title}</div>
              <div class="result-meta">
                <span class="meta-chip">${node.floor}F</span>
                <span class="meta-divider" aria-hidden="true"></span>
                <span class="meta-chip">${typeLabels[node.type] || roomName}</span>
                <span class="meta-divider" aria-hidden="true"></span>
                <span class="meta-chip ${distInfo.class}">${distInfo.text}</span>
              </div>
            </div>
          `;
          
          item.onclick = () => {
            if (currentFloor !== node.floor) renderFloor(node.floor);
            showDetailView(node, title);
          };
          container.appendChild(item);
        });
      }

      function showDetailView(node, label) {
        selectNode(node);
        document.getElementById('sheet-list-view').style.display = 'none';
        document.getElementById('sheet-detail-view').style.display = 'flex';
        
        document.getElementById('sheet-title').innerText = label;
        // 詳細ビューのサブタイトルにも教室名を表示
        let roomName = node.name || typeLabels[node.type] || '教室';
        document.getElementById('sheet-subtitle').innerText = `${node.floor}階 ｜ ${roomName}`;
        
        const isDestination = (endNodeId === node.id);
        document.getElementById('sheet-status').classList.toggle('visible', isDestination);

        document.getElementById('bottom-sheet').classList.add('open');
      }

      window.closeSheet = function() {
        document.getElementById('bottom-sheet').classList.remove('open');
      };

      document.getElementById('search-input').addEventListener('focus', (e) => {
        showListView(e.target.value.trim());
      });

      document.getElementById('search-input').addEventListener('input', (e) => {
        showListView(e.target.value.trim());
      });

      document.getElementById('btn-set-start').addEventListener('click', () => {
        startNodeId = selectedNode.id;
        myLocationNodeId = selectedNode.id;
        checkAndCalculateRoute();
        closeSheet();
      });

      document.getElementById('btn-set-end').addEventListener('click', () => {
        endNodeId = selectedNode.id;
        checkAndCalculateRoute();
        closeSheet();
      });

      window.searchCategory = function(type) {
        const found = mapData.nodes.find(n => n.type === type && n.floor === currentFloor);
        if (found) {
          let label = type === 'mens_toilet' ? '男子トイレ' : (type === 'womens_toilet' ? '女子トイレ' : '教室');
          endNodeId = found.id;
          showDetailView(found, label);
          checkAndCalculateRoute();
        } else {
          alert("この階には見つかりませんでした");
        }
      };

      function checkAndCalculateRoute() {
        if (startNodeId && endNodeId) {
          if (startNodeId === endNodeId) {
            alert("出発地と目的地が同じです"); return;
          }
          currentPathNodes = solveDijkstra(startNodeId, endNodeId);
          if (currentPathNodes.length > 0) {
            const startNode = mapData.nodes.find(n => n.id === startNodeId);
            const endNode = mapData.nodes.find(n => n.id === endNodeId);
            document.getElementById('route-text').innerText = `${startNode.floor}F から ${endNode.floor}F へ案内中`;
            document.getElementById('route-status').classList.add('active');
            if (currentFloor !== startNode.floor) {
              renderFloor(startNode.floor);
            } else {
              drawRouteForCurrentFloor();
            }
          }
        }
      }

      window.clearRoute = function() {
        startNodeId = null; endNodeId = null; currentPathNodes = [];
        routeLayer.clearLayers();
        document.getElementById('route-status').classList.remove('active');
      };

      function drawRouteForCurrentFloor() {
        if (currentPathNodes.length === 0) return;
        routeLayer.clearLayers();
        const nodeMap = new Map(mapData.nodes.map(n => [n.id, n]));
        const polylinePoints = [];
        for (let i = 0; i < currentPathNodes.length; i++) {
          const node = nodeMap.get(currentPathNodes[i]);
          if (node && node.floor === currentFloor) {
            polylinePoints.push([currentImgHeight - node.y, node.x]);
          } else if (polylinePoints.length > 0) {
            L.polyline(polylinePoints, { color: '#007AFF', weight: 8, opacity: 0.9, lineCap: 'round', lineJoin: 'round' }).addTo(routeLayer);
            polylinePoints.length = 0;
          }
        }
        if (polylinePoints.length > 0) {
          L.polyline(polylinePoints, { color: '#007AFF', weight: 8, opacity: 0.9, lineCap: 'round', lineJoin: 'round' }).addTo(routeLayer);
        }
      }

      function solveDijkstra(start, target) {
        const dist = {}, prev = {};
        const unvisited = new Set();
        mapData.nodes.forEach(n => { dist[n.id] = Infinity; prev[n.id] = null; unvisited.add(n.id); });
        dist[start] = 0;
        const adj = {};
        mapData.nodes.forEach(n => adj[n.id] = []);
        mapData.edges.forEach(e => {
          const d = e.distance || 1;
          adj[e.source].push({ n: e.target, w: d });
          adj[e.target].push({ n: e.source, w: d });
        });
        while (unvisited.size > 0) {
          let curr = null, minD = Infinity;
          unvisited.forEach(id => { if (dist[id] < minD) { minD = dist[id]; curr = id; } });
          if (curr === null || curr === target) break;
          unvisited.delete(curr);
          adj[curr].forEach(neighbor => {
            if (unvisited.has(neighbor.n)) {
              const alt = dist[curr] + neighbor.w;
              if (alt < dist[neighbor.n]) { dist[neighbor.n] = alt; prev[neighbor.n] = curr; }
            }
          });
        }
        const path = []; let u = target;
        while (u) { path.unshift(u); u = prev[u]; }
        return path[0] === start ? path : [];
      }

      // 初期起動
      renderFloor(5);
    </script>
  </body>
</html>
