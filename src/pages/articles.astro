      display: block;
      width: 100%;
      height: 2px;
      background-color: #ffffff;
      border-radius: 2px;
      transition:
        background-color 0.3s ease,
        transform 0.3s ease,
        opacity 0.3s ease;
      filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.5));
