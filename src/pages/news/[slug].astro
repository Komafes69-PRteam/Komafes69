---
import { getCollection, render, type CollectionEntry } from "astro:content";

// 画像のimport (パスはご自身のフォルダ構成に合わせて適宜修正してください)
import titleBgImage from "../assets/TitleBackground.webp";
import instagramIcon from "../assets/Instagram.svg";
import youtubeIcon from "../assets/youtube.svg";
import xIcon from "../assets/X.svg";
import logoImg from "../assets/logo.svg";
import typoImg from "../assets/typo.svg";
import titleBackgroundBlack from "../../pages/assets/TitleBackgroundBlack.jpg";

export async function getStaticPaths() {
  const newsEntries = await getCollection("news");
  return newsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"news">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// newsコレクションは title と date のみを使用
const { title, date } = entry.data;

// 投稿日の整形
const formattedDate = date
  ? new Date(date)
      .toLocaleDateString("ja-JP", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      })
      .replace(/\//g, ".")
  : "";

const pageTitle = `${title} | お知らせ | 駒場東邦 第69回 文化祭`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- ファビコン設定 -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Sail Beyond" />
  </head>
  <body>
    <!-- 固定ヘッダー (白背景ベースに変更) -->
    <header class="top-nav">
      <div class="nav-inner">
        <!-- 左上: NEWSの文字 -->
        <div class="nav-brand">NEWS</div>
        
        <!-- 右上: 戻るリンク -->
        <a href="/#news" class="back-link">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
          >
          <span class="back-text">トップページへ戻る</span>
        </a>
      </div>
    </header>

    <main class="article-detail">
      <!-- コンテンツエリア -->
      <section class="content-container">
        <!-- ヘッダー情報 -->
        <div class="content-header">
          <div class="title-area">
            <div class="main-title-wrapper">
              <img src={titleBgImage.src} alt="" class="title-bg" />
              <h1 class="main-title">{title}</h1>
            </div>

            <!-- タイトル右下に投稿日を表示 -->
            {
              formattedDate && (
                <div class="date-container">
                  <time datetime={String(date)} class="published-date">
                    公開日: {formattedDate}
                  </time>
                </div>
              )
            }
            <button
              class="action-btn share-btn"
              id="share-btn"
              data-title={title}
              aria-label="共有する"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon-svg"
              >
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"
                ></path><polyline points="16 6 12 2 8 6"></polyline><line
                  x1="12"
                  y1="2"
                  x2="12"
                  y2="15"></line>
              </svg>
              <span>共有</span>
            </button>
          </div>
        </div>

        <hr class="divider" />

        <!-- Markdown本文 -->
        <article class="prose">
          <Content />
        </article>
      </section>
    </main>

    <!-- フッター -->
    <footer
      class="footer"
      style={`background-image: url('${titleBackgroundBlack.src}'); background-size: cover; background-position: center;`}
    >
      <div class="footer-inner">
        <!-- 左側：学校情報・アクセス -->
        <div class="footer-info">
          <p class="school-name">駒場東邦中学校・高等学校 第69回 文化祭</p>
          <a href="/" class="footer-brand">
            <img src={logoImg.src} alt="Komafes69 Logo" class="footer-logo" />
            <img src={typoImg.src} alt="SAIL BEYOND" class="footer-typo" />
          </a>

          <div class="school-details">
            <p><strong>開催日時：</strong>9月19日(土)・20日(日) 9:00〜16:30</p>
            <p><strong>所在地：</strong>〒154-0001 東京都世田谷区池尻4-5-1</p>
            <p class="access-info">
              東急田園都市線「池尻大橋」駅より徒歩10分<br />
              京王井の頭線「駒場東大前」駅より徒歩10分
            </p>
          </div>
        </div>

        <!-- 右側：ミニサイトマップとSNS -->
        <div class="footer-nav">
          <ul class="sitemap">
            <li><a href="/">TOP</a></li>
            <li><a href="/theme">THEME</a></li>
            <li><a href="/exhibition">EXHIBITION</a></li>
            <li><a href="/articles">ARTICLES</a></li>
            <li><a href="/timetable">TIME TABLE</a></li>
            <li><a href="/map">MAP</a></li>
            <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
          </ul>

          <div class="footer-sns">
            <a
              href="https://www.instagram.com/komafes69/"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src={instagramIcon.src} alt="Instagram" class="footer-sns-icon" />
            </a>
            <a
              href="https://www.youtube.com/@komafes69"
              aria-label="YouTube"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src={youtubeIcon.src} alt="YouTube" class="footer-sns-icon" />
            </a>
            <a
              href="https://x.com/Komafes69"
              aria-label="X"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src={xIcon.src} alt="X" class="footer-sns-icon" />
            </a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; 2026 Komafes69 All Rights Reserved.</p>
      </div>
    </footer>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // --- 共有機能 ---
        const shareBtn = document.getElementById("share-btn");
        if (shareBtn) {
          shareBtn.addEventListener("click", async () => {
            const articleTitle = shareBtn.getAttribute("data-title") || "Komafes69";
            const url = window.location.href;

            const shareData = {
              title: `${articleTitle} | Komafes69`,
              text: `駒場東邦文化祭のお知らせ：「${articleTitle}」`,
              url: url,
            };

            if (navigator.share) {
              try {
                await navigator.share(shareData);
              } catch (err) {
                console.log("Share canceled or failed", err);
              }
            } else {
              navigator.clipboard
                .writeText(url)
                .then(() => alert("URLをクリップボードにコピーしました！"))
                .catch(() => alert("URLのコピーに失敗しました。"));
            }
          });
        }
      });
    </script>
  </body>
</html>

<style>
  body {
    font-family: "Noto Sans JP", system-ui, -apple-system, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #ffffff;
    color: #1a202c;
  }

  /* --- トップナビゲーション (白背景ベース) --- */
  .top-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 900;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #f0f0f0;
    transition: 0.3s;
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between; /* 左右に配置 */
    align-items: center;            /* 縦方向の中央揃え */
  }
  
  /* --- 追加したNEWSの文字スタイル --- */
  .nav-brand {
    font-family: "Bebas Neue", sans-serif;
    font-size: 2rem;
    color: #1a202c;
    letter-spacing: 0.08em;
    margin: 0;
    line-height: 1;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #1a202c;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    transition: transform 0.2s, opacity 0.2s;
  }
  .back-link:hover {
    transform: translateX(-4px);
    opacity: 0.7;
  }
  @media screen and (max-width: 640px) {
    .nav-inner {
      padding: 1rem 1.2rem;
    }
    .back-text {
      display: none;
    }
    .nav-brand {
      font-size: 1.6rem;
    }
  }

  /* --- コンテンツエリア --- */
  .content-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 140px 2rem 5rem;
  }
  @media screen and (max-width: 640px) {
    .content-container {
      padding: 110px 1.5rem 4rem;
    }
  }

  .content-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .title-area {
    flex: 1 1 min-width;
    display: flex;
    flex-direction: column;
  }

  /* --- タイトル装飾 --- */
  .main-title-wrapper {
    position: relative;
    display: inline-block;
    width: fit-content;
    padding: 0.5rem 1.5rem 0.5rem 1rem;
    margin-left: -1rem;
    border-radius: 4px;
    z-index: 1;
  }

  .title-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    border-radius: 4px;
    transform-origin: left;
    animation: revealBg 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes revealBg {
    0% { transform: scaleX(0); opacity: 0; }
    100% { transform: scaleX(1); opacity: 1; }
  }

  .main-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 900;
    margin: 0;
    line-height: 1.25;
    color: #ffffff;
    letter-spacing: -0.02em;
    opacity: 0;
    animation: fadeInTitle 0.6s ease forwards 0.3s;
  }

  @keyframes fadeInTitle {
    0% { opacity: 0; transform: translateY(10px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  /* --- タイトル右下の投稿日 --- */
  .date-container {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.8rem;
  }
  .published-date {
    font-size: 0.9rem;
    font-weight: 600;
    color: #092b5a;
    letter-spacing: 0.03em;
  }
  
  .action-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f8f9fa;
    border: 2px solid #e9eaee;
    border-radius: 12px;
    padding: 0.8rem 1.2rem;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #0f0101;
    font-weight: 700;
    font-size: 0.95rem;
    width: 110px;
    margin-top: 16px;
  }
  .action-btn:hover {
    background: #2563eb;
    border-color: #cbd5e0;
    color: #ffffff;
    transform: translateY(-2px);
  }
  .icon-svg {
    width: 20px;
    height: 20px;
  }

  .divider {
    border: none;
    border-top: 2px solid #e2e8f0;
    margin: 2rem 0 2.5rem;
  }

  /* --- Markdown（prose）装飾 --- */
  .prose {
    font-size: 1.1rem;
    line-height: 1.9;
    color: #0f172a;
    margin-bottom: 4rem;
  }

  .prose :global(h2) {
    font-size: 1.35rem;
    color: #0f172a;
    margin: 2.5rem 0 1.25rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .prose :global(h2)::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 1.35rem;
    background: #2563eb;
    border-radius: 4px;
  }

  .prose :global(h3) {
    font-size: 1.2rem;
    color: #1e293b;
    margin: 2rem 0 1rem;
    font-weight: 700;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 0.4rem;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
  }
  .prose :global(a) {
    color: #2563eb;
    text-decoration: underline;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 24px 0;
  }

  /* ========================================
     FOOTER
     ======================================== */
  .footer {
    background-color: #1a1b1f; 
    color: #f6f9f6;
    padding: 70px 0 20px;
    font-family: "Noto Sans JP", sans-serif;
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }
  .footer-info { flex: 1; }
  .footer-brand {
    display: inline-flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 24px;
    transition: opacity 0.2s ease;
  }
  .footer-brand:hover { opacity: 0.7; }
  .footer-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }
  .footer-typo {
    height: 20px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }
  .school-name {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0 0 20px 0;
  }
  .school-details p {
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0 0 8px 0;
    color: #ccc;
  }
  .school-details strong {
    color: #f6f9f6;
    font-weight: 500;
  }
  .access-info {
    margin-top: 12px !important;
    padding-left: 10px;
    border-left: 2px solid #555;
  }
  .footer-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start; 
  }
  .sitemap {
    list-style: none;
    padding: 0;
    margin: 0 0 30px 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 50px; 
    row-gap: 16px;
    text-align: left; 
  }
  .sitemap a {
    color: #f6f9f6;
    text-decoration: none;
    font-family: "Bebas Neue", cursive;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    display: inline-block; 
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .sitemap a:hover {
    color: #aaa;
    transform: translateX(4px); 
  }
  .footer-sns {
    display: flex;
    gap: 24px;
  }
  .footer-sns-icon {
    width: 22px;
    height: 22px;
    object-fit: contain;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .footer-sns-icon:hover {
    transform: scale(1.15);
    opacity: 0.7;
  }
  .footer-bottom {
    text-align: center;
    margin-top: 30px;
    padding-top: 20px;
  }
  .footer-bottom p {
    margin: 0;
    font-size: 0.75rem;
    color: #b3b1b1;
    letter-spacing: 0.05em;
  }
  @media screen and (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: 50px;
    }
    .school-name { font-size: 4.5vw; }
    .sitemap {
      column-gap: 20px;
      width: 100%;
    }
  }
</style>