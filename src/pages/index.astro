      font-family: "Cormorant Garamond", serif;
      font-style: italic;
      font-size: clamp(1.15rem, 1.55vw, 1.55rem);
      font-weight: 600;
      margin: 0.3rem 0;
      line-height: 1.35;
      border-bottom: 1px dashed rgba(44, 26, 14, 0.3);
      padding-bottom: 0.15rem;
      letter-spacing: 0.02em;
    }

    /* 項目名（Log Entry: など） */
    .log-entry strong {
      font-style: normal;
      font-weight: 700;
      color: #2b180a;
      margin-right: 0.3rem;
    }

    /* 日本語表記 */
    .jp-text {
      font-family: "Shippori Mincho", serif;
      font-size: clamp(1rem, 1.3vw, 1.3rem);
      font-weight: 800;
      letter-spacing: 0.08em;
      color: #0f0702;
      display: inline-block;
    }

    /* -----------------------------------------
     手書き風（左からインクが伸びる）アニメーション
  ----------------------------------------- */
    .write-effect {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
    }

    .is-animated .write-effect {
      animation: writeIn 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    @keyframes writeIn {
      0% {
        opacity: 0;
        clip-path: inset(0 100% 0 0);
      }
      10% {
        opacity: 1;
      }
      100% {
        opacity: 1;
        clip-path: inset(0 0 0 0);
      }
    }

    /* 順次発火用ディレイ */
    .is-animated .delay-1 {
      animation-delay: 0.1s;
    }
    .is-animated .delay-2 {
      animation-delay: 0.4s;
    }
    .is-animated .delay-3 {
      animation-delay: 0.7s;
    }
    .is-animated .delay-4 {
      animation-delay: 1s;
    }
    .is-animated .delay-5 {
      animation-delay: 1.3s;
    }
    .is-animated .delay-6 {
      animation-delay: 1.6s;
    }
    .is-animated .delay-7 {
      animation-delay: 1.9s;
    }
    .is-animated .delay-8 {
      animation-delay: 2.2s;
    }

    /* -----------------------------------------
     カウントダウンエリア
  ----------------------------------------- */
    .countdown-wrapper {
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 100%;
      margin-top: -5rem;
    }

    .countdown-title {
      font-family: "Shippori Mincho", serif;
      font-size: clamp(1.4rem, 2.2vw, 2.2rem);
      font-weight: 800;
      letter-spacing: 0.1em;
      margin-bottom: 1.4rem;
      border-bottom: 2px solid #2c1a0e;
      padding-bottom: 0.2rem;
      color: #0f0702;
    }

    /* カウントダウン数字 */
    .countdown-timer {
      display: flex;
      justify-content: center;
      gap: clamp(0.8rem, 2vw, 1.8rem);
      font-family: "Bebas Neue", cursive;
      font-size: clamp(2.8rem, 4.5vw, 4.5rem);
      font-weight: 700;
      color: #0f0702;
      line-height: 1; /* 修正箇所 */
    }

    .time-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      border-bottom: 1px dashed rgba(44, 26, 14, 0.3);
      padding: 0 0.2rem 0.2rem;
    }

    .time-label {
      font-family: "Bebas Neue", cursive;
      font-size: clamp(0.95rem, 1.2vw, 1.25rem);
      font-weight: 700;
      margin-top: 0.2rem;
      opacity: 0.85;
    }

    /* 開催中・終了後のステータス文字 */
    .event-status-text {
      display: none;
      font-family: "Shippori Mincho", serif;
      font-size: clamp(1.8rem, 3.2vw, 3rem);
      font-weight: 800;
      letter-spacing: 0.1em;
      color: #0f0702;
      border-bottom: 2px solid #2c1a0e;
      padding-bottom: 0.4rem;
    }

    /* -----------------------------------------
     スマホ用レスポンシブ（画像を90度回転＆縦開き化）
  ----------------------------------------- */
    /* スマホ表示時の最適化（768px以下） */
    @media (max-width: 768px) {
      .section-label {
        top: 1.2rem;
        left: 1.5rem;
        font-size: 4.5rem;
      }

      .captains-log-section {
        padding: 4.5rem 0.8rem 2.5rem;
      }

      /* 本のベース：縦幅をさらに伸ばして縦長化（比率 1 : 1.75） */
      .log-paper {
        width: 90%;
        max-width: 420px;
        aspect-ratio: 1 / 2; /* 1:1.5から1:1.75へ伸ばし余白を拡張 */
        background-size: 0 0 !important;
      }

      /* 背景画像を縦長比率に合わせて90度回転・フィット */
      .log-paper::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        width: 200%;
        height: 57.14%;
        transform: translate(-50%, -50%) rotate(90deg);
        background-image: inherit;
        background-size: 100% 100%;
        background-position: center;
        background-repeat: no-repeat;
        z-index: 0;
        pointer-events: none;
      }

      /* コンテンツ配置：縦方向にゆとりを持たせる調整 */
      .log-container {
        flex-direction: column;
        padding: 20% 8.5%;
        gap: 1.3rem;
        height: 100%;
        justify-content: space-around;
      }

      .log-page {
        padding: 0;
      }

      .log-title {
        font-size: 2.1rem;
        margin-bottom: 0.5rem;
      }

      .log-entry p {
        font-size: 1.0rem;
        margin: 0.25rem 0;
        padding-bottom: 0.15rem;
      }

      .countdown-title {
        font-size: 1.35rem;
        margin-bottom: 0.8rem;
      }

      .countdown-timer {
        font-size: 2.7rem;
        gap: 0.6rem;
      }
    }
    /* ========================================
     ACCESS セクション (位置ズレ＆デザイン修正版)
     ======================================== */
    .access-section {
      padding: 80px 0;
      position: relative;
      z-index: 10; /* 前面に配置 */
      background-color: #ffffff; /* 透明だと透けるので白などで塗りつぶす */
    }

    .access-inner {
      max-width: 1500px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .access-header {
      margin-bottom: 40px;
    }

    .access-label-wrapper {
      display: flex;
      align-items: center;
      justify-content: flex-start;
    }

    /* タイトルのフォントサイズもEXHIBITIONSに合わせる */
    .access-title {
      font-size: clamp(3.5rem, 9vw, 9rem);
      font-weight: 800;
      margin: 0;
      padding: 0;
      color: #060906;
      font-family: "Bebas Neue", cursive;
      line-height: 1.1;
      letter-spacing: 0.05em;
      display: inline-block;
    }

    .access-subtitle {
      margin: 6px 0 0;
      font-size: 1.3rem;
      color: #111;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    /* コンテンツのレイアウト */
    .access-content {
      display: flex;
      justify-content: space-between;
      gap: 60px;
      align-items: stretch;
    }

    /* --- 左側：情報エリア --- */
    .access-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      /* ▼ お気に入りの縦棒をここ全体に適用し、キレイに揃える */
      border-left: 3px solid #222;
      padding-left: 24px;
    }

    .access-address-box {
      margin-bottom: 40px;
    }

    .access-school-name {
      font-size: 1.4rem;
      font-weight: 900;
      margin: 0 0 8px 0;
      letter-spacing: 0.05em;
      color: #111;
    }

    .access-address-text {
      font-size: 1rem;
      color: #444;
      margin: 0;
    }

    /* ルート（電車）リスト：AIっぽい枠を廃止し「地べた」に貼り付け */
    .route-list {
      display: flex;
      flex-direction: column;
      gap: 24px;
      margin-bottom: 40px;
    }

    .route-item {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      /* 背景色・枠線・影をすべて削除 */
      background: transparent;
      padding: 0;
      border: none;
      box-shadow: none;
    }

    .route-icon-wrapper {
      background-color: transparent;
      color: #1e2229;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .train-icon {
      width: 100%;
      height: 100%;
    }

    .route-details {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .line-name {
      font-size: 0.85rem;
      color: #666;
      font-weight: 700;
    }

    .station-name {
      font-size: 1.1rem;
      font-weight: 900;
      color: #111;
      display: flex;
      align-items: baseline;
      gap: 12px;
    }

    /* 徒歩時間の枠も廃止し、シンプルなテキストに */
    .walk-time {
      font-size: 0.9rem;
      color: #555;
      font-weight: 700;
      background: transparent;
      padding: 0;
    }

    /* 注意書き */
    .access-notice {
      padding-left: 0;
      border-left: none; /* 親要素で線を引いたのでここは削除 */
    }

    .access-notice p {
      font-size: 0.85rem;
      color: #666;
      margin: 0 0 6px 0;
      line-height: 1.5;
    }

    /* --- 右側：Googleマップ --- */
    .access-map-wrapper {
      flex: 1;
      width: 100%;
      max-width: 600px;
      min-height: 400px;
      position: relative;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .access-map-mobile {
      display: none;
    }

    .access-map-wrapper iframe {
      position: absolute;
      top: 0;
      left: 0;
      transition: filter 0.3s ease;
    }

    .map-overlay-frame {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      box-shadow: outset 0 0 40px rgba(0, 20, 40, 0.2);
    }

    @media screen and (max-width: 768px) {
      .access-section {
        padding: 60px 0;
      }
      .access-header {
        margin-bottom: 24px;
      }
      .access-title {
        font-size: 3.5rem;
      }
      .access-subtitle {
        font-size: 1rem;
      }
      .access-content {
        flex-direction: column;
        gap: 40px;
        margin-top: 24px;
      }
      .access-map-wrapper {
        max-width: 100%;
        height: 350px;
        min-height: auto;
      }

      .access-content > .access-map-wrapper:not(.access-map-mobile) {
        display: none;
      }

      .access-map-mobile {
        display: block !important;
        flex: none;
        width: 100%;
        height: 350px;
        min-height: 350px;
        margin: 32px 0;
      }
    }

    /* ========================================
     船長の公開日誌 / COUNTDOWN
     ======================================== */
    .captains-log-section {
      position: relative;
      overflow: hidden;
      padding: 5px 1rem;
      color: #e9e0bf;
      background:
        radial-gradient(
          ellipse at 88% 10%,
          rgba(55, 98, 112, 0.46),
          transparent 36%
        ),
        radial-gradient(
          ellipse at 8% 95%,
          rgba(112, 76, 37, 0.4),
          transparent 34%
        ),
        #092631;
    }

    .captains-log-section::before {
      position: absolute;
      inset: 16px;
      border: 1px solid rgba(225, 205, 149, 0.36);
      content: "";
      pointer-events: none;
    }

    .captains-log-section::after {
      position: absolute;
      top: -130px;
      right: -80px;
      width: 330px;
      height: 330px;
      border: 1px dashed rgba(226, 207, 154, 0.45);
      border-radius: 50%;
      content: "";
    }

    .captains-log-inner {
      position: relative;
      z-index: 1;
      max-width: 1120px;
      margin: 0 auto;
      padding: clamp(2rem, 5vw, 4rem);
      border-left: 3px solid #d6b66d;
      background: rgba(1, 22, 30, 0.42);
      box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.28);
    }

    .log-heading {
      text-align: center;
    }
    .log-kicker,
    .log-date,
    .countdown-status {
      margin: 0;
      color: #d4bb7e;
      font-family: "Bebas Neue", cursive;
      letter-spacing: 0.2em;
    }
    .log-kicker {
      font-size: 1rem;
    }
    .log-heading h2 {
      margin: 0.45rem 0;
      color: #fbf2d1;
      font-family: "Noto Sans JP", sans-serif;
      font-size: clamp(2rem, 4.2vw, 3.2rem);
      letter-spacing: 0.12em;
    }
    .log-date {
      font-size: 0.78rem;
    }

    .log-details {
      max-width: 760px;
      margin: 2.5rem auto;
      padding: 1.3rem 0;
      border-top: 1px solid rgba(225, 205, 149, 0.42);
      border-bottom: 1px solid rgba(225, 205, 149, 0.42);
    }
    .log-details dl {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      margin: 0;
    }
    .log-details div {
      min-width: 0;
    }
    .log-details dt {
      margin-bottom: 0.45rem;
      color: #d4bb7e;
      font-family: "Bebas Neue", cursive;
      font-size: 0.9rem;
      letter-spacing: 0.15em;
    }
    .log-details dd {
      margin: 0;
      color: #f4edcf;
      font-size: 0.82rem;
      font-weight: 700;
      line-height: 1.7;
    }

    .countdown {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: clamp(0.35rem, 1.3vw, 1rem);
    }
    .countdown-unit {
      display: grid;
      min-width: clamp(58px, 10vw, 108px);
      text-align: center;
    }
    .countdown-unit > span {
      color: #fff4ce;
      font-family: "Bebas Neue", cursive;
      font-size: clamp(3.3rem, 8vw, 6.2rem);
      line-height: 0.85;
      letter-spacing: 0.02em;
      text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.36);
    }
    .countdown-unit small {
      margin-top: 0.8rem;
      color: #d4bb7e;
      font-family: "Bebas Neue", cursive;
      font-size: 0.7rem;
      letter-spacing: 0.16em;
    }
    .countdown-separator {
      padding-top: 0.02em;
      color: #d4bb7e;
      font-family: "Bebas Neue", cursive;
      font-size: clamp(2.4rem, 5vw, 4.3rem);
      line-height: 0.8;
    }
    .countdown-status {
      margin-top: 1.6rem;
      text-align: center;
      font-size: 0.85rem;
    }

    @media screen and (max-width: 768px) {
      .captains-log-section {
        padding: 58px 1rem;
      }
      .captains-log-section::before {
        inset: 9px;
      }
      .captains-log-inner {
        padding: 2.2rem 1.1rem;
      }
      .log-details {
        margin: 1.8rem 0;
      }
      .log-details dl {
        grid-template-columns: 1fr;
        gap: 1rem;
      }
      .log-details div {
        display: grid;
        grid-template-columns: 105px 1fr;
        gap: 0.5rem;
      }
      .log-details dt {
        margin: 0;
      }
      .countdown {
        gap: 0.2rem;
      }
      .countdown-unit {
        min-width: 0;
        flex: 1;
      }
      .countdown-unit > span {
        font-size: clamp(2.5rem, 13vw, 3.4rem);
      }
      .countdown-unit small {
        font-size: 0.53rem;
        letter-spacing: 0.08em;
      }
      .countdown-separator {
        font-size: 2.3rem;
      }
    }

    /* ========================================
     EXHIBITION セクション (アップデート内容)
     ======================================== */
    .exhibition-section {
      padding: 40px 0;
      background-color: #ffffff;
      position: relative;
    }

    .exhibition-header {
      max-width: 1500px;
      margin: 0 auto 30px;
      padding: 0 1.5rem;
    }

    .exhibition-label-wrapper {
      display: flex;
      align-items: center;
    }

    /* ラベル風のタイトルデザイン＆フォントサイズ拡大 */
    .exhibition-title {
      font-size: clamp(3.5rem, 9vw, 9rem);
      font-weight: 800;
      margin: 0;
      color: #060906;
      font-family: "Bebas Neue", cursive;
      line-height: 1.1;
      letter-spacing: 0.05em;
      display: inline-block;
    }

    /* サブタイトルは黒で統一 */
    .exhibition-subtitle {
      margin: 6px 0 0;
      font-size: 1.3rem;
      color: #111;
      font-weight: 700;
    }

    .exhibition-carousel-wrapper {
      position: relative;
      width: 100%;
      height: 300px;
      overflow: hidden;
      display: flex;
      align-items: center;
      background-color: #1e2229; /* フォールバックカラー */
      box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.4);
      opacity: 0;
    }

    .exhibition-track {
      display: flex;
      align-items: center;
      width: max-content;
      height: 92%;
      padding-left: 45px;
      position: relative;
      z-index: 1;
    }

    /* clip-pathを維持したまま影をつけるためのラッパー */
    :global(.exhibition-card-wrapper) {
      position: relative;
      width: 300px;
      height: 100%;
      flex-shrink: 0;
      margin-left: -45px;
      /* 重なっている部分にドロップシャドウを適用 */
      filter: drop-shadow(-5px 5px 10px rgba(0, 0, 0, 0.5));
      transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }

    /* ホバー時は少しだけ上に浮く仕様（画像は暗くならない） */
    :global(.exhibition-card-wrapper:hover) {
      transform: translateY(-4px);
      z-index: 5;
    }

    /* 実際のカード（切り抜き設定） */
    :global(.exhibition-card) {
      display: block;
      width: 100%;
      height: 100%;
      clip-path: polygon(20% 0%, 100% 0%, 80% 100%, 0% 100%);
      background-color: #222;
      overflow: hidden;
    }

    /* 画像本体（フィルターなしで通常の色を表示） */
    :global(.exhibition-card-img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .btn-exhibition-floating {
      position: absolute;
      right: 5%;
      bottom: 24px;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 16px 32px;

      background: rgba(117, 120, 122, 0.726);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.3);

      color: #fff;
      text-decoration: none;
      font-weight: 700;
      border-radius: 50px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      z-index: 10;
      transition:
        background 0.3s ease,
        transform 0.3s ease;
    }

    .btn-exhibition-floating:hover {
      background: rgba(33, 35, 37, 0.8);
      transform: translateY(-2px);
    }

    @media screen and (max-width: 768px) {
      .exhibition-section {
        padding: 40px 0;
      }
      .exhibition-title {
        font-size: 4rem;
      }
      .exhibition-subtitle {
        font-size: 1rem;
      }
      .exhibition-carousel-wrapper {
        height: 200px;
      }
      .exhibition-track {
        padding-left: 30px;
      }
      /* スマホ時のカード幅調整 */
      :global(.exhibition-card-wrapper) {
        width: 200px;
        margin-left: -30px;
      }
      .btn-exhibition-floating {
        right: 50%;
        transform: translateX(50%);
        bottom: 12px;
        padding: 12px 24px;
        font-size: 0.6rem;
        width: max-content;
        white-space: nowrap;
      }
      .btn-exhibition-floating:hover {
        transform: translateX(50%) translateY(-2px);
      }
    }

    /* ========================================
   SNS セクション
   ======================================== */
    .sns-section {
      padding: 80px 0;
      background-color: #ffffff;
      position: relative;
      z-index: 5;
      position: relative; /* 絶対配置の基準にするため追加 */
      overflow: hidden; /* 斜め画像がセクション外にはみ出すのを防ぐ */
      background-color: #ffffff; /* 既存の背景色 */
    }

    .sns-inner {
      max-width: 1500px;
      margin: 0 auto;
      padding: 0 1.5rem;
      z-index: 10;
    }

    .sns-header {
      margin-bottom: 40px;
    }

    .sns-label-wrapper {
      display: flex;
      align-items: center;
      justify-content: flex-start;
    }

    /* タイトルフォントをACCESSセクションと同一にする */
    .sns-title {
      font-size: clamp(3.5rem, 9vw, 9rem);
      font-weight: 800;
      margin: 0;
      padding: 0;
      color: #060906;
      font-family: "Bebas Neue", cursive;
      line-height: 1.1;
      letter-spacing: 0.05em;
      display: inline-block;
    }

    .sns-subtitle {
      margin: 6px 0 0;
      font-size: 1.3rem;
      color: #111;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    /* --- コンテンツレイアウト（3カラムグリッド） --- */
    .sns-content {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    /* --- SNSカード共通スタイル --- */
    .sns-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      text-decoration: none;
      color: #111;
      background-color: #f9fafb;
      border-radius: 24px;
      padding: 28px 24px;
    }

