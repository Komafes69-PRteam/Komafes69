---
import { Image } from 'astro:assets';
import heroImage from '../pages/assets/hero.webp';
import heroImageSp from '../pages/assets/hero-sp.webp';
import heroImageTb from '../pages/assets/hero-tb.webp';

import titleTextImg from '../pages/assets/title-text.png';
import komafesLabel from '../pages/assets/komafesLabel.png';
import topLogoImg from '../pages/assets/topLogo.png';
import mainLogoImg from '../pages/assets/Komafes69Logo.png';
import hatImg from '../pages/assets/hat.png';
import typoImg from '../pages/assets/typo.png';

import instagramIcon from '../pages/assets/Instagram.svg';
import youtubeIcon from '../pages/assets/youtube.svg';
import xIcon from '../pages/assets/X.svg';

import scrollIcon from '../pages/assets/scroll.png';

const pageTitle = "トップページ | Komafes69";
const pageDescription = "駒場東邦 第69代 文化祭「SAIL BEYOND」の公式サイトです。開催日時：9月19日(土)・20日(日) 9:00〜17:00。テーマや各展示、タイムテーブル、マップなどの最新情報を掲載しています。";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>

    <meta name="description" content={pageDescription} />

    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link 
      rel="preload" 
      as="style" 
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@500;700;900&display=swap" 
    />
    <link 
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@500;700;900&display=swap" 
      rel="stylesheet" 
      media="print" 
      onload="this.media='all'" 
    />
  </head>
  <body>
    <!-- ========================================
         スマホ用ハンバーガーボタン & メニュー
         ======================================== -->
    <button class="hamburger" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-menu">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <nav id="mobile-menu" class="mobile-nav">
      <ul>
        <li><a href="#top">TOP</a></li>
        <li><a href="#theme">THEME</a></li>
        <li><a href="/exhibition">EXHIBITION</a></li>
        <li><a href="#articles">ARTICLES</a></li>
        <li><a href="#timetable">TIME TABLE</a></li>
        <li><a href="#map">MAP</a></li>
        <li><a href="#archives">ARCHIVES</a></li>
      </ul>
      <div class="mobile-sns-links">
        <a href="https://www.instagram.com/komafes68/" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <Image src={instagramIcon} alt="" format="svg" quality={100} class="sns-icon" />
          <span>Instagram</span>
        </a>
        <a href="https://www.youtube.com/@komafes68" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
          <Image src={youtubeIcon} alt="" format="svg" quality={100} class="sns-icon" />
          <span>YouTube</span>
        </a>
        <a href="https://x.com/Komafes68" aria-label="X" target="_blank" rel="noopener noreferrer">
          <Image src={xIcon} alt="" format="svg" quality={100} class="sns-icon" />
          <span>X</span>
        </a>
      </div>
    </nav>

    <!-- ========================================
         PC・タブレット用 追従固定ヘッダー (Hero通過後出現)
         ======================================== -->
    <header class="sticky-header">
      <nav class="sticky-header-inner">
        <ul>
          <li><a href="#top">TOP</a></li>
          <li><a href="#theme">THEME</a></li>
          <li><a href="/exhibition">EXHIBITION</a></li>
          <li><a href="#articles">ARTICLES</a></li>
          <li><a href="#timetable">TIME TABLE</a></li>
          <li><a href="#map">MAP</a></li>
          <li><a href="#archives">ARCHIVES</a></li>
        </ul>
      </nav>
    </header>

    <!-- ========================================
         Hero セクション
         ======================================== -->
    <section class="hero">
      <Image 
        src={heroImage} 
        alt="トップページの背景画像です" 
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
        quality={90}
        format="webp"
        loading="eager"        
        fetchpriority="high"  
        class="hero-bg pc-bg"
      />

      <Image 
        src={heroImageSp} 
        alt="スマホ用トップページの背景画像" 
        widths={[320, 640, 768]}
        sizes="100vw"
        quality={90}
        format="webp"
        loading="eager"        
        fetchpriority="high"  
        class="hero-bg sp-bg"
      />

      <Image 
        src={heroImageTb} 
        alt="タブレット用トップページの背景画像" 
        widths={[768, 1024, 1280]}
        sizes="100vw"
        quality={90}
        format="webp"
        loading="eager"        
        fetchpriority="high"  
        class="hero-bg tb-bg"
      />

      <div class="top-logo">
        <Image src={topLogoImg} alt="Komafes69" format="webp" quality={80} class="top-logo-img" />
      </div>

      <div class="main-logo-container">
        <Image src={mainLogoImg} alt="Komafes 69 SAIL BEYOND" format="webp" quality={85} class="main-logo-img" />
        <div class="hat-container">
          <Image src={hatImg} alt="Komafes 帽子" format="webp" quality={85} class="hat-img" />
        </div>
      </div>

      <div class="typo-container">
        <Image src={typoImg} alt="SAIL BEYOND" format="webp" quality={85} class="typo-img" />
      </div>

      <div class="hero-title-container">
        <Image src={titleTextImg} alt="駒場東邦 第69代 文化祭" format="webp" quality={80} class="hero-title-img" />
      </div>

      <div class="komafesLabel">
        <Image src={komafesLabel} alt="Komafes69ラベル" format="webp" quality={80} class="komafes-label-img" />
      </div>

      <div class="date-info">
        <div class="date-row">
          <span class="num">9.19</span><span class="day">(SAT.)</span>
        </div>
        <div class="date-row separator">
          <span class="dash">—</span>
          <span class="num">9.20</span><span class="day">(SUN.)</span>
        </div>
        <div class="time-row">
          <span class="time">[ 9:00 - 17:00 ]</span>
        </div>
      </div>

      <div class="scroll-animation">
        <span class="scroll-text">SCROLL</span>
        <div class="scroll-line"></div>
        <Image src={scrollIcon} alt="Scroll Animation" format="webp" quality={100} class="scroll-icon" />
      </div>

      <!-- 右側ナビゲーションメニュー (PC Hero内用) -->
      <nav class="right-nav">
        <ul>
          <li><a href="#top">TOP</a></li>
          <li><a href="#theme">THEME</a></li>
          <li><a href="/exhibition">EXHIBITION</a></li>
          <li><a href="#articles">ARTICLES</a></li>
          <li><a href="#timetable">TIME TABLE</a></li>
          <li><a href="#map">MAP</a></li>
          <li><a href="#archives">ARCHIVES</a></li>
        </ul>

        <div class="sns-links">
          <a href="https://www.instagram.com/komafes68/" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
            <Image src={instagramIcon} alt="" format="svg" quality={100} class="sns-icon" />
            <span>Instagram</span>
          </a>
          <a href="https://www.youtube.com/@komafes68" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
            <Image src={youtubeIcon} alt="" format="svg" quality={100} class="sns-icon" />
            <span>YouTube</span>
          </a>
          <a href="https://x.com/Komafes68" aria-label="X" target="_blank" rel="noopener noreferrer">
            <Image src={xIcon} alt="" format="svg" quality={100} class="sns-icon" />
            <span>X</span>
          </a>
        </div>
      </nav>
    </section>

    <footer>
      <p>&copy; 2026 Komafes69</p>
    </footer>

    <!-- ========================================
         JavaScript 統合処理
         ======================================== -->
    <script>
      import { gsap } from 'gsap';

      const initApp = () => {
        // --- 1. GSAP アニメーション ---
        gsap.fromTo('.top-logo-img', { clipPath: 'inset(0 0 100% 0)', opacity: 1 }, { clipPath: 'inset(0 0 0% 0)', duration: 0.8, ease: 'power2.out', delay: 0.1 });
        gsap.fromTo('.main-logo-img', { scale: 0.85, rotation: -140, opacity: 0 }, { scale: 1, rotation: 0, opacity: 1, duration: 1.2, ease: 'back.out(1.2)', delay: 0.4 });
        gsap.fromTo('.hat-img', { xPercent: 120, yPercent: -90, rotation: 35, scale: 1.15, opacity: 0 }, { xPercent: 0, yPercent: 0, rotation: 0, scale: 1, opacity: 1, duration: 1.1, ease: 'power3.out', delay: 0.9, onComplete: startPeriodicAndInteractiveEffects });
        gsap.fromTo('.typo-img', { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9, ease: 'power2.out', delay: 0.8 });
        gsap.fromTo('.hero-title-img', { clipPath: 'inset(0 100% 0 0)', opacity: 1 }, { clipPath: 'inset(0 0% 0 0)', duration: 0.8, ease: 'power2.out', delay: 0.3 });
        gsap.fromTo('.komafes-label-img', { clipPath: 'inset(0 100% 0 0)', opacity: 1 }, { clipPath: 'inset(0 0% 0 0)', duration: 0.8, ease: 'power2.out', delay: 0.45 });
        gsap.fromTo('.date-info', { clipPath: 'inset(0 100% 0 0)', opacity: 1 }, { clipPath: 'inset(0 0% 0 0)', duration: 0.8, ease: 'power2.out', delay: 0.6 });
        gsap.fromTo('.right-nav', { x: 20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.8, ease: 'power2.out', delay: 0.5 });
        gsap.fromTo('.scroll-animation', { opacity: 0, y: 0 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out', delay: 1.0 });

        gsap.to('.scroll-line', {
          height: '40%',             
          duration: 2,
          ease: 'power1.inOut',
          repeat: -1,             
          yoyo: true              
        });

        function startPeriodicAndInteractiveEffects() {
          function playHatFlip() {
            return gsap.timeline()
              .to('.hat-img', { yPercent: -70, xPercent: 70, rotation: '+=30', scale: 1.3, duration: 0.55, ease: 'power2.out' })
              .to('.hat-img', { yPercent: 0, xPercent: 0, rotation: '+=330', scale: 1, duration: 0.95, ease: 'power2.inOut' });
          }

          const loopTimeline = gsap.timeline({ repeat: -1, repeatDelay: 3.0 });
          loopTimeline
            .to('.main-logo-img', { rotation: '+=360', duration: 1.5, ease: 'power2.inOut' }, 0)
            .add(playHatFlip(), 0);

          const logoContainer = document.querySelector('.main-logo-container');
          if (logoContainer) {
            logoContainer.addEventListener('mouseenter', () => {
              gsap.to('.main-logo-container', { scale: 1.05, duration: 0.3, ease: 'power2.out' });
            });
            logoContainer.addEventListener('mouseleave', () => {
              gsap.to('.main-logo-container', { scale: 1, duration: 0.3, ease: 'power2.inOut' });
            });
          }
        }

        // --- 2. スマホ用ハンバーガーメニュー制御 ---
        const hamburger = document.querySelector('.hamburger');
        const mobileNav = document.querySelector('.mobile-nav');
        const mobileLinks = document.querySelectorAll('.mobile-nav a');

        if (hamburger && mobileNav) {
          hamburger.addEventListener('click', () => {
            const isActive = hamburger.classList.contains('is-active');
            if (isActive) {
              hamburger.classList.remove('is-active');
              mobileNav.classList.remove('is-active');
              hamburger.setAttribute('aria-expanded', 'false');
              document.body.classList.remove('no-scroll');
            } else {
              hamburger.classList.add('is-active');
              mobileNav.classList.add('is-active');
              hamburger.setAttribute('aria-expanded', 'true');
              document.body.classList.add('no-scroll');
            }
          });

          mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
              hamburger.classList.remove('is-active');
              mobileNav.classList.remove('is-active');
              hamburger.setAttribute('aria-expanded', 'false');
              document.body.classList.remove('no-scroll');
            });
          });
        }

        // --- 3. スクロール連動処理（ヘッダーふわっと表示 & ハンバーガー色切り替え） ---
        const stickyHeader = document.querySelector('.sticky-header');
        const heroSection = document.querySelector('.hero');

        const handleScroll = () => {
          if (!heroSection) return;
          const heroBottom = heroSection.getBoundingClientRect().bottom;

          // Hero画像を完全に超えたら（heroBottom <= 80px 程度になったら）
          if (heroBottom <= 80) {
            // PC用ヘッダーを表示
            if (stickyHeader) stickyHeader.classList.add('is-show');
            // スマホハンバーガーを黒線に変更
            if (hamburger) hamburger.classList.add('is-black');
          } else {
            // PC用ヘッダーを非表示
            if (stickyHeader) stickyHeader.classList.remove('is-show');
            // スマホハンバーガーを白線に変更
            if (hamburger) hamburger.classList.remove('is-black');
          }
        };

        window.addEventListener('scroll', handleScroll);
        handleScroll(); // 初期チェック
      };

      // 確実に初期化処理を実行
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApp);
      } else {
        initApp();
      }
    </script>
  </body>
</html>

<style>
  body {
    font-family: 'Noto Sans JP', system-ui, -apple-system, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #000;
    overflow-x: hidden;
  }

  body.no-scroll {
    overflow: hidden;
  }

  /* ========================================
     PC・タブレット用 追従固定ヘッダー
     (グラスモーフィズムデザイン)
     ======================================== */
  .sticky-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 900;

    /* 控えめなグラスモーフィズム（写真イメージを反映） */
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);

    padding: 1.1rem 0;

    /* 初期状態：画面上に隠して透明にしておく */
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  /* Heroを超えた時に付与される表示用クラス */
  .sticky-header.is-show {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .sticky-header-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: flex-end; /* 写真と同じく右寄りに配置 */
    padding-right: 5%;
  }

  .sticky-header-inner ul {
    display: flex;
    gap: clamp(1.2rem, 2.5vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sticky-header-inner a {
    color: #111111;
    text-decoration: none;
    font-family: 'Bebas Neue', cursive;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    letter-spacing: 0.12em;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .sticky-header-inner a:hover {
    opacity: 0.6;
    transform: translateY(-1px);
  }

  /* ========================================
     スマホ用 ハンバーガー & モバイルナビ
     ======================================== */
  .hamburger, .mobile-nav {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .hamburger {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 32px;
      height: 24px;
      background: transparent;
      border: none;
      cursor: pointer;
      position: fixed; 
      top: 3.5%; 
      right: 6%;
      z-index: 1000; 
      padding: 0;
    }

    .hamburger-line {
      display: block;
      width: 100%;
      height: 2px;
      background-color: #ffffff; /* 初期色: 白 */
      border-radius: 2px;
      transition: background-color 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
      filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.5));
    }

    /* Hero通過後（白背景領域）で完全な「黒」にする */
    .hamburger.is-black .hamburger-line {
      background-color: #000000;
      filter: none;
    }

    /* メニューが開いている間は常に「白」 */
    .hamburger.is-active .hamburger-line {
      background-color: #ffffff !important;
      filter: none;
    }

    .hamburger.is-active .hamburger-line:nth-child(1) {
      transform: translateY(11px) rotate(45deg);
    }
    .hamburger.is-active .hamburger-line:nth-child(2) {
      opacity: 0;
    }
    .hamburger.is-active .hamburger-line:nth-child(3) {
      transform: translateY(-11px) rotate(-45deg);
    }

    /* オーバーレイナビゲーション */
    .mobile-nav {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      background-color: rgba(0, 0, 0, 0.92);
      z-index: 999;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .mobile-nav.is-active {
      opacity: 1;
      pointer-events: auto;
    }

    .mobile-nav ul {
      list-style: none;
      padding: 0;
      margin: 0;
      text-align: center;
    }

    .mobile-nav li {
      margin: 1.5rem 0;
    }

    .mobile-nav a {
      color: #f6f9f6;
      text-decoration: none;
      font-size: 1.8rem;
      font-family: 'Bebas Neue', cursive;
      letter-spacing: 0.15em;
    }

    .mobile-sns-links {
      display: flex;
      gap: 2rem;
      margin-top: 3rem;
      transform: translateX(-20px);
    }

    .mobile-sns-links a {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: #ffffff;
      text-decoration: none;
      font-size: 0.8rem;
      font-family: 'Noto Sans JP', sans-serif;
    }

    .mobile-sns-links .sns-icon {
      width: 28px;
      height: 28px;
      object-fit: contain;
    }

    /* スマホ表示時はPC用固定ヘッダーを隠す */
    .sticky-header {
      display: none !important;
    }
  }

  /* ========================================
     Hero & 各パーツレイアウト
     ======================================== */
  .hero {
    position: relative;
    width: 100%;
  }

  .hero-bg {
    width: 100%;
    height: auto;
    display: block;
  }

  .pc-bg { display: block; }
  .sp-bg { display: none; }
  .tb-bg { display: none; }

  .top-logo { position: absolute; top: 3.5%; left: 50%; transform: translateX(-50%); width: 8%; max-width: 140px; }
  .top-logo-img { width: 100%; height: auto; display: block; }

  .main-logo-container {
    position: absolute; top: 9%; left: 50%; transform: translateX(-50%); width: 27%; max-width: 520px;
    pointer-events: auto; cursor: pointer; will-change: transform;
  }
  .main-logo-img { width: 100%; height: auto; display: block; transform-origin: center center; }

  .hat-container { position: absolute; top: 10%; right: 6%; width: 45%; pointer-events: none; }
  .hat-img { width: 100%; height: auto; display: block; transform-origin: center center; will-change: transform, opacity; }

  .typo-container { position: absolute; top: 55%; left: 50%; transform: translateX(-50%); width: 35%; max-width: 560px; pointer-events: none; }
  .typo-img { width: 100%; height: auto; display: block; will-change: transform, opacity; }

  .hero-title-container { position: absolute; top: 5%; left: 4%; width: 15%; max-width: 450px; }
  .hero-title-img { width: 90%; height: auto; display: block; }

  .komafesLabel { position: absolute; top: 34%; left: 4%; width: 10%; max-width: 300px; }
  .komafes-label-img { width: 100%; height: auto; display: block; }

  .date-info { position: absolute; top: 41%; left: 4%; color: #f6f9f6; font-family: 'Noto Sans JP', sans-serif; font-weight: 700; line-height: 1.3; }
  .date-row { display: flex; align-items: baseline; font-size: clamp(1.1rem, 2.2vw, 2.2rem); }
  .date-row.separator { margin-left: 0.2em; margin-top: 0.35em; }
  .dash { display: inline-block; transform: scaleX(1.8); transform-origin: left center; margin-right: 0.8em; font-weight: 300; }
  .day { font-size: 0.75em; margin-left: 0.3em; opacity: 0.9; }
  .time-row { margin-top: 0.6em; font-size: clamp(0.85rem, 1.6vw, 1.5rem); letter-spacing: 0.05em; }

  .scroll-animation { position: absolute; top: 65%; left: 7%; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; height: 20%; gap: 8px; }
  .scroll-text { font-family: 'Bebas Neue', cursive; color: #f6f9f6; font-size: clamp(0.7rem, 0.9vw, 1.1rem); letter-spacing: 0.1em; }
  .scroll-line { width: 1px; height: 10%; background-color: #f6f9f6; will-change: height; }
  .scroll-icon { width: clamp(14px, 1.5vw, 20px); height: auto; display: block; object-fit: contain; }

  /* PC版ナビゲーション (Hero画像右側) */
  .right-nav { position: absolute; top: 18%; right: 3%; text-align: left; font-family: 'Bebas Neue', cursive; }
  .right-nav ul { list-style: none; margin: 0; padding: 0; }
  .right-nav li { margin-bottom: clamp(0.5rem, 2vw, 2.4rem); }
  .right-nav a { color: #f6f9f6; text-decoration: none; font-size: clamp(1rem, 1.2vw, 1.44rem); letter-spacing: 0.12em; transition: opacity 0.2s ease, transform 0.2s ease; display: inline-block; transform-origin: left center; }
