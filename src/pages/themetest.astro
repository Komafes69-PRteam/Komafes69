---
import { Image } from "astro:assets";
import mainLogoImg from "../pages/assets/Komafes69Logo.webp";

import instagramIcon from "../pages/assets/Instagram.svg";
import youtubeIcon from "../pages/assets/youtube.svg";
import xIcon from "../pages/assets/X.svg";

import logoImg from "../pages/assets/logo.svg";
import typoImg from "../pages/assets/typo.svg";

import vintageback from "../pages/assets/vintageback.webp";
import shipImg from "../pages/assets/ship.webp";

const pageTitle = "テーマ紹介 | 第69回 駒場東邦文化祭 | SAIL BEYOND";
const pageDescription =
  "2026 駒場東邦中学高等学校 第69回文化祭「SAIL BEYOND」の公式サイトです。開催日時：2026年 9月19日(土)・20日(日) 9:00〜16:30。今年の文化祭のテーマについて紹介します。";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>

    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="駒場東邦,駒場東邦文化祭,駒東,駒東文化祭,2026年,Komafes69,SAIL BEYOND"
    />

    <link rel="canonical" href="https://69.komafes.jp/" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://69.komafes.jp/" />
    <meta property="og:image" content="https://69.komafes.jp/ogp.png" />
    <meta property="og:image:width" content="3406" />
    <meta property="og:image:height" content="1884" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href={mainLogoImg.src} />

    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Noto+Sans+JP:wght@500;700;900&family=Pinyon+Script&family=Shippori+Mincho:wght@600;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Noto+Sans+JP:wght@500;700;900&family=Pinyon+Script&family=Shippori+Mincho:wght@600;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Shippori+Mincho:wght@600;800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/icon.ico" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Sail Beyond" />
  </head>

  <body id="top">
    <!-- ローディング画面 -->
    <div id="loading-screen">
      <div class="loader-logo-container">
        <img src={mainLogoImg.src} alt="Loading..." class="loader-logo-img" />
        <p class="loader-text">Loading...</p>
      </div>
    </div>

    <!-- スマホ用 メニュー -->
    <nav id="mobile-menu" class="mobile-nav">
      <ul>
        <li><a href="/">TOP</a></li>
        <li><a href="/theme">THEME</a></li>
        <li><a href="/exhibition">EXHIBITION</a></li>
        <li><a href="/articles">ARTICLES</a></li>
        <li><a href="/timetable">TIME TABLE</a></li>
        <li><a href="/map">MAP</a></li>
        <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
      </ul>
      <div class="mobile-sns-links">
        <a
          href="https://www.instagram.com/komafes69/"
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={instagramIcon.src} alt="" class="sns-icon" />
          <span>Instagram</span>
        </a>
        <a
          href="https://www.youtube.com/@komafes69"
          aria-label="YouTube"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={youtubeIcon.src} alt="" class="sns-icon" />
          <span>YouTube</span>
        </a>
        <a
          href="https://x.com/Komafes69"
          aria-label="X"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={xIcon.src} alt="" class="sns-icon" />
          <span>X</span>
        </a>
      </div>
    </nav>

    <!-- ヘッダー -->
    <header class="sticky-header">
      <div class="sticky-header-inner">
        <a href="/" class="header-brand">
          <img src={logoImg.src} alt="Komafes69 Logo" class="header-logo" />
          <img src={typoImg.src} alt="SAIL BEYOND" class="header-typo" />
        </a>

        <div class="header-right">
          <nav class="header-nav">
            <ul>
              <li><a href="/">TOP</a></li>
              <li><a href="/theme">THEME</a></li>
              <li><a href="/exhibition">EXHIBITION</a></li>
              <li><a href="/articles">ARTICLES</a></li>
              <li><a href="/timetable">TIME TABLE</a></li>
              <li><a href="/map">MAP</a></li>
              <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
            </ul>
          </nav>

          <button
            class="hamburger"
            aria-label="メニューを開く"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </button>
        </div>
      </div>
    </header>

    <div class="theme-wrapper">
      <img src={vintageback.src} alt="背景画像" class="theme-bg" />

      <div class="theme-layout">
        <!-- 左側：船（スクロール時画面固定） -->
        <div class="theme-left">
          <div class="ship-container">
            <img src={shipImg.src} alt="オリゾンテ号" class="ship-img" />
          </div>
        </div>

        <!-- 右側：テキストエリア -->
        <div class="theme-right">
          <div class="theme-header js-fade-chunk">
            <h2 class="theme-title">THEME</h2>
            <div class="theme-subtitle">SHIP ORIZZONTE</div>
          </div>

          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="古い航海記録には、時折こんな記述が残されている。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="「地平線の彼方から現れ、次の瞬間、再び地平線の向こうへと消えていく船」"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p class="typewriter-text" data-text="その船の名は、オリゾンテ号。">
            </p>
            <p class="typewriter-text" data-text="いつ、どこで造られたのか。">
            </p>
            <p class="typewriter-text" data-text="誰が最初の船長だったのか。">
            </p>
            <p
              class="typewriter-text"
              data-text="今となっては、それを知る者はいない。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="ただ、この港がまだ小さな寄港地だった頃から、幾度となくこの地に姿を現していたという。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="やがて、その姿を追う船たちが現れた。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="しかし、航海は決して穏やかなものではなかった。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="激しい嵐や深い霧の中で、多くの船がその航跡を見失っていった。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="それでも、水平線の向こうにあるまだ見ぬ世界を信じ、夢と希望を見失わなかった船たちは、オリゾンテ号を追い続けた。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="そして彼らが辿り着いたのが、この港だった。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="夢と希望を帆に受けて、水平線を越え、その先へ。"
            >
            </p>
            <br />
            <p class="typewriter-text fw-bold" data-text="Sail Beyond."></p>
          </div>
        </div>
      </div>
    </div>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // ==========================================
      // 1. ローディング画面の処理
      // ==========================================
      const wheelRotation = gsap.to(".loader-logo-img", {
        rotation: "+=360",
        duration: 2,
        repeat: -1,
        ease: "power1.inOut",
      });
      const MIN_LOADING_TIME = 1000;
      const minWaitPromise = new Promise<void>((resolve) =>
        setTimeout(resolve, MIN_LOADING_TIME),
      );
      const pageLoadPromise = new Promise<void>((resolve) => {
        if (document.readyState === "complete") resolve();
        else window.addEventListener("load", () => resolve(), { once: true });
      });

      Promise.all([minWaitPromise, pageLoadPromise]).then(() => {
        const tl = gsap.timeline();
        tl.to("#loading-screen", {
          opacity: 0,
          duration: 0.6,
          ease: "power2.out",
          onComplete: () => {
            const loader = document.getElementById("loading-screen");
            if (loader) loader.style.display = "none";
            wheelRotation.kill();
            initThemeAnimation();
          },
        });
      });

      // ==========================================
      // 2. ヘッダー関連の処理
      // ==========================================
      const initHeader = () => {
        const hamburger = document.querySelector(".hamburger");
        const mobileNav = document.querySelector(".mobile-nav");
        const stickyHeader = document.querySelector(".sticky-header");

        if (hamburger && mobileNav) {
          hamburger.addEventListener("click", () => {
            const isActive = hamburger.classList.toggle("is-active");
            mobileNav.classList.toggle("is-active", isActive);
            document.body.classList.toggle("no-scroll", isActive);
            hamburger.setAttribute(
              "aria-expanded",
              isActive ? "true" : "false",
            );
          });
        }

        const handleScroll = () => {
          if (window.scrollY > 100) {
            stickyHeader?.classList.add("is-show");
            hamburger?.classList.add("is-black");
          } else {
            stickyHeader?.classList.remove("is-show");
            hamburger?.classList.remove("is-black");
          }
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
        handleScroll();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHeader);
      } else {
        initHeader();
      }

      // ==========================================
      // 3. Themeページのスクロール ＆ 各種アニメーション
      // ==========================================
      const initThemeAnimation = () => {
        // --- A. 左側：船の画像出現アニメーション ---
        gsap.to(".ship-img", {
          scrollTrigger: {
            trigger: ".theme-left",
            start: "top 80%",
            toggleActions: "play none none reverse",
          },
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          opacity: 1,
          scale: 1,
          duration: 1.8,
          ease: "power2.out",
        });

        // --- B. 右側：ヘッダー見出しのフェードイン ---
        const fadeChunks = gsap.utils.toArray(".js-fade-chunk");
        fadeChunks.forEach((chunk: any) => {
          gsap.to(chunk, {
            scrollTrigger: {
              trigger: chunk,
              start: "top 85%",
            },
            opacity: 1,
            y: 0,
            duration: 1.2,
            ease: "power2.out",
          });
        });

        // --- C. 右側：タイプライター演出 ---
        const typeText = (element: HTMLElement) => {
          if (element.classList.contains("typed")) return;

          element.classList.add("typed");
          element.classList.add("cursor");

          const fullText = element.getAttribute("data-text") || "";
          let currentIndex = 0;
          element.textContent = "";

          const interval = setInterval(() => {
            if (currentIndex < fullText.length) {
              element.textContent += fullText[currentIndex];
              currentIndex++;
            } else {
              clearInterval(interval);
              element.classList.remove("cursor");
            }
          }, 40);
        };

        const typeChunks = gsap.utils.toArray(".typewriter-text");
        typeChunks.forEach((chunk: any) => {
          ScrollTrigger.create({
            trigger: chunk,
            start: "top 85%",
            onEnter: () => typeText(chunk as HTMLElement),
          });
        });
      };
    </script>

    <style>
      body {
        font-family:
          "Noto Sans JP",
          system-ui,
          -apple-system,
          sans-serif;
        margin: 0;
        padding: 0;
        background-color: #000;
      }

      body.no-scroll {
        overflow: hidden;
      }

      /* ローディング画面 */
      #loading-screen {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #101011;
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .loader-logo-container {
        width: 140px;
        height: 140px;
        max-width: 50vw;
        max-height: 50vw;
      }

      .loader-logo-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .loader-text {
        color: #fff;
        font-family: "Bebas Neue", cursive;
        font-size: 1.4rem;
        margin-top: 1rem;
        text-align: center;
      }

      /* スティッキーヘッダー */
      .sticky-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        padding: 0.8rem 0;
        opacity: 0;
        pointer-events: none;
        transition:
          opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1),
          background-color 0.3s ease;
      }

      .sticky-header.is-show {
        opacity: 1;
        pointer-events: auto;
      }

      .sticky-header,
      .sticky-header-inner {
        box-sizing: border-box;
      }

      .sticky-header-inner {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 1.5rem;
      }

      .header-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        transition: opacity 0.2s ease;
      }

      .header-brand:hover {
        opacity: 0.7;
      }

      .header-logo {
        height: 40px;
        width: auto;
        object-fit: contain;
        filter: brightness(0);
      }

      .header-typo {
        height: 20px;
        width: auto;
        object-fit: contain;
        filter: brightness(0);
      }

      .header-nav ul {
        display: flex;
        gap: clamp(1rem, 2vw, 2.5rem);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .header-nav a {
        color: #111111;
        text-decoration: none;
        font-family: "Bebas Neue", cursive;
        font-size: clamp(0.95rem, 1.2vw, 1.15rem);
        letter-spacing: 0.12em;
        transition:
          opacity 0.2s ease,
          transform 0.2s ease;
      }

      .header-nav a:hover {
        opacity: 0.6;
        transform: translateY(-1px);
      }

      .header-right {
        display: flex;
        align-items: center;
      }

      .hamburger,
      .mobile-nav {
        display: none;
      }

      .header-nav {
        display: block;
      }

      @media screen and (max-width: 768px) {
        .mobile-nav {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100vh;
          height: 100dvh;
          background-color: rgba(0, 0, 0, 0.92);
          z-index: 999;
          opacity: 0;
          pointer-events: none;
          transition: opacity 0.3s ease;
        }

        .mobile-nav.is-active {
          opacity: 1;
          pointer-events: auto;
        }

        .mobile-nav ul {
          list-style: none;
          padding: 0;
          margin: 0;
          text-align: center;
        }

        .mobile-nav li {
          margin: 1.5rem 0;
        }

        .mobile-nav a {
          color: #f6f9f6;
          text-decoration: none;
          font-size: 1.8rem;
          font-family: "Bebas Neue", cursive;
          letter-spacing: 0.15em;
        }

        .mobile-sns-links {
          display: flex;
          gap: 2rem;
          margin-top: 3rem;
          transform: translateX(-20px);
        }

        .mobile-sns-links a {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 0.5rem;
          color: #ffffff;
          text-decoration: none;
          font-size: 0.8rem;
          font-family: "Noto Sans JP", sans-serif;
        }

        .mobile-sns-links .sns-icon {
          width: 28px;
          height: 28px;
          object-fit: contain;
        }

        .sticky-header {
          display: block !important;
          opacity: 1;
          pointer-events: auto;
          background: transparent;
          backdrop-filter: none;
          -webkit-backdrop-filter: none;
          border-bottom: none;
          box-shadow: none;
        }

        .sticky-header.is-show {
          background: rgba(255, 255, 255, 0.9);
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          border-bottom: 1px solid rgba(0, 0, 0, 0.05);
          box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        }

        .header-logo {
          height: 24px;
        }

        .header-typo {
          height: 12px;
        }

        .header-brand {
          gap: 8px;
          opacity: 0;
          visibility: hidden;
          transition:
            opacity 0.3s ease,
            visibility 0.3s ease;
        }

        .sticky-header.is-show .header-brand {
          opacity: 1;
          visibility: visible;
        }

        .mobile-nav.is-active ~ .sticky-header .header-brand,
        body:has(.hamburger.is-active) .header-brand {
          opacity: 1;
          visibility: visible;
        }

        .header-logo,
        .header-typo {
          filter: brightness(0) invert(1);
          transition: filter 0.3s ease;
        }

        .sticky-header.is-show .header-logo,
        .sticky-header.is-show .header-typo {
          filter: brightness(0);
        }

        .mobile-nav.is-active ~ .sticky-header .header-logo,
        .mobile-nav.is-active ~ .sticky-header .header-typo,
        body:has(.hamburger.is-active) .header-logo,
        body:has(.hamburger.is-active) .header-typo {
          filter: brightness(0) invert(1) !important;
        }

        .header-nav {
          display: none;
        }

        .hamburger {
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          width: 28px;
          height: 20px;
          background: transparent;
          border: none;
          cursor: pointer;
          padding: 0;
          position: relative;
          top: auto;
          right: auto;
          z-index: 1000;
        }

        .hamburger-line {
          display: block;
          width: 100%;
          height: 2px;
          background-color: #ffffff;
          border-radius: 2px;
          transition:
            background-color 0.3s ease,
            transform 0.3s ease,
            opacity 0.3s ease;
          filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.5));
        }

        .hamburger.is-black .hamburger-line {
          background-color: #000000;
          filter: none;
        }

        .hamburger.is-active .hamburger-line {
          background-color: #ffffff !important;
          filter: none;
        }

        .hamburger.is-active .hamburger-line:nth-child(1) {
          transform: translateY(9px) rotate(45deg);
        }
        .hamburger.is-active .hamburger-line:nth-child(2) {
          opacity: 0;
        }
        .hamburger.is-active .hamburger-line:nth-child(3) {
          transform: translateY(-9px) rotate(-45deg);
        }

        .sticky-header:has(.hamburger.is-active) {
          background: transparent !important;
          backdrop-filter: none !important;
          -webkit-backdrop-filter: none !important;
          border-bottom: none !important;
          box-shadow: none !important;
        }
      }

      /* テーマページ構造 */
      .theme-wrapper {
        position: relative;
        width: 100%;
        min-height: 100vh;
        color: #3e3124;
        font-family: "Shippori Mincho", serif;
      }

      .theme-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        object-fit: cover;
        z-index: -1;
        background-color: #f4ebd4;
        pointer-events: none;
      }

      .theme-layout {
        display: flex;
        max-width: 1200px;
        margin: 0 auto;
        padding: 120px 2rem 4rem;
        gap: 4rem;
        align-items: flex-start;
      }

      /* 左側：スクロール追従エリア */
      .theme-left {
        position: sticky;
        top: 100px; /* 画面上部からどの位置で止めるか指定（ヘッダーの高さを考慮） */
        height: calc(100vh - 100px); /* 画面の高さいっぱいに広げる */
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .ship-container {
        position: relative;
        width: 100%;
        max-width: 600px;
      }

      /* 船画像：初期状態は非表示（clip-pathで対角線上から展開） */
      .ship-img {
        width: 100%;
        height: auto;
        display: block;
        opacity: 0;
        transform: scale(0.95);
        clip-path: polygon(0% 100%, 0% 100%, 0% 100%, 0% 100%);
        will-change: clip-path, opacity, transform;
      }

      /* 右側：スクロールテキストエリア */
      .theme-right {
        flex: 1.2;
        padding-bottom: 20vh;
      }

      .theme-header {
        margin-bottom: 4rem;
        border-bottom: 2px solid #8b7355;
        padding-bottom: 1rem;
        opacity: 0;
        transform: translateY(30px);
      }

      .theme-title {
        font-family: "Cinzel", serif;
        font-size: 3.5rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: 0.1em;
      }

      .theme-subtitle {
        font-family: "Cinzel", serif;
        font-size: 1.5rem;
        color: #8b7355;
        margin-top: 0.5rem;
      }

      .text-chunk {
        font-size: 1.2rem;
        line-height: 2.2;
        letter-spacing: 0.08em;
        font-weight: 600;
        margin-bottom: 3.5rem;
      }

      /* タイプライター用のテキスト調整 */
      .typewriter-text {
        margin: 0 0 0.5rem 0;
        min-height: 1.8em;
      }

      .typewriter-text.fw-bold {
        font-weight: bold;
        font-size: 1.2em;
      }

      /* 点滅カーソル */
      .cursor::after {
        content: "|";
        display: inline-block;
        animation: blink 0.8s infinite;
        color: #8b7355;
      }

      @keyframes blink {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0;
        }
      }

      @media screen and (max-width: 768px) {
        .theme-layout {
          flex-direction: column;
          padding-top: 100px;
          gap: 2rem;
        }
        .theme-left {
          position: sticky;
          top: 0;
          height: auto;
        }
        .theme-title {
          font-size: 2.5rem;
        }
        .text-chunk {
          font-size: 1rem;
          margin-bottom: 2.5rem;
        }
      }
    </style>
  </body>
</html>
