  /* ========================================
     マーキー装飾 (Heroの下)
     ======================================== */
  .marquee-container {
    width: 100%;
    overflow: hidden;
    position: relative;
    z-index: 10;
    pointer-events: none; /* 重なった部分のクリックを妨げないようにする */
  }

  .marquee-track {
    display: flex;
    width: max-content;
    /* 60秒かけてループします。速度を変えたい場合は秒数を調整してください */
    animation: marquee-anim 60s linear infinite;
  }

  .marquee-text {
    font-family: "Bebas Neue", cursive;
    font-size: clamp(4rem, 6vw, 14rem);
    color: transparent; /* 文字の塗りを透明に */
    -webkit-text-stroke: 0.01em #ffffff; /* アウトライン（縁取り）を設定 */
    letter-spacing: 0.01em;
    line-height: 1;
    /* 2つのspanタグの間の隙間をなくすために少し調整 */
    padding-right: 20px;
    margin-top: -0.03em;
    margin-bottom: -0.09em;
  }

  /* ダークモードや黒背景に被る際に、アウトラインを白にしたい場合は色を #fff に変更してください */

  @keyframes marquee-anim {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 768px) {
    .marquee-text {
      -webkit-text-stroke: 0.5px #ffffff; /* スマホ時は線を少し細く */
    }
  }
  /* ========================================
     ACCESS セクション (位置ズレ＆デザイン修正版)
     ======================================== */
  .access-section {
    padding: 80px 0;
    background-color: #ffffff;
    position: relative;
    z-index: 5;
  }

  .access-inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .access-header {
    margin-bottom: 40px;
  }

  .access-label-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /* タイトルのフォントサイズもEXHIBITIONSに合わせる */
  .access-title {
    font-size: clamp(3.5rem, 9vw, 9rem);
    font-weight: 800;
    margin: 0;
    padding: 0;
    color: #060906;
    font-family: "Bebas Neue", cursive;
    line-height: 1.1;
    letter-spacing: 0.05em;
    display: inline-block;
  }

  .access-subtitle {
    margin: 6px 0 0;
    font-size: 1.3rem;
    color: #111;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* コンテンツのレイアウト */
  .access-content {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    align-items: stretch;
  }

  /* --- 左側：情報エリア --- */
  .access-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* ▼ お気に入りの縦棒をここ全体に適用し、キレイに揃える */
    border-left: 3px solid #222;
    padding-left: 24px;
  }

  .access-address-box {
    margin-bottom: 40px;
  }

  .access-school-name {
    font-size: 1.4rem;
    font-weight: 900;
    margin: 0 0 8px 0;
    letter-spacing: 0.05em;
    color: #111;
  }

  .access-address-text {
    font-size: 1rem;
    color: #444;
    margin: 0;
  }

  /* ルート（電車）リスト：AIっぽい枠を廃止し「地べた」に貼り付け */
  .route-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 40px;
  }

  .route-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    /* 背景色・枠線・影をすべて削除 */
    background: transparent;
    padding: 0;
    border: none;
    box-shadow: none;
  }

  .route-icon-wrapper {
    background-color: transparent;
    color: #1e2229;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .train-icon {
    width: 100%;
    height: 100%;
  }

  .route-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .line-name {
    font-size: 0.85rem;
    color: #666;
    font-weight: 700;
  }

  .station-name {
    font-size: 1.1rem;
    font-weight: 900;
    color: #111;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  /* 徒歩時間の枠も廃止し、シンプルなテキストに */
  .walk-time {
    font-size: 0.9rem;
    color: #555;
    font-weight: 700;
    background: transparent;
    padding: 0;
  }

  /* 注意書き */
  .access-notice {
    padding-left: 0;
    border-left: none; /* 親要素で線を引いたのでここは削除 */
  }

  .access-notice p {
    font-size: 0.85rem;
    color: #666;
    margin: 0 0 6px 0;
    line-height: 1.5;
  }

  /* --- 右側：Googleマップ --- */
  .access-map-wrapper {
    flex: 1;
    width: 100%;
    max-width: 600px;
    min-height: 400px;
    position: relative;
    border-radius: 10px; 
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .access-map-mobile {
    display: none;
  }

  .access-map-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    transition: filter 0.3s ease;
  }

  .map-overlay-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    box-shadow: outset 0 0 40px rgba(0, 20, 40, 0.2);
  }

  @media screen and (max-width: 768px) {
    .access-section {
      padding: 60px 0;
    }
    .access-header {
      margin-bottom: 24px;
    }
    .access-title {
      font-size: 3.5rem;
    }
    .access-subtitle {
      font-size: 1rem;
    }
    .access-content {
      flex-direction: column;
      gap: 40px;
      margin-top: 24px;
    }
    .access-map-wrapper {
      max-width: 100%;
      height: 350px;
      min-height: auto;
    }

    .access-content > .access-map-wrapper:not(.access-map-mobile) {
      display: none;
    }

    .access-map-mobile {
      display: block !important;
      flex: none;
      width: 100%;
      height: 350px;
      min-height: 350px;
      margin: 32px 0;
    }
  }

  /* ========================================
     船長の公開日誌 / COUNTDOWN
     ======================================== */
  .captains-log-section {
    position: relative;
    overflow: hidden;
    padding: 88px 1.5rem;
    color: #e9e0bf;
    background:
      radial-gradient(ellipse at 88% 10%, rgba(55, 98, 112, 0.46), transparent 36%),
      radial-gradient(ellipse at 8% 95%, rgba(112, 76, 37, 0.4), transparent 34%),
      #092631;
  }

  .captains-log-section::before {
    position: absolute;
    inset: 16px;
    border: 1px solid rgba(225, 205, 149, 0.36);
    content: "";
    pointer-events: none;
  }

  .captains-log-section::after {
    position: absolute;
    top: -130px;
    right: -80px;
    width: 330px;
    height: 330px;
    border: 1px dashed rgba(226, 207, 154, 0.45);
    border-radius: 50%;
    content: "";
  }

  .captains-log-inner {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem);
    border-left: 3px solid #d6b66d;
    background: rgba(1, 22, 30, 0.42);
    box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.28);
  }

  .log-heading { text-align: center; }
  .log-kicker, .log-date, .countdown-status {
    margin: 0;
    color: #d4bb7e;
    font-family: "Bebas Neue", cursive;
    letter-spacing: 0.2em;
  }
  .log-kicker { font-size: 1rem; }
  .log-heading h2 {
    margin: 0.45rem 0;
    color: #fbf2d1;
    font-family: "Noto Sans JP", sans-serif;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    letter-spacing: 0.12em;
  }
  .log-date { font-size: 0.78rem; }

  .log-details {
    max-width: 760px;
    margin: 2.5rem auto;
    padding: 1.3rem 0;
    border-top: 1px solid rgba(225, 205, 149, 0.42);
    border-bottom: 1px solid rgba(225, 205, 149, 0.42);
  }
  .log-details dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin: 0; }
  .log-details div { min-width: 0; }
  .log-details dt { margin-bottom: 0.45rem; color: #d4bb7e; font-family: "Bebas Neue", cursive; font-size: 0.9rem; letter-spacing: 0.15em; }
  .log-details dd { margin: 0; color: #f4edcf; font-size: 0.82rem; font-weight: 700; line-height: 1.7; }

  .countdown {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(0.35rem, 1.3vw, 1rem);
  }
  .countdown-unit { display: grid; min-width: clamp(58px, 10vw, 108px); text-align: center; }
  .countdown-unit > span {
    color: #fff4ce;
    font-family: "Bebas Neue", cursive;
    font-size: clamp(3.3rem, 8vw, 6.2rem);
    line-height: 0.85;
    letter-spacing: 0.02em;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.36);
  }
  .countdown-unit small { margin-top: 0.8rem; color: #d4bb7e; font-family: "Bebas Neue", cursive; font-size: 0.7rem; letter-spacing: 0.16em; }
  .countdown-separator { padding-top: 0.02em; color: #d4bb7e; font-family: "Bebas Neue", cursive; font-size: clamp(2.4rem, 5vw, 4.3rem); line-height: 0.8; }
  .countdown-status { margin-top: 1.6rem; text-align: center; font-size: 0.85rem; }

  @media screen and (max-width: 768px) {
    .captains-log-section { padding: 58px 1rem; }
    .captains-log-section::before { inset: 9px; }
    .captains-log-inner { padding: 2.2rem 1.1rem; }
    .log-details { margin: 1.8rem 0; }
    .log-details dl { grid-template-columns: 1fr; gap: 1rem; }
    .log-details div { display: grid; grid-template-columns: 105px 1fr; gap: 0.5rem; }
    .log-details dt { margin: 0; }
    .countdown { gap: 0.2rem; }
    .countdown-unit { min-width: 0; flex: 1; }
    .countdown-unit > span { font-size: clamp(2.5rem, 13vw, 3.4rem); }
    .countdown-unit small { font-size: 0.53rem; letter-spacing: 0.08em; }
    .countdown-separator { font-size: 2.3rem; }
  }

  /* ========================================
     EXHIBITION セクション (アップデート内容)
     ======================================== */
  .exhibition-section {
    padding: 40px 0;
    background-color: #ffffff;
    position: relative;
  }

  .exhibition-header {
    max-width: 1500px;
    margin: 0 auto 30px;
    padding: 0 1.5rem;
  }

  .exhibition-label-wrapper {
    display: flex;
    align-items: center;
  }

  /* ラベル風のタイトルデザイン＆フォントサイズ拡大 */
  .exhibition-title {
    font-size: clamp(3.5rem, 9vw, 9rem);
    font-weight: 800;
    margin: 0;
    color: #060906;
    font-family: "Bebas Neue", cursive;
    line-height: 1.1;
    letter-spacing: 0.05em;
    display: inline-block;
  }

  /* サブタイトルは黒で統一 */
  .exhibition-subtitle {
    margin: 6px 0 0;
    font-size: 1.3rem;
    color: #111;
    font-weight: 700;
  }

  .exhibition-carousel-wrapper {
    position: relative;
    width: 100%;
    height: 300px;
    overflow: hidden;
    display: flex;
    align-items: center;
    background-color: #1e2229; /* フォールバックカラー */
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.4);
    opacity: 0;
  }

  .exhibition-track {
    display: flex;
    align-items: center;
    width: max-content;
    height: 92%;
    padding-left: 45px;
    position: relative;
    z-index: 1;
  }

  /* clip-pathを維持したまま影をつけるためのラッパー */
  :global(.exhibition-card-wrapper) {
    position: relative;
    width: 300px;
    height: 100%;
    flex-shrink: 0;
    margin-left: -45px;
    /* 重なっている部分にドロップシャドウを適用 */
    filter: drop-shadow(-5px 5px 10px rgba(0, 0, 0, 0.5));
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* ホバー時は少しだけ上に浮く仕様（画像は暗くならない） */
  :global(.exhibition-card-wrapper:hover) {
    transform: translateY(-4px);
    z-index: 5;
  }

  /* 実際のカード（切り抜き設定） */
  :global(.exhibition-card) {
    display: block;
    width: 100%;
    height: 100%;
    clip-path: polygon(20% 0%, 100% 0%, 80% 100%, 0% 100%);
    background-color: #222;
    overflow: hidden;
  }

  /* 画像本体（フィルターなしで通常の色を表示） */
  :global(.exhibition-card-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .btn-exhibition-floating {
    position: absolute;
    right: 5%;
    bottom: 24px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;

    background: rgba(117, 120, 122, 0.726);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);

    color: #fff;
    text-decoration: none;
    font-weight: 700;
    border-radius: 50px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    z-index: 10;
    transition:
      background 0.3s ease,
      transform 0.3s ease;
  }

  .btn-exhibition-floating:hover {
    background: rgba(33, 35, 37, 0.8);
    transform: translateY(-2px);
  }

  @media screen and (max-width: 768px) {
    .exhibition-section {
      padding: 40px 0;
    }
    .exhibition-title {
      font-size: 4rem;
    }
    .exhibition-subtitle {
      font-size: 1rem;
    }
    .exhibition-carousel-wrapper {
      height: 200px;
    }
    .exhibition-track {
      padding-left: 30px;
    }
    /* スマホ時のカード幅調整 */
    :global(.exhibition-card-wrapper) {
      width: 200px;
      margin-left: -30px;
    }
    .btn-exhibition-floating {
      right: 50%;
      transform: translateX(50%);
      bottom: 12px;
      padding: 12px 24px;
      font-size: 0.6rem;
      width: max-content;
      white-space: nowrap;
    }
    .btn-exhibition-floating:hover {
      transform: translateX(50%) translateY(-2px);
    }
  }

  /* ========================================
     SNS / 航海図セクション
     ======================================== */
  .social-section {
    position: relative;
    overflow: hidden;
    padding: 100px 1.5rem;
    color: #20180e;
    background:
      radial-gradient(circle at 15% 18%, rgba(255, 255, 255, 0.5), transparent 26%),
      radial-gradient(circle at 90% 82%, rgba(92, 61, 27, 0.18), transparent 30%),
      #d7c18e;
  }

  .social-section::before,
  .social-section::after {
    position: absolute;
    width: 220px;
    height: 220px;
    border: 1px solid rgba(66, 43, 18, 0.32);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

