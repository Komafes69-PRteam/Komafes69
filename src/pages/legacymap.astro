---
import { Image } from "astro:assets";

// 背景画像やロゴ類
import titleBg from "../pages/assets/TitleBackground.webp";
import titleBackgroundBlack from "../pages/assets/TitleBackgroundBlack.jpg";

import youtubeIcon from "./assets/youtube.svg";
import xIcon from "./assets/X.svg";
import logoImg from "./assets/logo.svg";
import typoImg from "./assets/typo.svg";
import instagramIcon from "./assets/Instagram.svg";

const {
  title = "MAPS | 第69回 駒場東邦文化祭 | SAIL BEYOND",
  description = "駒場東邦中学校・高等学校 第69回 文化祭公式ウェブサイトです。便利なオンラインマップを提供しています。",
  pageTitleEn = "MAP",
  pageTitleJa = "マップ",
} = Astro.props;


import map1f from "./assets/map1f.png";
import map2f from "./assets/map2f.png";
import map3f from "./assets/map3f.png";
import map4f from "./assets/map4f.png";
import map5f from "./assets/map5f.png";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- ファビコン設定 -->
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/icon.ico" />

    <!-- iOS / WebManifest 用 -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Sail Beyond" />
  </head>
  <body>
    <!-- スマホ用ハンバーガーボタン -->
    <button class="hamburger" aria-label="メニューを開く" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <!-- スマホ用スライドメニュー -->
    <nav class="mobile-nav">
      <ul>
        <li><a href="/">TOP</a></li>
        <li><a href="/theme">THEME</a></li>
        <li><a href="/exhibition">EXHIBITION</a></li>
        <li><a href="/favorites">FAVORITES</a></li>
        <li><a href="/articles">ARTICLES</a></li>
        <li><a href="/timetable">TIME TABLE</a></li>
        <li><a href="/map">MAP</a></li>
        <li>
          <a
            href="https://archives.komafes.jp/"
            target="_blank"
            rel="noopener noreferrer"
          >
            ARCHIVES
          </a>
        </li>
      </ul>
      <div class="mobile-sns-links">
        <a
          href="https://www.instagram.com/komafes69/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Image src={instagramIcon} alt="Instagram" class="sns-icon" />
          <span>Instagram</span>
        </a>
        <a
          href="https://www.youtube.com/@komafes69"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Image src={youtubeIcon} alt="YouTube" class="sns-icon" />
          <span>YouTube</span>
        </a>
        <a
          href="https://x.com/Komafes69"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Image src={xIcon} alt="X" class="sns-icon" />
          <span>X</span>
        </a>
      </div>
    </nav>

    <!-- デスクトップ用常時固定ヘッダー -->
    <header class="sticky-header">
      <div class="sticky-header-inner">
        <a href="/" class="header-brand">
          <img src={logoImg.src} alt="Logo" class="header-logo" />
          <img src={typoImg.src} alt="SAIL BEYOND" class="header-typo" />
        </a>

        <div class="header-right-actions">
          <nav class="header-nav">
            <ul>
              <li><a href="/">TOP</a></li>
              <li><a href="/theme">THEME</a></li>
              <li><a href="/exhibition">EXHIBITION</a></li>
              <li><a href="/favorites">FAVORITES</a></li>
              <li><a href="/articles">ARTICLES</a></li>
              <li><a href="/timetable">TIME TABLE</a></li>
              <li><a href="/map">MAP</a></li>
              <li>
                <a
                  href="https://archives.komafes.jp/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  ARCHIVES
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main class="page-container">
      <!-- 共通ページヘッダー -->
      <header
        class="page-header"
        style={`background-image: url('${titleBg.src}');`}
      >
        <div class="page-header-inner">
          <h1 class="page-title">{pageTitleEn}</h1>
          <p class="page-subtitle">{pageTitleJa}</p>
        </div>
      </header>

      <p class="notice-msg">
        現在、MAP画像のみ公開中です。正式版MAPの公開まで少々お待ちください。
      </p>

      <!-- １階のMAP -->
      <div class="map-section">
        <p>1階</p>
        <img src={map1f.src} alt="1階のMAP" class="map-image" />
      </div>

      <!-- ２階のMAP -->
      <div class="map-section">
        <p>2階</p>
        <!-- ※画像のパス(/map2f.webpなど)は実際のファイル名に合わせて変更してください -->
        <img src={map2f.src} alt="2階のMAP" class="map-image" />
      </div>

      <!-- ３階のMAP -->
      <div class="map-section">
        <p>3階</p>
        <img src={map3f.src} alt="3階のMAP" class="map-image" />
      </div>

      <!-- ４階のMAP -->
      <div class="map-section">
        <p>4階</p>
        <img src={map4f.src} alt="4階のMAP" class="map-image" />
      </div>
      <!-- ５階のMAP -->
      <div class="map-section">
        <p>5階</p>
        <img src={map5f.src} alt="5階のMAP" class="map-image" />
      </div>  
    </main>
  </body>

  <!-- フッター -->
  <footer
    class="footer"
    style={`background-image: url('${titleBackgroundBlack.src}'); background-size: cover; background-position: center;`}
  >
    <div class="footer-inner">
      <!-- 左側：学校情報・アクセス -->
      <div class="footer-info">
        <p class="school-name">駒場東邦中学校・高等学校 第69回 文化祭</p>
        <a href="/" class="footer-brand">
          <img src={logoImg.src} alt="Komafes69 Logo" class="footer-logo" />
          <img src={typoImg.src} alt="SAIL BEYOND" class="footer-typo" />
        </a>

        <div class="school-details">
          <p><strong>開催日時：</strong>9月19日(土)・20日(日) 9:00〜16:30</p>
          <p><strong>所在地：</strong>〒154-0001 東京都世田谷区池尻4-5-1</p>
          <p class="access-info">
            東急田園都市線「池尻大橋」駅より徒歩10分<br />
            京王井の頭線「駒場東大前」駅より徒歩10分
          </p>
        </div>
      </div>

      <!-- 右側：ミニサイトマップとSNS -->
      <div class="footer-nav">
        <ul class="sitemap">
          <li><a href="/">TOP</a></li>
          <li><a href="/theme">THEME</a></li>
          <li><a href="/exhibition">EXHIBITION</a></li>
          <li><a href="/articles">ARTICLES</a></li>
          <li><a href="/timetable">TIME TABLE</a></li>
          <li><a href="/map">MAP</a></li>
          <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
        </ul>

        <div class="footer-sns">
          <a
            href="https://www.instagram.com/komafes69/"
            aria-label="Instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src={instagramIcon.src}
              alt="Instagram"
              class="footer-sns-icon"
            />
          </a>
          <a
            href="https://www.youtube.com/@komafes69"
            aria-label="YouTube"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={youtubeIcon.src} alt="YouTube" class="footer-sns-icon" />
          </a>
          <a
            href="https://x.com/Komafes69"
            aria-label="X"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={xIcon.src} alt="X" class="footer-sns-icon" />
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Komafes69 All Rights Reserved.</p>
    </div>
  </footer>

  <script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
      // --- GSAP タイトルアニメーション ---
      gsap.fromTo(
        ".page-title",
        { clipPath: "inset(0 100% 0 0)", opacity: 1 },
        {
          clipPath: "inset(0 0% 0 0)",
          duration: 2.5,
          ease: "power2.out",
          delay: 0.2,
        },
      );
      gsap.fromTo(
        ".page-subtitle",
        { clipPath: "inset(0 100% 0 0)", opacity: 1 },
        {
          clipPath: "inset(0 0% 0 0)",
          duration: 2.5,
          ease: "power2.out",
          delay: 0.35,
        },
      );

      // --- ヘッダースクロール処理 ---
      const stickyHeader = document.querySelector(".sticky-header");
      if (stickyHeader) {
        window.addEventListener("scroll", () => {
          if (window.scrollY > 50) {
            stickyHeader.classList.add("is-scrolled");
          } else {
            stickyHeader.classList.remove("is-scrolled");
          }
        });
      }

      // --- ハンバーガーメニュー制御 ---
      const hamburger = document.querySelector(".hamburger");
      const mobileNav = document.querySelector(".mobile-nav");
      if (hamburger && mobileNav) {
        hamburger.addEventListener("click", () => {
          hamburger.classList.toggle("is-active");
          mobileNav.classList.toggle("is-active");
          document.body.classList.toggle("no-scroll");
        });
      }
    });
  </script>
</html>

<style is:global>
  /* 基本設定 */
  body {
    font-family:
      "Noto Sans JP",
      system-ui,
      -apple-system,
      sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f6f8;
    color: #1a202c;
  }
  body.no-scroll {
    overflow: hidden;
  }

  /* --- ヘッダー周り --- */
  .sticky-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 900;
    background: transparent;
    transition: all 0.3s ease;
    padding: 1rem 0;
  }
  .sticky-header.is-scrolled {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .sticky-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }
  .header-logo {
    height: 32px;
    width: auto;
  }
  .header-typo {
    height: 18px;
    width: auto;
  }
  .header-logo,
  .header-typo {
    filter: brightness(0) invert(1);
    transition: filter 0.3s ease;
  }
  .sticky-header.is-scrolled .header-logo,
  .sticky-header.is-scrolled .header-typo {
    filter: brightness(0);
  }

  .header-right-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .header-nav ul {
    display: flex;
    gap: clamp(1.2rem, 2.8vw, 3rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header-nav a {
    color: #ffffff;
    text-decoration: none;
    font-family: "Bebas Neue", cursive;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    letter-spacing: 0.12em;
    transition:
      color 0.3s,
      opacity 0.2s;
  }
  .sticky-header.is-scrolled .header-nav a {
    color: #111111;
  }
  .header-nav a:hover {
    opacity: 0.5;
  }

  /* ハンバーガーメニュー */
  .hamburger {
    display: none;
  }
  .mobile-nav {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .sticky-header {
      display: none !important;
    }
    .hamburger {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 30px;
      height: 22px;
      background: transparent;
      border: none;
      cursor: pointer;
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1000;
      padding: 0;
    }
    .hamburger-line {
      display: block;
      width: 100%;
      height: 2px;
      background-color: #111111;
      border-radius: 2px;
      transition:
        transform 0.3s,
        opacity 0.3s;
    }
    .hamburger.is-active .hamburger-line {
      background-color: #ffffff;
    }
    .hamburger.is-active .hamburger-line:nth-child(1) {
      transform: translateY(10px) rotate(45deg);
    }
    .hamburger.is-active .hamburger-line:nth-child(2) {
      opacity: 0;
    }
    .hamburger.is-active .hamburger-line:nth-child(3) {
      transform: translateY(-10px) rotate(-45deg);
    }

    .mobile-nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-color: rgba(17, 17, 17, 0.96);
      z-index: 999;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .mobile-nav.is-active {
      display: flex;
    }
    .mobile-nav ul {
      list-style: none;
      padding: 0;
      margin: 0;
      text-align: center;
    }
    .mobile-nav li {
      margin: 1.5rem 0;
    }
    .mobile-nav a {
      color: #ffffff;
      text-decoration: none;
      font-size: 1.8rem;
      font-family: "Bebas Neue", cursive;
    }
    .mobile-sns-links {
      display: flex;
      gap: 2rem;
      margin-top: 2rem;
    }
    .mobile-sns-links a {
      display: flex;
      flex-direction: column;
      align-items: center;
      color: #fff;
      font-size: 0.8rem;
      text-decoration: none;
    }
    .sns-icon {
      width: 24px;
      height: 24px;
    }
  }

  /* --- ページレイアウト --- */
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 60px;
  }
  .page-header {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    margin-bottom: 0;
    padding: 5.5rem 0 4.5rem 0;
    background-size: cover;
    background-position: center;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }
  .page-header-inner {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: left;
  }
  .page-title {
    font-family: "Bebas Neue", cursive;
    font-size: clamp(2rem, 18vw, 8rem);
    letter-spacing: 0.04em;
    margin-top: 10px;
    color: #ffffff;
    line-height: 0.85;
    font-weight: 900;
  }
  .page-subtitle {
    margin-top: -50px;
    margin-bottom: 30px;
    color: #ffffff;
    font-size: clamp(1.25rem, 3vw, 30px);
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .page-header::after {
    content: "";
    position: absolute;
    top: -50%;
    bottom: -50%;
    right: 14%;
    width: 65px;
    background-color: #ffffff;
    transform: skewX(-20deg);
    z-index: 1;
    pointer-events: none;
  }
  @media screen and (max-width: 768px) {
    .page-header {
      padding: 3.5rem 0 2.2rem 0;
    }
    .page-header-inner {
      padding: 0 1.2rem;
    }
    .page-header::after {
      right: 8%;
      width: 32px;
    }
  }

  /* メインコンテンツ枠 */
  .page-content {
    margin-top: 2rem;
  }

  /* 応急措置用MAPのスタイル */
  .page-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    text-align: center; /* 全体を中央揃え */
  }

  .notice-msg {
    font-size: 1.1rem;
    font-weight: bold;
    color: #ea580c; /* 注意を引くオレンジ色 */
    margin-bottom: 40px;
  }

  .map-section {
    margin-bottom: 60px; /* 各階のMAPの間隔を広めにとる */
  }

  .map-section p {
    font-size: 1.5rem;
    font-weight: bold;
    color: #333;
    margin-bottom: 15px;
    border-bottom: 2px solid #cbd5e1;
    display: inline-block;
    padding-bottom: 5px;
  }

  .map-image {
    width: 100%;
    max-width: 1200px;
    height: auto;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); /* 少し影をつけて見やすく */
    display: block;
    margin: 0 auto;
  }
  /* --- FOOTER --- */
  .footer {
    background-color: #1a1b1f;
    color: #f6f9f6;
    padding: 70px 0 20px;
    font-family: "Noto Sans JP", sans-serif;
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }
  .footer-info {
    flex: 1;
  }
  .footer-brand {
    display: inline-flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 24px;
    transition: opacity 0.2s ease;
  }
  .footer-brand:hover {
    opacity: 0.7;
  }
  .footer-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }
  .footer-typo {
    height: 20px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }
  .school-name {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0 0 20px 0;
  }
  .school-details p {
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0 0 8px 0;
    color: #ccc;
  }
  .school-details strong {
    color: #f6f9f6;
    font-weight: 500;
  }
  .access-info {
    margin-top: 12px !important;
    padding-left: 10px;
    border-left: 2px solid #555;
  }
  .footer-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .sitemap {
    list-style: none;
    padding: 0;
    margin: 0 0 30px 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 50px;
    row-gap: 16px;
    text-align: left;
  }
  .sitemap a {
    color: #f6f9f6;
    text-decoration: none;
    font-family: "Bebas Neue", cursive;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    display: inline-block;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }
  .sitemap a:hover {
    color: #aaa;
    transform: translateX(4px);
  }
  .footer-sns {
    display: flex;
    gap: 24px;
  }
  .footer-sns-icon {
    width: 22px;
    height: 22px;
    object-fit: contain;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }
  .footer-sns-icon:hover {
    transform: scale(1.15);
    opacity: 0.7;
  }
  .footer-bottom {
    text-align: center;
    margin-top: 30px;
    padding-top: 20px;
  }
  .footer-bottom p {
    margin: 0;
    font-size: 0.75rem;
    color: #b3b1b1;
    letter-spacing: 0.05em;
  }

  @media screen and (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: 50px;
    }
    .school-name {
      font-size: 4.5vw;
    }
    .sitemap {
      column-gap: 20px;
      width: 100%;
    }
  }
</style>
