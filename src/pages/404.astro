---
import { Image } from "astro:assets";

// アセットのインポート（exhibition.astroと同じパス構造を想定）
import instagramIcon from "../pages/assets/Instagram.svg";
import youtubeIcon from "../pages/assets/youtube.svg";
import xIcon from "../pages/assets/X.svg";
import logoImg from "../pages/assets/logo.svg";
import typoImg from "../pages/assets/typo.svg";
import titleBackgroundBlack from "../pages/assets/TitleBackgroundBlack.jpg";

const pageTitle = "404 Not Found | 駒場東邦 第69回 文化祭 | SAIL BEYOND";
const pageDescription = "お探しのページは見つかりませんでした。";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/favicon.png" sizes="96x96" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Sail Beyond" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <!-- ========================================
         スマホ用 メニュー (中身)
         ======================================== -->
    <nav id="mobile-menu" class="mobile-nav">
      <ul>
        <li><a href="/">TOP</a></li>
        <li><a href="/theme">THEME</a></li>
        <li><a href="/exhibition">EXHIBITION</a></li>
        <li><a href="/articles">ARTICLES</a></li>
        <li><a href="/timetable">TIME TABLE</a></li>
        <li><a href="/map">MAP</a></li>
        <li><a href="https://archives.komafes.jp/" target="_blank" rel="noopener noreferrer">
          ARCHIVES
        </a></li>
      </ul>
      <div class="mobile-sns-links">
        <a href="https://www.instagram.com/komafes69/" target="_blank" rel="noopener noreferrer">
          <Image src={instagramIcon} alt="" format="svg" quality={100} class="sns-icon" />
          <span>Instagram</span>
        </a>
        <a href="https://www.youtube.com/@komafes69" target="_blank" rel="noopener noreferrer">
          <Image src={youtubeIcon} alt="YouTube" format="svg" quality={100} class="sns-icon" />
          <span>YouTube</span>
        </a>
        <a href="https://x.com/Komafes69" target="_blank" rel="noopener noreferrer">
          <Image src={xIcon} alt="" format="svg" quality={100} class="sns-icon" />
          <span>X</span>
        </a>
      </div>
    </nav>

    <!-- ========================================
         PC・タブレット・スマホ兼用 ヘッダー
         ======================================== -->
    <header class="sticky-header">
      <div class="sticky-header-inner">
        <a href="/" class="header-brand">
          <Image src={logoImg} alt="Komafes69 Logo" format="svg" quality={85} class="header-logo" />
          <Image src={typoImg} alt="SAIL BEYOND" format="svg" quality={85} class="header-typo" />
        </a>
        <div class="header-right">
          <nav class="header-nav">
            <ul>
              <li><a href="/">TOP</a></li>
              <li><a href="/theme">THEME</a></li>
              <li><a href="/exhibition">EXHIBITION</a></li>
              <li><a href="/articles">ARTICLES</a></li>
              <li><a href="/timetable">TIME TABLE</a></li>
              <li><a href="/map">MAP</a></li>
              <li><a href="https://archives.komafes.jp/" target="_blank" rel="noopener noreferrer">
                ARCHIVES
              </a></li>
            </ul>
          </nav>
          <button class="hamburger" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-menu">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </button>
        </div>
      </div>
    </header>

    <!-- ========================================
         404 メインコンテンツ
         ======================================== -->
    <main class="error-page">
      <div class="error-container">
        <h1 class="error-code">404</h1>
        <h2 class="error-title">PAGE NOT FOUND</h2>
        <p class="error-text">
          お探しのページは、公開期間外であるか、<br class="sp-only" />削除された可能性があります。<br />
          ルートから外れてしまったようです。
        </p>
        
        <a href="/" class="btn-home">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          トップページへ戻る
        </a>
      </div>
    </main>

    <!-- ========================================
         FOOTER
         ======================================== -->
    <footer
      class="footer"
      style={`background-image: url('${titleBackgroundBlack.src}'); background-size: cover; background-position: center;`}
    >
      <div class="footer-inner">
        <div class="footer-info">
          <p class="school-name">駒場東邦中学校・高等学校 第69代 文化祭</p>
          <a href="/" class="footer-brand">
            <Image src={logoImg} alt="Komafes69 Logo" format="svg" quality={85} class="footer-logo" />
            <Image src={typoImg} alt="SAIL BEYOND" format="svg" quality={85} class="footer-typo" />
          </a>
          <div class="school-details">
            <p><strong>開催日時：</strong>9月19日(土)・20日(日) 9:00〜16:30</p>
            <p><strong>所在地：</strong>〒154-0001 東京都世田谷区池尻4-5-1</p>
            <p class="access-info">
              東急田園都市線「池尻大橋」駅より徒歩10分<br />
              京王井の頭線「駒場東大前」駅より徒歩10分
            </p>
          </div>
        </div>

        <div class="footer-nav">
          <ul class="sitemap">
            <li><a href="/">TOP</a></li>
            <li><a href="/theme">THEME</a></li>
            <li><a href="/exhibition">EXHIBITION</a></li>
            <li><a href="/articles">ARTICLES</a></li>
            <li><a href="/timetable">TIME TABLE</a></li>
            <li><a href="/map">MAP</a></li>
            <li><a href="https://archives.komafes.jp/" target="_blank" rel="noopener noreferrer">
              ARCHIVES
            </a></li>
          </ul>
          <div class="footer-sns">
            <a href="https://www.instagram.com/komafes69/" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <Image src={instagramIcon} alt="Instagram" format="svg" class="footer-sns-icon" />
            </a>
            <a href="https://www.youtube.com/@komafes68" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
              <Image src={youtubeIcon} alt="YouTube" format="svg" class="footer-sns-icon" />
            </a>
            <a href="https://x.com/Komafes68" aria-label="X" target="_blank" rel="noopener noreferrer">
              <Image src={xIcon} alt="X" format="svg" class="footer-sns-icon" />
            </a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Komafes69 All Rights Reserved.</p>
      </div>
    </footer>

    <!-- スクリプト: ハンバーガーメニューとヘッダー追従 -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const stickyHeader = document.querySelector(".sticky-header");
        const hamburger = document.querySelector(".hamburger");
        const mobileNav = document.querySelector(".mobile-nav");
        const mobileLinks = document.querySelectorAll(".mobile-nav a");

        // 404ページではヒーロー領域がないため、初期状態でヘッダーに色付けしておく
        stickyHeader?.classList.add("is-show");
        hamburger?.classList.add("is-black");

        const closeMobileNav = () => {
          hamburger?.classList.remove("is-active");
          mobileNav?.classList.remove("is-active");
          hamburger?.setAttribute("aria-expanded", "false");
          document.body.classList.remove("no-scroll");
        };

        hamburger?.addEventListener("click", () => {
          const isOpen = hamburger.classList.toggle("is-active");
          mobileNav?.classList.toggle("is-active", isOpen);
          hamburger.setAttribute("aria-expanded", String(isOpen));
          document.body.classList.toggle("no-scroll", isOpen);
        });
        
        mobileLinks.forEach((link) => link.addEventListener("click", closeMobileNav));
      });
    </script>
  </body>
</html>

<style is:global>
  /* ========================================
     全体基本スタイル・ヘッダー・フッター
     (exhibition.astroと共通)
     ======================================== */
  body {
    font-family: "Noto Sans JP", system-ui, -apple-system, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f6f8;
    color: #1a202c;
  }
  body.no-scroll {
    overflow: hidden;
  }

  .sticky-header {
    position: fixed;
    top: 0; left: 0; width: 100%;
    z-index: 1000;
    background: transparent;
    border-bottom: 1px solid transparent;
    padding: 0.8rem 0;
    transition: opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1), background-color 0.3s ease;
  }
  .sticky-header.is-show {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: rgba(0, 0, 0, 0.05);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }
  .sticky-header-inner {
    width: 100%; max-width: 1200px;
    margin: 0 auto; display: flex;
    justify-content: space-between; align-items: center;
    padding: 0 1.5rem; box-sizing: border-box;
  }
  .header-brand {
    display: flex; align-items: center; gap: 12px;
    text-decoration: none; transition: opacity 0.2s ease;
  }
  .header-brand:hover { opacity: 0.7; }
  .header-logo { height: 40px; width: auto; object-fit: contain; filter: brightness(0) invert(1); }
  .header-typo { height: 20px; width: auto; object-fit: contain; filter: brightness(0) invert(1); }
  .header-nav ul { display: flex; gap: clamp(1rem, 2vw, 2.5rem); list-style: none; margin: 0; padding: 0; }
  .header-nav a {
    color: #ffffff; text-decoration: none; font-family: "Bebas Neue", cursive;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem); letter-spacing: 0.12em;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .header-nav a:hover { opacity: 0.6; transform: translateY(-1px); }
  .sticky-header.is-show .header-logo, .sticky-header.is-show .header-typo { filter: brightness(0); }
  .sticky-header.is-show .header-nav a { color: #111111; }
  
  .hamburger, .mobile-nav { display: none; }

  @media screen and (max-width: 768px) {
    .mobile-nav {
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      position: fixed; top: 0; left: 0; width: 100%; height: 100dvh;
      background-color: rgba(0, 0, 0, 0.92); z-index: 999;
      opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
    }
    .mobile-nav.is-active { opacity: 1; pointer-events: auto; }
    .mobile-nav ul { list-style: none; padding: 0; margin: 0; text-align: center; }
    .mobile-nav li { margin: 1.5rem 0; }
    .mobile-nav a { color: #f6f9f6; text-decoration: none; font-size: 1.8rem; font-family: "Bebas Neue", cursive; letter-spacing: 0.15em; }
    .mobile-sns-links { display: flex; gap: 2rem; margin-top: 3rem; transform: translateX(-20px); }
    .mobile-sns-links a { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; color: #ffffff; text-decoration: none; font-size: 0.8rem; }
    .mobile-sns-links .sns-icon { width: 28px; height: 28px; object-fit: contain; }

    .sticky-header { display: block !important; }
    .header-logo { height: 24px; }
    .header-typo { height: 12px; }
    .header-brand { gap: 8px; }
    .header-nav { display: none; }

    .hamburger {
      display: flex; flex-direction: column; justify-content: space-between;
      width: 28px; height: 20px; background: transparent; border: none; cursor: pointer;
      position: relative; z-index: 1000; padding: 0;
    }
    .hamburger-line {
      display: block; width: 100%; height: 2px; background-color: #ffffff; border-radius: 2px;
      transition: background-color 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
    }
    .hamburger.is-black .hamburger-line { background-color: #000000; filter: none; }
    .hamburger.is-active .hamburger-line { background-color: #ffffff !important; }
    .hamburger.is-active .hamburger-line:nth-child(1) { transform: translateY(9px) rotate(45deg); }
    .hamburger.is-active .hamburger-line:nth-child(2) { opacity: 0; }
    .hamburger.is-active .hamburger-line:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }
    
    .mobile-nav.is-active ~ .sticky-header .header-logo,
    .mobile-nav.is-active ~ .sticky-header .header-typo { filter: brightness(0) invert(1) !important; }
    .sticky-header:has(.hamburger.is-active) { background: transparent !important; border-bottom: none !important; box-shadow: none !important; }
  }

  /* ========================================
     404エラーページ 専用スタイル
     ======================================== */
  .error-page {
    display: flex; align-items: center; justify-content: center;
    min-height: 100vh; padding: 8px 2rem 4rem; text-align: center; color: #060906;
  }
  .error-container { max-width: 600px; margin: 0 auto; }
  .error-code {
    font-family: "Bebas Neue", cursive;
    font-size: clamp(6rem, 15vw, 12rem); font-weight: 800; line-height: 1; margin: 0;
    color: #031c3f; 
    text-shadow: 4px 4px 0px rgba(0, 0, 0, 0.05);
  }
  .error-title {
    font-size: clamp(1.5rem, 4vw, 2.5rem); font-weight: 700; margin: 0.5rem 0 1.5rem; letter-spacing: 0.05em;
  }
  .error-text { font-size: 1rem; line-height: 1.8; margin-bottom: 2.5rem; color: #444; }
  .sp-only { display: none; }
  .btn-home {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    padding: 16px 32px; background-color: #031c3f; color: #ffffff;
    font-weight: bold; text-decoration: none; border-radius: 30px; transition: all 0.3s ease;
  }
  .btn-home:hover { background-color: #020e20; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(3, 28, 63, 0.3); }
  @media screen and (max-width: 768px) {
    .error-page { min-height: 80vh; }
    .sp-only { display: block; }
    .btn-home { width: 100%; padding: 14px 20px; box-sizing: border-box; }
  }

  /* ========================================
     FOOTER
     ======================================== */
  .footer { background-color: #1a1b1f; color: #f6f9f6; padding: 70px 0 20px; font-family: "Noto Sans JP", sans-serif; }
  .footer-inner { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; }
  .footer-info { flex: 1; }
  .footer-brand { display: inline-flex; gap: 10px; text-decoration: none; margin-bottom: 24px; transition: opacity 0.2s ease; }
  .footer-brand:hover { opacity: 0.7; }
  .footer-logo { height: 40px; width: auto; object-fit: contain; filter: brightness(0) invert(1); }
  .footer-typo { height: 20px; width: auto; object-fit: contain; filter: brightness(0) invert(1); }
  .school-name { font-size: 1.3rem; font-weight: 500; margin: 0 0 20px 0; }
  .school-details p { font-size: 0.85rem; line-height: 1.6; margin: 0 0 8px 0; color: #ccc; }
  .school-details strong { color: #f6f9f6; font-weight: 500; }
  .access-info { margin-top: 12px !important; padding-left: 10px; border-left: 2px solid #555; }
  
  .footer-nav { display: flex; flex-direction: column; align-items: flex-start; }
  .sitemap {
    list-style: none; padding: 0; margin: 0 0 30px 0; display: grid;
    grid-template-columns: repeat(2, 1fr); column-gap: 50px; row-gap: 16px;
  }
  .sitemap a {
    color: #f6f9f6; text-decoration: none; font-family: "Bebas Neue", cursive;
    font-size: 1.1rem; letter-spacing: 0.1em; transition: color 0.2s ease, transform 0.2s ease; display: inline-block;
  }
  .sitemap a:hover { color: #aaa; transform: translateX(4px); }
  .footer-sns { display: flex; gap: 24px; }
  .footer-sns-icon { width: 22px; height: 22px; object-fit: contain; transition: transform 0.2s ease, opacity 0.2s ease; }
  .footer-sns-icon:hover { transform: scale(1.15); opacity: 0.7; }
  .footer-bottom { text-align: center; margin-top: 30px; padding-top: 20px; }
  .footer-bottom p { margin: 0; font-size: 0.75rem; color: #b3b1b1; letter-spacing: 0.05em; }
  
  @media screen and (max-width: 768px) {
    .footer-inner { flex-direction: column; gap: 50px; }
    .school-name { font-size: 4.5vw; }
    .sitemap { column-gap: 20px; width: 100%; }
  }
</style>