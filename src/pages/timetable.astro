---
import timetable from "./data/timetable.json";
import instagramIcon from "./assets/Instagram.svg";
import youtubeIcon from "./assets/youtube.svg";
import xIcon from "./assets/X.svg";
import titleBg from "./assets/TitleBackground.webp";
import titleBackgroundBlack from "./assets/TitleBackgroundBlack.jpg";
import logoImg from "./assets/logo.svg";
import typoImg from "./assets/typo.svg";

type Schedule = {
  id: string;
  day: "1" | "2";
  startTime: string;
  endTime: string;
  location: string;
  title: string;
  groupName?: string;
  description?: string;
};

const schedules = timetable as Schedule[];
const locations = Array.from(new Set(schedules.map((item) => item.location)));
const dayLabels = { "1": "9.19 SAT", "2": "9.20 SUN" };

// タイムライン位置計算用（9:00 〜 18:00 = 540分間）
const START_HOUR = 9;
const END_HOUR = 18;
const START_MINUTES = START_HOUR * 60; // 540分
const TOTAL_MINUTES = (END_HOUR - START_HOUR) * 60; // 540分

const timeHours = Array.from({ length: END_HOUR - START_HOUR + 1 }, (_, i) => START_HOUR + i);

const timeToMinutes = (timeStr: string) => {
  const [h, m] = timeStr.split(":").map(Number);
  return h * 60 + m;
};

const getTimelinePosition = (startTime: string, endTime: string) => {
  const start = timeToMinutes(startTime);
  const end = timeToMinutes(endTime);
  const topPercent = ((start - START_MINUTES) / TOTAL_MINUTES) * 100;
  const heightPercent = ((end - start) / TOTAL_MINUTES) * 100;
  return {
    top: `${Math.max(0, topPercent)}%`,
    height: `${Math.max(1.8, heightPercent)}%`,
  };
};
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>タイムテーブル | 第69回 駒場東邦文化祭 | SAIL BEYOND</title>
    <meta
      name="description"
      content="第69回駒場東邦文化祭のステージ・講堂・体育館・校庭のタイムテーブルです。"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <nav id="mobile-menu" class="mobile-nav" aria-label="モバイルメニュー">
      <ul>
        <li><a href="/">TOP</a></li>
        <li><a href="/theme">THEME</a></li>
        <li><a href="/exhibition">EXHIBITION</a></li>
        <li><a href="/articles">ARTICLES</a></li>
        <li><a href="/timetable">TIME TABLE</a></li>
        <li><a href="/map">MAP</a></li>
        <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
      </ul>
      <div class="mobile-sns-links">
        <a href="https://www.instagram.com/komafes69/" target="_blank" rel="noopener noreferrer">
          <img src={instagramIcon.src} alt="" />Instagram
        </a>
        <a href="https://www.youtube.com/@komafes69" target="_blank" rel="noopener noreferrer">
          <img src={youtubeIcon.src} alt="" />YouTube
        </a>
        <a href="https://x.com/Komafes69" target="_blank" rel="noopener noreferrer">
          <img src={xIcon.src} alt="" />X
        </a>
      </div>
    </nav>

    <header class="sticky-header">
      <div class="sticky-header-inner">
        <a href="/" class="header-brand">
          <img src={logoImg.src} alt="Komafes69" class="header-logo" />
          <img src={typoImg.src} alt="SAIL BEYOND" class="header-typo" />
        </a>
        <div class="header-right">
          <nav class="header-nav" aria-label="メインメニュー">
            <ul>
              <li><a href="/">TOP</a></li>
              <li><a href="/theme">THEME</a></li>
              <li><a href="/exhibition">EXHIBITION</a></li>
              <li><a href="/articles">ARTICLES</a></li>
              <li><a href="/timetable" aria-current="page">TIME TABLE</a></li>
              <li><a href="/map">MAP</a></li>
              <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
            </ul>
          </nav>
          <button
            class="hamburger"
            aria-label="メニューを開く"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </button>
        </div>
      </div>
    </header>

    <main class="timetable-container">
      <header
        class="page-header"
        style={`background-image: url('${titleBg.src}');`}
      >
        <div class="page-header-inner">
          <h1 class="page-title">TIME TABLE</h1>
          <p class="page-subtitle">タイムテーブル</p>
        </div>
      </header>

      <section class="schedule-intro" aria-labelledby="schedule-heading">
        <p class="eyebrow">SAIL BEYOND</p>
        <h2 id="schedule-heading" class="schedule-title">イベントスケジュール</h2>
        <p class="schedule-description">見たい企画を見つけて、文化祭をもっと楽しもう。</p>
      </section>

      <section class="schedule-section" aria-label="日別タイムテーブル">
        <!-- Day Select Controls & View Switcher -->
        <div class="controls-wrapper">
          <div class="day-tabs" role="tablist" aria-label="開催日">
            <button
              class="day-tab is-active"
              role="tab"
              aria-selected="true"
              aria-controls="day-1"
              id="tab-1"
              data-day="1"
            >
              <span>DAY 1</span>{dayLabels["1"]}
            </button>
            <button
              class="day-tab"
              role="tab"
              aria-selected="false"
              aria-controls="day-2"
              id="tab-2"
              data-day="2"
            >
              <span>DAY 2</span>{dayLabels["2"]}
            </button>
          </div>

          <!-- 表示モード切り替えボタン -->
          <div class="view-switcher" role="radiogroup" aria-label="表示形式切り替え">
            <button
              type="button"
              class="view-btn is-active"
              data-view="list"
              aria-checked="true"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              リスト
            </button>
            <button
              type="button"
              class="view-btn"
              data-view="timeline"
              aria-checked="false"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
              タイムライン
            </button>
          </div>
        </div>

        {
          (["1", "2"] as const).map((day) => (
            <div
              class:list={["day-panel", "view-list", { "is-active": day === "1" }]}
              id={`day-${day}`}
              role="tabpanel"
              aria-labelledby={`tab-${day}`}
              hidden={day !== "1"}
            >
              <div class="day-heading">
                <span>DAY {day}</span>
                <h3>{day === "1" ? "9月19日（土）" : "9月20日（日）"}</h3>
              </div>

              <!-- 1. タイムライン表示ビュー -->
              <div class="timeline-view">
                <div class="timeline-scroll-container">
                  <div class="timeline-wrapper">
                    <!-- 時間軸ラベル（左側固定） -->
                    <div class="time-axis">
                      {timeHours.map((hour) => (
                        <div class="time-label" style={`top: ${((hour * 60 - START_MINUTES) / TOTAL_MINUTES) * 100}%`}>
                          <span>{hour}:00</span>
                        </div>
                      ))}
                    </div>

                    <!-- メインコンテンツ領域 -->
                    <div class="timeline-grid">
                      <!-- 背景の1時間ごとの水平罫線 -->
                      <div class="grid-lines">
                        {timeHours.map((hour) => (
                          <div class="grid-line" style={`top: ${((hour * 60 - START_MINUTES) / TOTAL_MINUTES) * 100}%`}></div>
                        ))}
                      </div>

                      <!-- 各場所のカラム -->
                      <div class="location-columns">
                        {locations.map((loc) => {
                          const events = schedules.filter(
                            (item) => item.day === day && item.location === loc
                          );
                          return (
                            <div class="timeline-col" data-location={loc}>
                              <div class="col-header">
                                <span>{loc}</span>
                              </div>
                              <div class="col-content">
                                {events.map((event) => {
                                  const pos = getTimelinePosition(event.startTime, event.endTime);
                                  return (
                                    <button
                                      type="button"
                                      class:list={[
                                        "timeline-card",
                                        { "has-detail": !!event.description }
                                      ]}
                                      style={`top: ${pos.top}; height: ${pos.height};`}
                                      data-event-title={event.title}
                                      data-event-time={`${event.startTime} – ${event.endTime}`}
                                      data-event-location={event.location}
                                      data-event-description={event.description || ""}
                                    >
                                      <span class="card-time">{event.startTime} - {event.endTime}</span>
                                      <strong class="card-title">{event.title}</strong>
                                    </button>
                                  );
                                })}
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- 2. リスト表示ビュー -->
              <div class="list-view">
                <div class="schedule-grid">
                  {locations.map((location) => {
                    const events = schedules.filter(
                      (item) => item.day === day && item.location === location
                    );
                    return (
                      <article class="location-column">
                        <h4>{location}</h4>
                        <div class="event-list">
                          {events.map((event) =>
                            event.description ? (
                              <button
                                type="button"
                                class="event-card is-detail"
                                data-event-title={event.title}
                                data-event-time={`${event.startTime} – ${event.endTime}`}
                                data-event-location={event.location}
                                data-event-description={event.description}
                                aria-haspopup="dialog"
                              >
                                <time>{event.startTime}<span>–</span>{event.endTime}</time>
                                <span class="event-content">
                                  <strong>{event.title}</strong>
                                  {event.groupName && event.groupName !== event.title && <small>{event.groupName}</small>}
                                  <em>詳細を見る</em>
                                </span>
                              </button>
                            ) : (
                              <div class="event-card">
                                <time>{event.startTime}<span>–</span>{event.endTime}</time>
                                <div class="event-content">
                                  <strong>{event.title}</strong>
                                  {event.groupName && event.groupName !== event.title && <small>{event.groupName}</small>}
                                </div>
                              </div>
                            )
                          )}
                        </div>
                      </article>
                    );
                  })}
                </div>
              </div>

            </div>
          ))
        }
      </section>
    </main>

    <!-- モダンなダイアログポップアップ -->
    <dialog class="event-modal" aria-labelledby="modal-title">
      <div class="modal-inner">
        <button type="button" class="modal-close" aria-label="閉じる">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        
        <div class="modal-badges">
          <span class="modal-badge-location" id="modal-location"></span>
          <span class="modal-badge-time" id="modal-time"></span>
        </div>

        <h2 id="modal-title"></h2>
        <div class="modal-divider"></div>
        <p class="modal-description" id="modal-description"></p>
      </div>
    </dialog>

    <footer
      class="footer"
      style={`background-image: url('${titleBackgroundBlack.src}');`}
    >
      <div class="footer-inner">
        <div class="footer-info">
          <p class="school-name">駒場東邦中学校・高等学校 第69回 文化祭</p>
          <a href="/" class="footer-brand">
            <img src={logoImg.src} alt="Komafes69 Logo" />
            <img src={typoImg.src} alt="SAIL BEYOND" />
          </a>
          <div class="school-details">
            <p><strong>開催日時：</strong>9月19日(土)・20日(日) 9:00〜16:30</p>
            <p><strong>所在地：</strong>〒154-0001 東京都世田谷区池尻4-5-1</p>
            <p class="access-info">
              東急田園都市線「池尻大橋」駅より徒歩10分<br />
              京王井の頭線「駒場東大前」駅より徒歩10分
            </p>
          </div>
        </div>
        <div class="footer-nav">
          <ul class="sitemap">
            <li><a href="/">TOP</a></li>
            <li><a href="/theme">THEME</a></li>
            <li><a href="/exhibition">EXHIBITION</a></li>
            <li><a href="/articles">ARTICLES</a></li>
            <li><a href="/timetable">TIME TABLE</a></li>
            <li><a href="/map">MAP</a></li>
            <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
          </ul>
          <div class="footer-sns">
            <a href="https://www.instagram.com/komafes69/" target="_blank" rel="noopener noreferrer">
              <img src={instagramIcon.src} alt="Instagram" />
            </a>
            <a href="https://www.youtube.com/@komafes69" target="_blank" rel="noopener noreferrer">
              <img src={youtubeIcon.src} alt="YouTube" />
            </a>
            <a href="https://x.com/Komafes69" target="_blank" rel="noopener noreferrer">
              <img src={xIcon.src} alt="X" />
            </a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        © 2026 Komafes69 All Rights Reserved.
      </div>
    </footer>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);
      const header = document.querySelector(".sticky-header");
      const headerTrigger = document.querySelector(".page-header");
      const hamburger = document.querySelector(".hamburger");
      const menu = document.querySelector(".mobile-nav");
      const mobileLinks = document.querySelectorAll(".mobile-nav a");
      const modal = document.querySelector(".event-modal") as HTMLDialogElement | null;
      const modalTitle = document.getElementById("modal-title");
      const modalLocation = document.getElementById("modal-location");
      const modalTime = document.getElementById("modal-time");
      const modalDescription = document.getElementById("modal-description");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const closeMobileNav = () => {
        hamburger?.classList.remove("is-active", "is-black");
        menu?.classList.remove("is-active");
        hamburger?.setAttribute("aria-expanded", "false");
        hamburger?.setAttribute("aria-label", "メニューを開く");
        document.body.classList.remove("no-scroll");
      };

      const updateHeader = () => {
        const shouldShow = (headerTrigger?.getBoundingClientRect().bottom ?? 0) <= 80;
        header?.classList.toggle("is-show", shouldShow);
        hamburger?.classList.toggle("is-black", shouldShow);
      };
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      hamburger?.addEventListener("click", () => {
        const active = hamburger.classList.toggle("is-active");
        menu?.classList.toggle("is-active", active);
        hamburger.setAttribute("aria-expanded", String(active));
        hamburger.setAttribute("aria-label", active ? "メニューを閉じる" : "メニューを開く");
        document.body.classList.toggle("no-scroll", active);
      });
      mobileLinks.forEach((link) => link.addEventListener("click", closeMobileNav));

      // タブ・ビュー切替アニメーション
      const animatePanel = (panel: Element) => {
        if (reduceMotion) return;
        gsap.fromTo(
          panel.querySelector(".day-heading"),
          { autoAlpha: 0, x: -20 },
          { autoAlpha: 1, x: 0, duration: 0.35, ease: "power2.out" }
        );
      };

      if (!reduceMotion) {
        gsap.fromTo(
          ".page-title",
          { clipPath: "inset(0 100% 0 0)" },
          { clipPath: "inset(0 0% 0 0)", duration: 1.5, ease: "power2.out", delay: 0.2 }
        );
        gsap.fromTo(
          ".page-subtitle",
          { clipPath: "inset(0 100% 0 0)" },
          { clipPath: "inset(0 0% 0 0)", duration: 1.3, ease: "power2.out", delay: 0.42 }
        );
        gsap.fromTo(
          ".schedule-intro > *",
          { autoAlpha: 0, y: 22 },
          {
            autoAlpha: 1,
            y: 0,
            duration: 0.55,
            stagger: 0.1,
            ease: "power2.out",
            scrollTrigger: { trigger: ".schedule-intro", start: "top 78%" },
          }
        );
      }

      // Day 切替
      document.querySelectorAll(".day-tab").forEach((tab) =>
        tab.addEventListener("click", () => {
          const day = (tab as HTMLElement).dataset.day;
          document.querySelectorAll(".day-tab").forEach((button) => {
            const selected = button === tab;
            button.classList.toggle("is-active", selected);
            button.setAttribute("aria-selected", String(selected));
          });
          document.querySelectorAll(".day-panel").forEach((panel) => {
            const selected = panel.id === `day-${day}`;
            panel.classList.toggle("is-active", selected);
            panel.toggleAttribute("hidden", !selected);
            if (selected) animatePanel(panel);
          });
        })
      );

      // 表示モード切替 (タイムライン ⇄ リスト)
      document.querySelectorAll(".view-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const view = (btn as HTMLElement).dataset.view;
          document.querySelectorAll(".view-btn").forEach((b) => {
            const active = b === btn;
            b.classList.toggle("is-active", active);
            b.setAttribute("aria-checked", String(active));
          });

          document.querySelectorAll(".day-panel").forEach((panel) => {
            panel.classList.toggle("view-timeline", view === "timeline");
            panel.classList.toggle("view-list", view === "list");
          });
        });
      });

      // モーダル表示イベントハンドラー
      const openModal = (card: HTMLElement) => {
        if (!modal) return;
        modalTitle!.textContent = card.dataset.eventTitle || "";
        modalLocation!.textContent = card.dataset.eventLocation || "";
        modalTime!.textContent = card.dataset.eventTime || "";
        modalDescription!.textContent = card.dataset.eventDescription || "";
        modal.showModal();
      };

      // リスト形式・タイムライン形式両方のクリックイベントを設定
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const card = target.closest<HTMLElement>(".event-card.is-detail, .timeline-card.has-detail");
        if (card) {
          openModal(card);
        }
      });

      document.querySelector(".modal-close")?.addEventListener("click", () => modal?.close());
      modal?.addEventListener("click", (event) => {
        if (event.target === modal) modal.close();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color: #082957;
    background: #f4f6f8;
    font-family: "Noto Sans JP", sans-serif;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
  }
  body.no-scroll {
    overflow: hidden;
  }

  /* Sticky Header */
  .sticky-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000;
    padding: 0.8rem 0;
    transition: 0.25s;
  }
  .sticky-header.is-show {
    background: #fffffff0;
    box-shadow: 0 2px 14px #001b4012;
    backdrop-filter: blur(12px);
  }
  .sticky-header-inner {
    max-width: 1200px;
    margin: auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .header-brand,
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 11px;
  }
  .header-logo {
    height: 40px;
    filter: brightness(0) invert(1);
  }
  .header-typo {
    height: 20px;
    filter: brightness(0) invert(1);
  }
  .is-show .header-logo,
  .is-show .header-typo {
    filter: brightness(0);
  }
  .header-nav ul,
  .mobile-nav ul,
  .sitemap {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header-nav ul {
    display: flex;
    gap: clamp(1rem, 2vw, 2.4rem);
  }
  .header-nav a,
  .mobile-nav a,
  .sitemap a {
    font-family: "Bebas Neue", sans-serif;
    letter-spacing: 0.11em;
    text-decoration: none;
  }
  .header-nav a {
    color: #fff;
    font-size: 1.08rem;
  }
  .is-show .header-nav a {
    color: #111;
  }
  .header-nav a[aria-current] {
    opacity: 0.6;
  }
  .hamburger,
  .mobile-nav {
    display: none;
  }

  /* Layout Container */
  .timetable-container {
    max-width: 1200px;
    margin: auto;
    padding: 0 1.5rem 6rem;
  }
  .page-header {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: 5.5rem 0 4.5rem;
    background-size: cover;
    background-position: center;
    overflow: hidden;
    color: white;
  }
  .page-header::after {
    content: "";
    position: absolute;
    top: -40%;
    right: 14%;
    width: 65px;
    height: 180%;
    background: #fff;
    transform: skewX(-20deg);
  }
  .page-header-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    padding: 0 2rem;
    margin: auto;
  }
  .page-header h1 {
    margin: 10px 0 0;
    font: 900 clamp(3.4rem, 13vw, 8rem)/0.85 "Bebas Neue";
    letter-spacing: 0.04em;
  }
  .page-header p {
    margin: -5px 0 0;
    font-weight: 700;
    font-size: clamp(1.1rem, 3vw, 1.75rem);
  }
  .schedule-intro {
    text-align: center;
    padding: 4.5rem 0 2rem;
  }
  .eyebrow {
