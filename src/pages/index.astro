    @media screen and (max-width: 768px) {
      /* ========================================
       モバイルナビゲーション画面 (スマホ用メニュー本体)
       ======================================== */
      .mobile-nav {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        height: 100dvh;
        background-color: rgba(0, 0, 0, 0.92);
        z-index: 999; /* ヘッダー(1000)の下に潜り込ませる */
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }

      .mobile-nav.is-active {
        opacity: 1;
        pointer-events: auto;
      }

      .mobile-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: center;
      }

      .mobile-nav li {
        margin: 1.5rem 0;
      }

      .mobile-nav a {
        color: #f6f9f6;
        text-decoration: none;
        font-size: 1.8rem;
        font-family: "Bebas Neue", cursive;
        letter-spacing: 0.15em;
      }

      .mobile-sns-links {
        display: flex;
        gap: 2rem;
        margin-top: 3rem;
        transform: translateX(-20px);
      }

      .mobile-sns-links a {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.8rem;
        font-family: "Noto Sans JP", sans-serif;
      }

      .mobile-sns-links .sns-icon {
        width: 28px;
        height: 28px;
        object-fit: contain;
      }

      /* ========================================
       ミニヘッダー (スマホ用)
       ======================================== */
      .sticky-header {
        display: block !important;
        opacity: 1;
        pointer-events: auto;
        background: transparent;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        border-bottom: none;
        box-shadow: none;
      }

      /* スクロール時の背景白化 */
      .sticky-header.is-show {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
      }

      .header-logo {
        height: 24px;
      }

      .header-typo {
        height: 12px;
      }

      .header-brand {
        gap: 8px;
        opacity: 0; /* 透明にする */
        visibility: hidden; /* クリック判定もなくす */
        transition:
          opacity 0.3s ease,
          visibility 0.3s ease;
      }

      .sticky-header.is-show .header-brand {
        opacity: 1;
        visibility: visible;
      }

      .mobile-nav.is-active ~ .sticky-header .header-brand,
      body:has(.hamburger.is-active) .header-brand {
        opacity: 1;
        visibility: visible;
      }

      /* 初期状態(暗い背景上)はロゴを白くする */
      .header-logo,
      .header-typo {
        filter: brightness(0) invert(1);
        transition: filter 0.3s ease;
      }

      /* スクロールして白背景になったら、ロゴを黒に戻す */
      .sticky-header.is-show .header-logo,
      .sticky-header.is-show .header-typo {
        filter: brightness(0);
      }

      /* メニューオープン時は強制的にロゴを白に戻す(黒背景になるため) */
      .mobile-nav.is-active ~ .sticky-header .header-logo,
      .mobile-nav.is-active ~ .sticky-header .header-typo,
      body:has(.hamburger.is-active) .header-logo,
      body:has(.hamburger.is-active) .header-typo {
        filter: brightness(0) invert(1) !important;
      }

      /* PC用ナビゲーションは隠す */
      .header-nav {
        display: none;
      }

      /* ========================================
       ハンバーガーボタン (ミニヘッダー内)
       ======================================== */
      .hamburger {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 28px;
        height: 20px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        position: relative;
        top: auto;
        right: auto;
        z-index: 1000;
      }

      .hamburger-line {
        display: block;
        width: 100%;
        height: 2px;
        background-color: #ffffff;
        border-radius: 2px;
        transition:
          background-color 0.3s ease,
          transform 0.3s ease,
          opacity 0.3s ease;
        filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.5));
      }

      /* スクロール時 (is-black) は黒 */
      .hamburger.is-black .hamburger-line {
        background-color: #000000;
        filter: none;
      }

      /* メニュー展開時は強制的に白（バツ印） */
      .hamburger.is-active .hamburger-line {
        background-color: #ffffff !important;
        filter: none;
      }

      /* バツ印になるアニメーション */
      .hamburger.is-active .hamburger-line:nth-child(1) {
        transform: translateY(9px) rotate(45deg);
      }
      .hamburger.is-active .hamburger-line:nth-child(2) {
        opacity: 0;
      }
      .hamburger.is-active .hamburger-line:nth-child(3) {
        transform: translateY(-9px) rotate(-45deg);
      }

      .sticky-header:has(.hamburger.is-active) {
        background: transparent !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        border-bottom: none !important;
        box-shadow: none !important;
      }
    }

