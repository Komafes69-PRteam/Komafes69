    .marquee-track {
      display: flex;
      width: max-content;
      /* 60秒かけてループします。速度を変えたい場合は秒数を調整してください */
      animation: marquee-anim 60s linear infinite;
    }

    .marquee-text {
      font-family: "Bebas Neue", cursive;
      font-size: clamp(4rem, 6vw, 14rem);
      color: transparent; /* 文字の塗りを透明に */
      -webkit-text-stroke: 0.01em #ffffff; /* アウトライン（縁取り）を設定 */
      letter-spacing: 0.01em;
      line-height: 1;
      /* 2つのspanタグの間の隙間をなくすために少し調整 */
      padding-right: 20px;
      margin-top: -0.03em;
      margin-bottom: -0.09em;
    }

    /* ダークモードや黒背景に被る際に、アウトラインを白にしたい場合は色を #fff に変更してください */

    @keyframes marquee-anim {
      0% {
        transform: translateX(0);
