---
import { Image } from "astro:assets";
import heroImage from "../pages/assets/hero.webp";
import heroImageSp from "../pages/assets/hero-sp.webp";
import heroImageTb from "../pages/assets/hero-tb.webp";

import titleTextImg from "../pages/assets/title-text.webp";
import komafesLabel from "../pages/assets/komafesLabel.webp";
import topLogoImg from "../pages/assets/topLogo.webp";
import mainLogoImg from "../pages/assets/Komafes69Logo.webp";
import hatImg from "../pages/assets/hat.webp";
import maintypoImg from "../pages/assets/typo.png";

import instagramIcon from "../pages/assets/Instagram.svg";
import youtubeIcon from "../pages/assets/youtube.svg";
import xIcon from "../pages/assets/X.svg";

import scrollIcon from "../pages/assets/scroll.svg";

import logoImg from "../pages/assets/logo.svg";
import typoImg from "../pages/assets/typo.svg";
import titleBackgroundDark from "../pages/assets/TitleBackgroundDark.webp";
import titleBackgroundBlack from "../pages/assets/TitleBackgroundBlack.jpg";

import LogImage from "../pages/assets/Log.webp";
import OceanImage from "../pages/assets/Ocean.webp";

const pageTitle = "トップページ | Komafes69";
const pageDescription =
  "駒場東邦 第69回 文化祭「SAIL BEYOND」の公式サイトです。開催日時：9月19日(土)・20日(日) 9:00〜16:30。テーマや各展示、タイムテーブル、マップなどの最新情報を掲載しています。";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>

    <meta name="description" content={pageDescription} />

    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@500;700;900&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@500;700;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Pinyon+Script&family=Shippori+Mincho:wght@600;800&family=Cinzel:wght@700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Sail Beyond" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body id="top">
    <!-- ========================================
         スマホ用 メニュー (中身)
         ======================================== -->
    <nav id="mobile-menu" class="mobile-nav">
      <ul>
        <li><a href="/">TOP</a></li>
        <li><a href="/theme">THEME</a></li>
        <li><a href="/exhibition">EXHIBITION</a></li>
        <li><a href="/articles">ARTICLES</a></li>
        <li><a href="/timetable">TIME TABLE</a></li>
        <li><a href="/map">MAP</a></li>
        <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
      </ul>
      <div class="mobile-sns-links">
        <a
          href="https://www.instagram.com/komafes69/"
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={instagramIcon.src} alt="" class="sns-icon" />
          <span>Instagram</span>
        </a>
        <a
          href="https://www.youtube.com/@komafes68"
          aria-label="YouTube"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={youtubeIcon.src} alt="" class="sns-icon" />
          <span>YouTube</span>
        </a>
        <a
          href="https://x.com/Komafes68"
          aria-label="X"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={xIcon.src} alt="" class="sns-icon" />
          <span>X</span>
        </a>
      </div>
    </nav>

    <!-- ========================================
         PC・タブレット・スマホ兼用 ヘッダー
         ======================================== -->
    <header class="sticky-header">
      <div class="sticky-header-inner">
        <!-- 左側: ロゴとタイポ -->
        <a href="/" class="header-brand">
          <img src={logoImg.src} alt="Komafes69 Logo" class="header-logo" />
          <img src={typoImg.src} alt="SAIL BEYOND" class="header-typo" />
        </a>

        <!-- 右側: PCナビゲーション ＆ スマホハンバーガー -->
        <div class="header-right">
          <nav class="header-nav">
            <ul>
              <li><a href="/">TOP</a></li>
              <li><a href="/theme">THEME</a></li>
              <li><a href="/exhibition">EXHIBITION</a></li>
              <li><a href="/articles">ARTICLES</a></li>
              <li><a href="/timetable">TIME TABLE</a></li>
              <li><a href="/map">MAP</a></li>
              <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
            </ul>
          </nav>

          <!-- ハンバーガーボタンをヘッダー内に移動 -->
          <button
            class="hamburger"
            aria-label="メニューを開く"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </button>
        </div>
      </div>
    </header>

    <!-- ========================================
         Hero セクション
         ======================================== -->
    <section class="hero">
      <img
        src={heroImage.src}
        alt="トップページの背景画像です"
        loading="eager"
        fetchpriority="high"
        class="hero-bg pc-bg"
      />

      <img
        src={heroImageSp.src}
        alt="スマホ用トップページの背景画像"
        loading="eager"
        fetchpriority="high"
        class="hero-bg sp-bg"
      />

      <img
        src={heroImageTb.src}
        alt="タブレット用トップページの背景画像"
        loading="eager"
        fetchpriority="high"
        class="hero-bg tb-bg"
      />

      <div class="top-logo">
        <img src={topLogoImg.src} alt="Komafes69" class="top-logo-img" />
      </div>

      <div class="signal-flags">
        <!-- PC用ロープ -->
        <svg
          class="rope-svg pc-rope"
          viewBox="0 0 420 120"
          preserveAspectRatio="none"
        >
          <path
            d="M 100 -10 Q 150 110 430 100"
            fill="none"
            stroke="#fff"
            stroke-width="2.5"></path>
        </svg>
        <!-- スマホ用ロープ（右上の空きスペースにコンパクトに収める） -->
        <svg
          class="rope-svg sp-rope"
          viewBox="0 0 240 120"
          preserveAspectRatio="none"
        >
          <path
            d="M 80 0 Q 170 200 400 150"
            fill="none"
            stroke="#fff"
            stroke-width="1.5"></path>
        </svg>

        <div class="flags-container">
          <div class="flag"><img src="/flags/K.svg" alt="K" /></div>
          <div class="flag"><img src="/flags/O.svg" alt="O" /></div>
          <div class="flag"><img src="/flags/M.svg" alt="M" /></div>
          <div class="flag"><img src="/flags/A.svg" alt="A" /></div>
          <div class="flag"><img src="/flags/F.svg" alt="F" /></div>
          <div class="flag"><img src="/flags/E.svg" alt="E" /></div>
          <div class="flag"><img src="/flags/S.svg" alt="S" /></div>
        </div>
      </div>
      <div class="main-logo-container">
        <img
          src={mainLogoImg.src}
          alt="Komafes 69 SAIL BEYOND"
          class="main-logo-img"
        />
        <div class="hat-container">
          <img src={hatImg.src} alt="Komafes 帽子" class="hat-img" />
        </div>
      </div>

      <div class="typo-container">
        <img src={maintypoImg.src} alt="SAIL BEYOND" class="typo-img" />
      </div>

      <div class="hero-title-container">
        <img
          src={titleTextImg.src}
          alt="駒場東邦 第69回 文化祭"
          class="hero-title-img"
        />
      </div>

      <div class="komafesLabel">
        <img
          src={komafesLabel.src}
          alt="Komafes69ラベル"
          class="komafes-label-img"
        />
      </div>

      <div class="date-info">
        <div class="date-row">
          <span class="num">9.19</span><span class="day">(SAT.)</span>
        </div>
        <div class="date-row separator">
          <span class="dash">—</span>
          <span class="num">9.20</span><span class="day">(SUN.)</span>
        </div>
        <div class="time-row">
          <span class="time">[ 9:00 - 16:30 ]</span>
        </div>
      </div>

      <div class="scroll-animation">
        <span class="scroll-text">SCROLL</span>
        <div class="scroll-line"></div>
        <img src={scrollIcon.src} alt="Scroll Animation" class="scroll-icon" />
      </div>

      <nav class="right-nav">
        <ul>
          <li><a href="/">TOP</a></li>
          <li><a href="/theme">THEME</a></li>
          <li><a href="/exhibition">EXHIBITION</a></li>
          <li><a href="/articles">ARTICLES</a></li>
          <li><a href="/timetable">TIME TABLE</a></li>
          <li><a href="/map">MAP</a></li>
          <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
        </ul>

        <div class="sns-links">
          <a
            href="https://www.instagram.com/komafes69/"
            aria-label="Instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={instagramIcon.src} alt="" class="sns-icon" />
            <span>Instagram</span>
          </a>
          <a
            href="https://www.youtube.com/@komafes68"
            aria-label="YouTube"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={youtubeIcon.src} alt="" class="sns-icon" />
            <span>YouTube</span>
          </a>
          <a
            href="https://x.com/Komafes68"
            aria-label="X"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={xIcon.src} alt="" class="sns-icon" />
            <span>X</span>
          </a>
        </div>
      </nav>
    </section>

    <div
      class="marquee-container"
      style={`background-image: url('${titleBackgroundBlack.src}'); background-size: cover; background-position: center;`}
    >
      <div class="marquee-track">
        <!-- CSSアニメーションでループさせるため、同じ内容を2つ並べます -->
        <span class="marquee-text"
          >KOMAFES69 KOMAFES69 KOMAFES69 KOMAFES69 KOMAFES69</span
        >
        <span class="marquee-text"
          >KOMAFES69 KOMAFES69 KOMAFES69 KOMAFES69 KOMAFES69</span
        >
      </div>
    </div>

    <!-- ========================================
         CAPTAIN'S LOG セクション
         ======================================== -->

    <section
      class="captains-log-section"
      style={`background-image: url('${OceanImage.src}');`}
    >
      <div class="section-label">COUNT DOWN</div>

      <div class="log-paper" style={`--bg-log: url('${LogImage.src}');`}>
        <div class="log-container" id="log-book-content">
          <!-- 上のページ（スマホ時）：ミッション情報 -->
          <div class="log-page">
            <h2 class="log-title write-effect delay-1">Captain's Log</h2>
            <div class="log-entry">
              <p class="write-effect delay-2">
                <strong>ETA:</strong> Sep 19, 2026 / 09:00 JST
              </p>
              <p class="write-effect delay-3">
                <strong>Mission:</strong> SAIL BEYOND
              </p>
              <p class="write-effect delay-4">
                <strong>Destination:</strong><br />
                <span class="jp-text">駒場東邦中学校・高等学校</span>
              </p>
              <p class="write-effect delay-5">
                <strong>Coordinates:</strong> 35° 39' 14" N, 139° 40' 57" E
              </p>
              <p class="write-effect delay-6">
                <strong>Status:</strong> Full Speed Ahead.
              </p>
              <p class="write-effect delay-7">
                <strong>Tag:</strong> Komafes69
              </p>
            </div>
          </div>

          <!-- 下のページ（スマホ時）：カウントダウン / ステータス -->
          <div class="log-page">
            <div class="countdown-wrapper write-effect delay-8">
              <h3 class="countdown-title" id="countdown-title">
                文化祭開催まで
              </h3>

              <div class="countdown-timer" id="komafes-countdown">
                <div class="time-box">
                  <span id="countdown-days">00</span>
                  <span class="time-label">DAYS</span>
                </div>
                <div class="time-box">
                  <span id="countdown-hours">00</span>
                  <span class="time-label">HRS</span>
                </div>
                <div class="time-box">
                  <span id="countdown-minutes">00</span>
                  <span class="time-label">MIN</span>
                </div>
                <div class="time-box">
                  <span id="countdown-seconds">00</span>
                  <span class="time-label">SEC</span>
                </div>
              </div>

              <div class="event-status-text" id="event-status"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================
         ACCESS セクション
         ======================================== -->
    <section class="access-section" id="access">
      <div class="access-inner">
        <!-- タイトル -->
        <div class="access-header">
          <div class="access-label-wrapper">
            <h2 class="access-title">ACCESS</h2>
          </div>
          <p class="access-subtitle">会場へのアクセス</p>
        </div>

        <div class="access-content">
          <!-- 左側：情報エリア -->
          <div class="access-info">
            <div class="access-address-box">
              <h3 class="access-school-name">駒場東邦中学校・高等学校</h3>
              <p class="access-address-text">
                〒154-0001 東京都世田谷区池尻4-5-1
              </p>
            </div>

            <div class="route-list">
              <!-- ルート1：田園都市線 -->
              <div class="route-item">
                <div class="route-icon-wrapper">
                  <!-- 丸い枠を廃止し、電車アイコンを直接配置 -->
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="train-icon"
                  >
                    <rect x="4" y="3" width="16" height="16" rx="2"></rect>
                    <path d="M4 11h16"></path>
                    <path d="M12 3v8"></path>
                    <path d="M8 19l-2 3"></path>
                    <path d="M18 22l-2-3"></path>
                    <circle cx="9" cy="15" r="1"></circle>
                    <circle cx="15" cy="15" r="1"></circle>
                  </svg>
                </div>
                <div class="route-details">
                  <span class="line-name">東急田園都市線</span>
                  <span class="station-name"
                    >「池尻大橋」駅 <span class="walk-time">徒歩10分</span
                    ></span
                  >
                </div>
              </div>

              <!-- ルート2：井の頭線 -->
              <div class="route-item">
                <div class="route-icon-wrapper">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="train-icon"
                  >
                    <rect x="4" y="3" width="16" height="16" rx="2"></rect>
                    <path d="M4 11h16"></path>
                    <path d="M12 3v8"></path>
                    <path d="M8 19l-2 3"></path>
                    <path d="M18 22l-2-3"></path>
                    <circle cx="9" cy="15" r="1"></circle>
                    <circle cx="15" cy="15" r="1"></circle>
                  </svg>
                </div>
                <div class="route-details">
                  <span class="line-name">京王井の頭線</span>
                  <span class="station-name"
                    >「駒場東大前」駅 <span class="walk-time">徒歩10分</span
                    ></span
                  >
                </div>
              </div>
            </div>

            <div class="access-map-wrapper access-map-mobile">
              <iframe
                src="https://www.google.com/maps?q=%E9%A7%92%E5%A0%B4%E6%9D%B1%E9%82%A6%E4%B8%AD%E5%AD%A6%E6%A0%A1%E3%83%BB%E9%AB%98%E7%AD%89%E5%AD%A6%E6%A0%A1%2C%20%E6%9D%B1%E4%BA%AC%E9%83%BD%E4%B8%96%E7%94%B0%E8%B0%B7%E5%8C%BA%E6%B1%A0%E5%B0%BB4-5-1&output=embed"
                title="駒場東邦中学校・高等学校の地図"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
              <div class="map-overlay-frame"></div>
            </div>

            <div class="access-notice">
              <p>※ご来場の際は公共交通機関をご利用ください。</p>
              <p>※近隣店舗等への無断駐車・駐輪は固くお断りいたします。</p>
            </div>
          </div>

          <!-- 右側：Googleマップ (海図・夜の海風フィルター) -->
          <div class="access-map-wrapper">
            <iframe
              src="https://www.google.com/maps?q=%E9%A7%92%E5%A0%B4%E6%9D%B1%E9%82%A6%E4%B8%AD%E5%AD%A6%E6%A0%A1%E3%83%BB%E9%AB%98%E7%AD%89%E5%AD%A6%E6%A0%A1%2C%20%E6%9D%B1%E4%BA%AC%E9%83%BD%E4%B8%96%E7%94%B0%E8%B0%B7%E5%8C%BA%E6%B1%A0%E5%B0%BB4-5-1&output=embed"
              title="駒場東邦中学校・高等学校の地図"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            >
            </iframe>
            <!-- マップ上の装飾用フレーム -->
            <div class="map-overlay-frame"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================
         EXHIBITION セクション
         ======================================== -->
    <section class="exhibition-section">
      <div class="exhibition-header">
        <div class="exhibition-title-group">
          <!-- ラベル風のタイトル -->
          <div class="exhibition-label-wrapper">
            <h2 class="exhibition-title">EXHIBITIONS</h2>
          </div>
          <p class="exhibition-subtitle">お気に入りの団体を探そう！</p>
        </div>
      </div>

      <!-- 画像帯（カルーセル） -->
      <div
        class="exhibition-carousel-wrapper"
        style={`background-image: url('${titleBackgroundDark.src}'); background-size: cover; background-position: center;`}
      >
        <div class="exhibition-track" id="exhibitionTrack">
          <!-- JavaScriptで平行四辺形カードが追加されます -->
        </div>

        <a href="/exhibition" class="btn-exhibition-floating">
          <span class="btn-text">団体を詳しく見る</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </section>

    <!-- ========================================
     SNS セクション
     ======================================== -->
    <section class="sns-section">
      <div class="sns-inner">
        <!-- ヘッダーエリア (ACCESSセクションと完全にトーンを一致) -->
        <div class="sns-header">
          <div class="sns-label-wrapper">
            <h2 class="sns-title">OFFICIAL SNS</h2>
          </div>
          <p class="sns-subtitle">公式SNS・最新情報はこちら</p>
        </div>
        <!-- SNSカードリスト -->
        <div class="sns-content">
          <!-- Instagram -->
          <a
            href="https://instagram.com/komafes69"
            target="_blank"
            rel="noopener noreferrer"
            class="sns-card instagram"
          >
            <div class="sns-card-left">
              <div class="sns-icon-wrapper">
                <!-- Instagram Icon -->
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                  ></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </div>
              <div class="sns-info">
                <div class="sns-name-group">
                  <span class="sns-name">Instagram</span>
                  <span class="sns-id">@komafes69</span>
                </div>
                <p class="sns-description">
                  各参加団体の紹介動画や準備風景、各種情報を投稿中！
                </p>
              </div>
            </div>
            <div class="sns-arrow">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>

          <!-- YouTube (または LINE や TikTok 等に書き換え可) -->
          <a
            href="https://www.youtube.com/@komafes68"
            target="_blank"
            rel="noopener noreferrer"
            class="sns-card youtube"
          >
            <div class="sns-card-left">
              <div class="sns-icon-wrapper">
                <!-- YouTube Icon -->
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
