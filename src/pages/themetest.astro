---
import { Image } from "astro:assets";
import mainLogoImg from "../pages/assets/Komafes69Logo.webp";

import instagramIcon from "../pages/assets/Instagram.svg";
import youtubeIcon from "../pages/assets/youtube.svg";
import xIcon from "../pages/assets/X.svg";

import logoImg from "../pages/assets/logo.svg";
import typoImg from "../pages/assets/typo.svg";

import vintageback from "../pages/assets/vintageback.webp";
import shipImg from "../pages/assets/ship.webp";

// === 装飾画像のインポート ===
import lifebuoyImg from "../pages/assets/lifebuoy.webp"; // 浮き輪
import ribbonImg from "../pages/assets/ship_orizzonte_ribbon.webp"; // SHIP ORIZZONTE 看板
import anchorImg from "../pages/assets/anchor.webp"; // 錨
import textDecorImg from "../pages/assets/text_decor.webp"; // 右側テキスト上の装飾
import titleBackgroundDark from "../pages/assets/TitleBackgroundDark.webp";
import titleBackgroundBlack from "../pages/assets/TitleBackgroundBlack.jpg";

const pageTitle = "テーマ紹介 | 第69回 駒場東邦文化祭 | SAIL BEYOND";
const pageDescription =
  "2026 駒場東邦中学高等学校 第69回文化祭「SAIL BEYOND」の公式サイトです。開催日時：2026年 9月19日(土)・20日(日) 9:00〜16:30。今年の文化祭のテーマについて紹介します。";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>

    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="駒場東邦,駒場東邦文化祭,駒東,駒東文化祭,2026年,Komafes69,SAIL BEYOND"
    />

    <link rel="canonical" href="https://69.komafes.jp/" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://69.komafes.jp/" />
    <meta property="og:image" content="https://69.komafes.jp/ogp.png" />
    <meta property="og:image:width" content="3406" />
    <meta property="og:image:height" content="1884" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href={mainLogoImg.src} />

    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Noto+Sans+JP:wght@500;700;900&family=Pinyon+Script&family=Shippori+Mincho:wght@600;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Noto+Sans+JP:wght@500;700;900&family=Pinyon+Script&family=Shippori+Mincho:wght@600;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Shippori+Mincho:wght@600;800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/icon.ico" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Sail Beyond" />
  </head>

  <body id="top">
    <!-- ローディング画面 -->
    <div id="loading-screen">
      <div class="loader-logo-container">
        <img src={mainLogoImg.src} alt="Loading..." class="loader-logo-img" />
        <p class="loader-text">Loading...</p>
      </div>
    </div>

    <!-- スマホ用 メニュー -->
    <nav id="mobile-menu" class="mobile-nav">
      <ul>
        <li><a href="/">TOP</a></li>
        <li><a href="/theme">THEME</a></li>
        <li><a href="/exhibition">EXHIBITION</a></li>
        <li><a href="/articles">ARTICLES</a></li>
        <li><a href="/timetable">TIME TABLE</a></li>
        <li><a href="/map">MAP</a></li>
        <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
      </ul>
      <div class="mobile-sns-links">
        <a
          href="https://www.instagram.com/komafes69/"
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={instagramIcon.src} alt="" class="sns-icon" />
          <span>Instagram</span>
        </a>
        <a
          href="https://www.youtube.com/@komafes69"
          aria-label="YouTube"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={youtubeIcon.src} alt="" class="sns-icon" />
          <span>YouTube</span>
        </a>
        <a
          href="https://x.com/Komafes69"
          aria-label="X"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={xIcon.src} alt="" class="sns-icon" />
          <span>X</span>
        </a>
      </div>
    </nav>

    <!-- ヘッダー -->
    <header class="sticky-header is-show">
      <div class="sticky-header-inner">
        <a href="/" class="header-brand">
          <img src={logoImg.src} alt="Komafes69 Logo" class="header-logo" />
          <img src={typoImg.src} alt="SAIL BEYOND" class="header-typo" />
        </a>

        <div class="header-right">
          <nav class="header-nav">
            <ul>
              <li><a href="/">TOP</a></li>
              <li><a href="/theme">THEME</a></li>
              <li><a href="/exhibition">EXHIBITION</a></li>
              <li><a href="/articles">ARTICLES</a></li>
              <li><a href="/timetable">TIME TABLE</a></li>
              <li><a href="/map">MAP</a></li>
              <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
            </ul>
          </nav>

          <button
            class="hamburger is-black"
            aria-label="メニューを開く"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </button>
        </div>
      </div>
    </header>

    <div class="theme-wrapper">
      <img src={vintageback.src} alt="背景画像" class="theme-bg" />

      <div class="theme-layout">
        <!-- 左側：船（スクロール時画面固定） -->
        <div class="theme-left">
          <div class="ship-container">
            <!-- 装飾パーツ -->
            <img
              src={lifebuoyImg.src}
              alt=""
              class="decor-item decor-lifebuoy"
            />
            <img
              src={ribbonImg.src}
              alt="SHIP ORIZZONTE"
              class="decor-item decor-ribbon"
            />

            <img src={shipImg.src} alt="オリゾンテ号" class="ship-img" />

            <!-- 装飾パーツ -->
            <img src={anchorImg.src} alt="" class="decor-item decor-anchor" />
          </div>
        </div>

        <!-- 右側：テキストエリア -->
        <div class="theme-right">
          <div class="theme-header js-fade-chunk">
            <h2 class="theme-title">THEME</h2>
          </div>

          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="古い航海記録には、時折こんな記述が残されている。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="「地平線の彼方から現れ、次の瞬間、再び地平線の向こうへと消えていく船」"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p class="typewriter-text" data-text="その船の名は、オリゾンテ号。">
            </p>
            <p class="typewriter-text" data-text="いつ、どこで造られたのか。">
            </p>
            <p class="typewriter-text" data-text="誰が最初の船長だったのか。">
            </p>
            <p
              class="typewriter-text"
              data-text="今となっては、それを知る者はいない。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="ただ、この港がまだ小さな寄港地だった頃から、幾度となくこの地に姿を現していたという。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="やがて、その姿を追う船たちが現れた。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="しかし、航海は決して穏やかなものではなかった。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="激しい嵐や深い霧の中で、多くの船がその航跡を見失っていった。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="それでも、水平線の向こうにあるまだ見ぬ世界を信じ、夢と希望を見失わなかった船たちは、オリゾンテ号を追い続けた。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="そして彼らが辿り着いたのが、この港だった。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="そこへやって来た船たちは、それぞれ異なる海、異なる世界から来ていた。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="船の形も、歩んできた航路も違う。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="それぞれが、自らの文化や知識、技術、経験をこの地へ持ち寄った。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="新たな船がやって来るたび、新たな建物が生まれ、新たな技術や物語が加わっていく。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="そうしてこの場所は、いつしか一つの世界だけでは語ることのできない、様々な世界観が集まり、共存する不思議な港へと姿を変えていった。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="港では、人々が互いの航海について語り合う。"
            >
            </p>
            <p class="typewriter-text" data-text="ある者の知識が誰かを助け、">
            </p>
            <p
              class="typewriter-text"
              data-text="ある船の経験が、別の船の次の航海への道しるべとなる。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="書籍や記憶、日々の言葉が集まり、"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="新たな地平線を目指すための力となっていく。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="そして人々は、この港で得たものを携え、再びそれぞれの海へと旅立っていく。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="まだ見たことのない景色を求めて。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="まだ知らない世界と出会うために。"
            >
            </p>
          </div>
          <div class="text-chunk">
            <p
              class="typewriter-text"
              data-text="目の前に広がる水平線は、世界の終わりではない。"
            >
            </p>
            <p
              class="typewriter-text"
              data-text="その向こうには、まだ見ぬ海が続いている。"
            >
            </p>
          </div>
          <div class="text-chunk-last">
            <p class="typewriter-text" data-text="夢と希望を帆に受けて、"></p>
            <p class="typewriter-text" data-text="水平線を越え、その先へ。"></p>
            <p class="typewriter-text fw-bold" data-text="Sail Beyond."></p>
          </div>
        </div>
      </div>
    </div>
    <footer
      class="footer"
      style={`background-image: url('${titleBackgroundBlack.src}'); background-size: cover; background-position: center;`}
    >
      <div class="footer-inner">
        <!-- 左側：学校情報・アクセス -->
        <div class="footer-info">
          <p class="school-name">駒場東邦中学校・高等学校 第69回 文化祭</p>
          <!-- SVGロゴを使用 -->
          <a href="/" class="footer-brand">
            <img src={logoImg.src} alt="Komafes69 Logo" class="footer-logo" />
            <img src={typoImg.src} alt="SAIL BEYOND" class="footer-typo" />
          </a>

          <div class="school-details">
            <p><strong>開催日時：</strong>9月19日(土)・20日(日) 9:00〜16:30</p>
            <p><strong>所在地：</strong>〒154-0001 東京都世田谷区池尻4-5-1</p>
            <p class="access-info">
              東急田園都市線「池尻大橋」駅より徒歩10分<br />
              京王井の頭線「駒場東大前」駅より徒歩10分
            </p>
          </div>
        </div>

        <!-- 右側：ミニサイトマップとSNS -->
        <div class="footer-nav">
          <ul class="sitemap">
            <li><a href="/">TOP</a></li>
            <li><a href="/theme">THEME</a></li>
            <li><a href="/exhibition">EXHIBITION</a></li>
            <li><a href="/articles">ARTICLES</a></li>
            <li><a href="/timetable">TIME TABLE</a></li>
            <li><a href="/map">MAP</a></li>
            <li><a href="https://archives.komafes.jp/">ARCHIVES</a></li>
          </ul>

          <div class="footer-sns">
            <a
              href="https://www.instagram.com/komafes69/"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={instagramIcon.src}
                alt="Instagram"
                class="footer-sns-icon"
              />
            </a>
            <a
              href="https://www.youtube.com/@komafes69"
              aria-label="YouTube"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={youtubeIcon.src}
                alt="YouTube"
                class="footer-sns-icon"
              />
            </a>
            <a
              href="https://x.com/Komafes69"
              aria-label="X"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src={xIcon.src} alt="X" class="footer-sns-icon" />
            </a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; 2026 Komafes69 All Rights Reserved.</p>
      </div>
    </footer>
  </body>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // ==========================================
    // 1. ローディング画面の処理
    // ==========================================
    const wheelRotation = gsap.to(".loader-logo-img", {
      rotation: "+=360",
      duration: 2,
      repeat: -1,
      ease: "power1.inOut",
    });
    const MIN_LOADING_TIME = 1000;
    const minWaitPromise = new Promise<void>((resolve) =>
      setTimeout(resolve, MIN_LOADING_TIME),
    );
    const pageLoadPromise = new Promise<void>((resolve) => {
      if (document.readyState === "complete") resolve();
      else window.addEventListener("load", () => resolve(), { once: true });
    });

    Promise.all([minWaitPromise, pageLoadPromise]).then(() => {
      const tl = gsap.timeline();
      tl.to("#loading-screen", {
        opacity: 0,
        duration: 0.6,
        ease: "power2.out",
        onComplete: () => {
          const loader = document.getElementById("loading-screen");
          if (loader) loader.style.display = "none";
          wheelRotation.kill();
          initThemeAnimation();
        },
      });
    });

    // ==========================================
    // 2. ヘッダー関連の処理
    // ==========================================
    const initHeader = () => {
      const hamburger = document.querySelector(".hamburger");
      const mobileNav = document.querySelector(".mobile-nav");

      if (hamburger && mobileNav) {
        hamburger.addEventListener("click", () => {
          const isActive = hamburger.classList.toggle("is-active");
          mobileNav.classList.toggle("is-active", isActive);
          document.body.classList.toggle("no-scroll", isActive);
          hamburger.setAttribute("aria-expanded", isActive ? "true" : "false");
        });
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHeader);
    } else {
      initHeader();
    }

    // ==========================================
    // 3. Themeページのスクロール ＆ 各種アニメーション
    // ==========================================
    const initThemeAnimation = () => {
      // --- A. 左側：船の画像と装飾パーツのタイムラインアニメーション ---
      const shipTl = gsap.timeline({
        scrollTrigger: {
          trigger: ".theme-left",
          start: "top 80%",
          once: true,
        },
      });

      // 船本体の出現
      shipTl
        .to(".ship-img", {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          opacity: 1,
          scale: 1,
          duration: 1.5,
          ease: "power2.out",
        })
        // 装飾パーツ（浮き輪・看板・錨）が順番に出現
        .to(
          ".decor-item",
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.8,
            stagger: 0.15,
            ease: "back.out(1.5)",
          },
          "-=0.5",
        );

      // --- B. 右側：ヘッダー見出し・装飾のフェードイン ---
      const fadeChunks = gsap.utils.toArray(".js-fade-chunk");
      fadeChunks.forEach((chunk: any) => {
        gsap.to(chunk, {
          scrollTrigger: {
            trigger: chunk,
            start: "top 85%",
            once: true,
          },
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: "power2.out",
        });
      });

      // --- C. 右側：タイプライター演出 ---
      const typeText = (element: HTMLElement) => {
        if (element.classList.contains("typed")) return;

        element.classList.add("typed");
        element.classList.add("cursor");

        const fullText = element.getAttribute("data-text") || "";
        let currentIndex = 0;
        element.textContent = "";

        const interval = setInterval(() => {
          if (currentIndex < fullText.length) {
            element.textContent += fullText[currentIndex];
            currentIndex++;
          } else {
            clearInterval(interval);
            element.classList.remove("cursor");
          }
        }, 40);
      };

      const typeChunks = gsap.utils.toArray(".typewriter-text");
      typeChunks.forEach((chunk: any) => {
        ScrollTrigger.create({
          trigger: chunk,
          start: "top 60%",
          once: true,
          onEnter: () => typeText(chunk as HTMLElement),
        });
      });
    };
  </script>

  <style>
    body {
      font-family:
        "Noto Sans JP",
        system-ui,
        -apple-system,
        sans-serif;
      margin: 0;
      padding: 0;
      background-color: #000;
    }

    body.no-scroll {
      overflow: hidden;
    }

    /* ローディング画面 */
    #loading-screen {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: #101011;
      z-index: 9999;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .loader-logo-container {
      width: 140px;
      height: 140px;
      max-width: 50vw;
      max-height: 50vw;
    }

    .loader-logo-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .loader-text {
      color: #fff;
      font-family: "Bebas Neue", cursive;
      font-size: 1.4rem;
      margin-top: 1rem;
      text-align: center;
    }

    /* スティッキーヘッダー */
    .sticky-header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      padding: 0.8rem 0;
      opacity: 1; /* 初期状態から表示 */
      pointer-events: auto; /* クリック操作を可能に */
      transition:
        opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1),
        background-color 0.3s ease;
    }

    .sticky-header,
    .sticky-header-inner {
      box-sizing: border-box;
    }

    .sticky-header-inner {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 1.5rem;
    }

    .header-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      transition: opacity 0.2s ease;
    }

    .header-brand:hover {
      opacity: 0.7;
    }

    .header-logo {
      height: 40px;
      width: auto;
      object-fit: contain;
      filter: brightness(0);
    }

    .header-typo {
      height: 20px;
      width: auto;
      object-fit: contain;
      filter: brightness(0);
    }

    .header-nav ul {
      display: flex;
      gap: clamp(1rem, 2vw, 2.5rem);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .header-nav a {
      color: #111111;
      text-decoration: none;
      font-family: "Bebas Neue", cursive;
      font-size: clamp(0.95rem, 1.2vw, 1.15rem);
      letter-spacing: 0.12em;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    .header-nav a:hover {
      opacity: 0.6;
      transform: translateY(-1px);
    }

    .header-right {
      display: flex;
      align-items: center;
    }

    .hamburger,
