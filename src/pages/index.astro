  <!-- ========================================
         JavaScript 統合処理
         ======================================== -->
  <script>
    import { gsap } from "gsap";

    const initApp = () => {
      // --- 1. スクロール検知で手書きアニメーション発火 ---
      const logBook = document.getElementById("log-book-content");
      if (logBook) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                logBook.classList.add("is-animated");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2 },
        );

        observer.observe(logBook);
      }

      // --- 2. カウントダウン & イベント状態自動判定 ---
      const startDate = new Date("2026-09-19T09:00:00+09:00").getTime();
      const endDate = new Date("2026-09-20T17:00:00+09:00").getTime();

      const timerEl = document.getElementById("komafes-countdown");
      const titleEl = document.getElementById("countdown-title");
      const statusEl = document.getElementById("event-status");

      const daysEl = document.getElementById("countdown-days");
      const hoursEl = document.getElementById("countdown-hours");
      const minutesEl = document.getElementById("countdown-minutes");
      const secondsEl = document.getElementById("countdown-seconds");

      function updateCountdown() {
        const now = new Date().getTime();

        if (now < startDate) {
          // 開催前
          const distance = startDate - now;
          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor(
            (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
          );
          const minutes = Math.floor(
            (distance % (1000 * 60 * 60)) / (1000 * 60),
          );
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          if (daysEl) daysEl.textContent = String(days).padStart(2, "0");
          if (hoursEl) hoursEl.textContent = String(hours).padStart(2, "0");
          if (minutesEl)
            minutesEl.textContent = String(minutes).padStart(2, "0");
          if (secondsEl)
            secondsEl.textContent = String(seconds).padStart(2, "0");
        } else if (now >= startDate && now <= endDate) {
          // 開催中
          if (titleEl) titleEl.style.display = "none";
          if (timerEl) timerEl.style.display = "none";
          if (statusEl) {
            statusEl.style.display = "block";
            statusEl.textContent = "本日開催中！";
          }
        } else {
          // 終了後
          if (titleEl) titleEl.style.display = "none";
          if (timerEl) timerEl.style.display = "none";
          if (statusEl) {
            statusEl.style.display = "block";
            statusEl.textContent = "Komafes69は終了しました";
          }
        }
      }

      updateCountdown();
      window.setInterval(updateCountdown, 1000);

      // --- 3. GSAP アニメーション (Hero) ---
      gsap.fromTo(
        ".top-logo-img",
        { clipPath: "inset(0 0 100% 0)", opacity: 1 },
        {
          clipPath: "inset(0 0 0% 0)",
          duration: 0.8,
          ease: "power2.out",
          delay: 0.1,
        },
      );
      gsap.fromTo(
        ".main-logo-img",
        { scale: 0.85, rotation: -140, opacity: 0 },
        {
          scale: 1,
          rotation: 0,
          opacity: 1,
          duration: 1.2,
          ease: "back.out(1.2)",
          delay: 0.4,
        },
      );
      gsap.fromTo(
        ".hat-img",
        {
          xPercent: 120,
          yPercent: -90,
          rotation: 35,
          scale: 1.15,
          opacity: 0,
        },
        {
          xPercent: 0,
          yPercent: 0,
          rotation: 0,
          scale: 1,
          opacity: 1,
          duration: 1.1,
          ease: "power3.out",
          delay: 0.9,
          onComplete: startPeriodicAndInteractiveEffects,
        },
      );
      gsap.fromTo(
        ".typo-img",
        { y: 20, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.9, ease: "power2.out", delay: 0.8 },
      );
      gsap.fromTo(
        ".hero-title-img",
        { clipPath: "inset(0 100% 0 0)", opacity: 1 },
        {
          clipPath: "inset(0 0% 0 0)",
          duration: 0.8,
          ease: "power2.out",
          delay: 0.3,
        },
      );
      gsap.fromTo(
        ".komafes-label-img",
        { clipPath: "inset(0 100% 0 0)", opacity: 1 },
        {
          clipPath: "inset(0 0% 0 0)",
          duration: 0.8,
          ease: "power2.out",
          delay: 0.45,
        },
      );
      gsap.fromTo(
        ".date-info",
        { clipPath: "inset(0 100% 0 0)", opacity: 1 },
        {
          clipPath: "inset(0 0% 0 0)",
          duration: 0.8,
          ease: "power2.out",
          delay: 0.6,
        },
      );
      gsap.fromTo(
        ".right-nav",
        { x: 20, opacity: 0 },
        { x: 0, opacity: 1, duration: 0.8, ease: "power2.out", delay: 0.5 },
      );
      gsap.fromTo(
        ".scroll-animation",
        { opacity: 0, y: 0 },
        { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 1.0 },
      );

      gsap.to(".scroll-line", {
        height: "40%",
        duration: 2,
        ease: "power1.inOut",
        repeat: -1,
        yoyo: true,
      });

      function startPeriodicAndInteractiveEffects() {
        function playHatFlip() {
          return gsap
            .timeline()
            .to(".hat-img", {
              yPercent: -70,
              xPercent: 70,
              rotation: "+=30",
              scale: 1.3,
              duration: 0.55,
              ease: "power2.out",
            })
            .to(".hat-img", {
              yPercent: 0,
              xPercent: 0,
              rotation: "+=330",
              scale: 1,
              duration: 0.95,
              ease: "power2.inOut",
            });
        }

        const loopTimeline = gsap.timeline({ repeat: -1, repeatDelay: 3.0 });
        loopTimeline
          .to(
            ".main-logo-img",
            { rotation: "+=360", duration: 1.5, ease: "power2.inOut" },
            0,
          )
          .add(playHatFlip(), 0);

        const logoContainer = document.querySelector(".main-logo-container");
        if (logoContainer) {
          logoContainer.addEventListener("mouseenter", () => {
            gsap.to(".main-logo-container", {
              scale: 1.05,
              duration: 0.3,
              ease: "power2.out",
            });
          });
          logoContainer.addEventListener("mouseleave", () => {
            gsap.to(".main-logo-container", {
              scale: 1,
              duration: 0.3,
              ease: "power2.inOut",
            });
          });
        }
      }

      // --- 4. スマホ用ハンバーガーメニュー制御 ---
      const hamburger = document.querySelector(".hamburger");
      const mobileNav = document.querySelector(".mobile-nav");
      const mobileLinks = document.querySelectorAll(".mobile-nav a");

      if (hamburger && mobileNav) {
        hamburger.addEventListener("click", () => {
          const isActive = hamburger.classList.contains("is-active");
          if (isActive) {
            hamburger.classList.remove("is-active");
            mobileNav.classList.remove("is-active");
            hamburger.setAttribute("aria-expanded", "false");
            document.body.classList.remove("no-scroll");
          } else {
            hamburger.classList.add("is-active");
            mobileNav.classList.add("is-active");
            hamburger.setAttribute("aria-expanded", "true");
            document.body.classList.add("no-scroll");
          }
        });

        mobileLinks.forEach((link) => {
          link.addEventListener("click", () => {
            hamburger.classList.remove("is-active");
            mobileNav.classList.remove("is-active");
            hamburger.setAttribute("aria-expanded", "false");
            document.body.classList.remove("no-scroll");
          });
        });
      }

      // --- 5. スクロール連動処理 (ヘッダー) ---
      const stickyHeader = document.querySelector(".sticky-header");
      const heroSection = document.querySelector(".hero");

      const handleScroll = () => {
        if (!heroSection) return;
        const heroBottom = heroSection.getBoundingClientRect().bottom;

        if (heroBottom <= 80) {
          if (stickyHeader) stickyHeader.classList.add("is-show");
          if (hamburger) hamburger.classList.add("is-black");
        } else {
          if (stickyHeader) stickyHeader.classList.remove("is-show");
          if (hamburger) hamburger.classList.remove("is-black");
        }
      };

      window.addEventListener("scroll", handleScroll);
      handleScroll();
    };
    import rawExhibitions from "../pages/data/exhibitions.json";
    // --- 6. EXHIBITION セクションのデータ取得と無限スクロール・出現アニメーション ---
    const initExhibition = async () => {
      const track = document.getElementById("exhibitionTrack");
      if (!track) return;

      try {
        const exhibitions = rawExhibitions;
        if (!exhibitions || exhibitions.length === 0) return;

        const shuffled = [...exhibitions]
          .sort(() => 0.5 - Math.random())
          .slice(0, 8);

        const cardHtml = shuffled
          .map(
            (item) => `
    <div class="exhibition-card-wrapper">
      <a href="/exhibition" class="exhibition-card">
        <img src="${item.image}" alt="展示画像" class="exhibition-card-img" loading="lazy" onerror="this.src='https://via.placeholder.com/400x300?text=No+Image'" />
      </a>
    </div>
  `,
          )
          .join("");

        track.innerHTML = cardHtml + cardHtml + cardHtml;

        requestAnimationFrame(() => {
          gsap.to(track, {
            xPercent: -33.3333,
            ease: "none",
            duration: 25,
            repeat: -1,
          });
        });
      } catch (error) {
        console.error("EXHIBITIONデータの読み込みに失敗しました:", error);
      }

      const exhibitionSection = document.querySelector(".exhibition-section");
      if (exhibitionSection) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                gsap.fromTo(
                  ".exhibition-title",
                  { clipPath: "inset(0 100% 0 0)" },
                  {
                    clipPath: "inset(0 0% 0 0)",
                    duration: 0.9,
                    ease: "power3.inOut",
                  },
                );
                gsap.fromTo(
                  ".exhibition-subtitle",
                  { y: 20, opacity: 0 },
                  {
                    y: 0,
                    opacity: 1,
                    duration: 0.7,
                    ease: "power2.out",
                    delay: 0.4,
                  },
                );
                gsap.fromTo(
                  ".exhibition-carousel-wrapper",
                  { clipPath: "inset(0 100% 0 0)", opacity: 0 },
                  {
                    clipPath: "inset(0 0% 0 0)",
                    opacity: 1,
                    duration: 1.2,
                    ease: "power3.inOut",
                    delay: 0.6,
                  },
                );
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2 },
        );

        observer.observe(exhibitionSection);
      }
    };

    // --- 7. Captain's Log セクションの出現アニメーション ---
    const initCaptainsLogAnimation = () => {
      const logSection = document.querySelector(".captains-log-section");
      if (!logSection) return;

      // 他セクションのタイトルと動きを揃える（clipPathで隠しておく）
      gsap.set(".section-label", { clipPath: "inset(0 100% 0 0)" });

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // タイトルの出現（左から右へ）
              gsap.to(".section-label", {
                clipPath: "inset(0 0% 0 0)",
                duration: 0.9,
                ease: "power3.inOut",
              });

              // 本（.log-paper）全体のフェードアップ
              gsap.fromTo(
                ".log-paper",
                { opacity: 0, y: 40 },
                {
                  opacity: 1,
                  y: 0,
                  duration: 1.0,
                  ease: "power2.out",
                  delay: 0.3, // タイトルの少し後に出現させる
                },
              );

              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 },
      );

      observer.observe(logSection);
    };

    // --- 8. セクション全体の出現アニメーション (ふわっと表示) ---
    const initSectionFadeIn = () => {
      const fadeObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 },
      );

      const sections = document.querySelectorAll(
        ".exhibition-section, .captains-log-section, .access-section",
      );
      sections.forEach((section) => {
        fadeObserver.observe(section);
      });
    };

    // --- 9. ACCESS セクションの出現アニメーション ---
    const initAccessAnimation = () => {
      const accessSection = document.querySelector(".access-section");
      if (!accessSection) return;

      gsap.set(".access-title", { clipPath: "inset(0 100% 0 0)" });
      gsap.set(".access-subtitle", { y: 20, opacity: 0 });

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              gsap.to(".access-title", {
                clipPath: "inset(0 0% 0 0)",
                duration: 0.9,
                ease: "power3.inOut",
              });
              gsap.to(".access-subtitle", {
                y: 0,
                opacity: 1,
                duration: 0.7,
                ease: "power2.out",
                delay: 0.4,
              });
              gsap.fromTo(
                ".access-content",
                { opacity: 0, y: 20 },
                {
                  opacity: 1,
                  y: 0,
                  duration: 1.0,
                  ease: "power2.out",
                  delay: 0.6,
                },
              );

              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 },
      );

      observer.observe(accessSection);
    };

    // --- 10. 万国旗（Flag & Rope）のアニメーション ---
    const initFlagsAnimation = () => {
      const flags = gsap.utils.toArray<HTMLDivElement>(".flag");
      const ropePaths =
        document.querySelectorAll<SVGPathElement>(".rope-svg path");

      if (flags.length === 0 && ropePaths.length === 0) return;

      ropePaths.forEach((path) => {
        const pathLength = path.getTotalLength();
        gsap.set(path, {
          strokeDasharray: pathLength,
          strokeDashoffset: pathLength,
        });
      });

      gsap.set(flags, {
        opacity: 0,
        scale: 0,
        rotation: 0,
      });

      const tl = gsap.timeline();

      tl.to(ropePaths, {
        strokeDashoffset: 0,
        duration: 1.2,
        ease: "power2.inOut",
      }).to(
        flags,
        {
          opacity: 1,
          scale: 1,
          duration: 0.6,
          ease: "back.out(1.5)",
          stagger: 0.08,
          onComplete: () => {
            flags.forEach((flag, index) => {
              const baseAngle = gsap.utils.random(4, 8);
              const duration = gsap.utils.random(2.8, 4.5);
              const delay = index * 0.12 + Math.random() * 0.2;
              let isAction = false;

              const startGentleSwing = () => {
                gsap.fromTo(
                  flag,
                  { rotation: -baseAngle },
                  {
                    rotation: baseAngle,
                    duration: duration,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                  },
                );
              };

              gsap.to(flag, {
                rotation: -baseAngle,
                duration: duration * 0.5,
                ease: "sine.inOut",
                delay: delay,
                onComplete: startGentleSwing,
              });

              flag.addEventListener("mouseenter", () => {
                if (isAction) return;
                isAction = true;

                gsap.killTweensOf(flag);

                const currentRot = gsap.getProperty(flag, "rotation") as number;
                const hoverAngle =
                  gsap.utils.random(40, 60) * (currentRot >= 0 ? 1 : -1);
                const hoverDuration = duration * 0.25;

                gsap.to(flag, {
                  rotation: hoverAngle,
                  duration: hoverDuration,
                  ease: "sine.inOut",
                  yoyo: true,
                  repeat: 1,
                  onComplete: () => {
                    gsap.to(flag, {
                      rotation: -baseAngle,
                      duration: duration * 0.5,
                      ease: "sine.inOut",
                      onComplete: () => {
                        isAction = false;
                        startGentleSwing();
                      },
                    });
                  },
                });
              });
            });
          },
        },
        "-=0.8",
      );
    };

    // --- 初期化実行管理 ---
    const initAll = () => {
      initApp();
      initExhibition();
      initCaptainsLogAnimation();
      initSectionFadeIn();
      initAccessAnimation();
      initFlagsAnimation();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAll);
    } else {
      initAll();
    }
  </script>

  <style>
    body {
      font-family:
        "Noto Sans JP",
        system-ui,
        -apple-system,
        sans-serif;
      margin: 0;
      padding: 0;
      background-color: #000;
    }

    body.no-scroll {
      overflow: hidden;
    }

    /* (ヘッダーやHero等の既存スタイル) */
    .sticky-header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000; /* メニューより手前に表示するため 900 -> 1000 に変更 */
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
      padding: 0.8rem 0;
      opacity: 0;
      pointer-events: none;
